{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "windows": {
    "options": {
      "shell": {
        "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
        "args": ["-c"]
      }
    }
  },
  "tasks": [
    {
      "label": "PXL-CLOCK :: Start",
      "type": "shell",
      "command": "./start.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "focus": true
      },
      "options": {
        "env": {
          "PXL_USE_IDE_BROWSER": "1"
        }
      },
      "problemMatcher": {
        "owner": "pxl-constraints",
        "fileLocation": ["relative", "${workspaceFolder}/apps"],
        "source": "pxl",
        "severity": "error",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watcher\\] Compiling",
          "endsPattern": "^\\[watcher\\] (Compiled|ERROR|Watching)"
        },
        "pattern": {
          "regexp": "^\\s+\\[(\\w+)\\]\\s+(.+)\\s+\\(([^)]+\\.cs):(\\d+)\\)",
          "code": 1,
          "message": 2,
          "file": 3,
          "line": 4
        }
      }
    },
    {
      "label": "PXL-CLOCK :: Check Setup",
      "type": "shell",
      "command": "./build/setup-check.sh",
      "problemMatcher": [],
      "presentation": {
        "focus": true
      }
    }
  ]
}
