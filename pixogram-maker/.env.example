CLAUDE_API_KEY=sk-ant-api03-...
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter (https://openrouter.ai). Either variable works — the pipeline
# reads OPENROUTER_API_KEY first and falls back to OPENROUTER_PXL_APIKEY,
# so the same name can be shared between shell profile and GitHub Actions.
OPENROUTER_API_KEY=sk-or-v1-...

# Pixogram workflow settings
MAINTAINERS=SchlenkR,nojaf,ursenzler
TRUSTED_AUTHORS=SchlenkR,nojaf,ursenzler,github-actions[bot]
DEFAULT_ITERATIONS=1
MAX_ITERATIONS_CAP=4
MAX_IMPLEMENTOR_RETRIES=5
AI_TIMEOUT_MS=600000
GIF_DURATION_SECONDS=30
GIF_SCALE=6
# claude-sonnet-4.6/haiku-4.5 | copilot-sonnet-4.6/haiku-4.5 | copilot-gpt-5.4/gpt-5.4-mini | openrouter-minimax-m2.5
CONFIG_SET=claude-sonnet-4.6/haiku-4.5
