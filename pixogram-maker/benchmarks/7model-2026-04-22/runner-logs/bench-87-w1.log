// ---
// app: KerzenlichtImWind
// displayName: Kerzenlicht im Wind
// appType: Scene
// author: claude-sonnet-4.6-high
// description: Eine flackernde Kerze mit organischer Flamme, die sanft im Wind schwankt
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;

    // Dark warm background
    ctx.DrawBackground(new Color(0.03, 0.02, 0.04));

    // Candle geometry
    var cx = 12.0;
    var candleTopY = 16.0;
    var candleH = 7.0;
    var candleW = 4.0;

    // Organic wind tilt — two slow sine waves out of phase
    var windTilt = Math.Sin(t * 0.71) * 0.75 + Math.Sin(t * 1.87) * 0.35 + Math.Sin(t * 3.3) * 0.12;

    // Flame height flicker — multi-frequency for organic feel
    var flicker = 0.88 + Math.Sin(t * 8.3) * 0.07 + Math.Sin(t * 13.7) * 0.04 + Math.Sin(t * 5.1) * 0.05;

    var wickTopY = candleTopY - 1.5;
    var flameH = 8.0 * flicker;
    var flameTipY = wickTopY - flameH;

    // --- GLOW (drawn before candle body so candle masks it) ---
    var glowCx = cx + wind    [anthropic] Unknown event: ping
Tilt * flameH * 0.14;
    var glowCy = wickTopY - flameH * 0.38;
    var glowLayer = ctx.NewLayer(clearColor: Colors.TransparentBlack);
    glowLayer.DrawCircle(glowCx, glowCy, 7.5, colorFill: new Color(1.0, 0.28, 0.0, 0.09));
    glowLayer.DrawCircle(glowCx, glowCy, 5.0, colorFill: new Color(1.0, 0.48, 0.0, 0.12));
    glowLayer.DrawCircle(glowCx, glowCy, 3.0, colorFill: new Color(1.0, 0.65, 0.05, 0.11));
    glowLayer.Apply(BlendMode.Plus);

    // --- CANDLE BODY ---
    ctx.DrawRectXyWh(cx - candleW / 2.0, candleTopY, candleW, candleH,
        colorFill: new Color(0.90, 0.86, 0.75));
    // Shadow stripe on right side
    ctx.DrawRectXyWh(cx + candleW / 2.0 - 1.0, candleTopY, 1.0, candleH,
        colorFill: new Color(0.58, 0.52, 0.42));
    // Highlight stripe on left side
    ctx.DrawRectXyWh(cx - candleW / 2.0, candleTopY, 1.0, candleH,
        colorFill: new Color(0.96, 0.93, 0.85));

    // --- WICK ---
    ctx.DrawLine(cx, candleTopY, cx, wickTopY + 0.5, new Color(0.18, 0.12, 0.08));

    // --- FLAME (per-pixel) ---
    for (var py = (int)(flameTipY - 1); py <= (int)(wickTopY + 1); py++)
    {
        var dy = wickTopY - py;           // height above base
        var progress = dy / flameH;       // 0=base, 1=tip
        if (progress < 0.0 || progress > 1.05) continue;

        // Flame profile: peaks ~25% from base, narrows to point at tip
        var profile = Math.Sin(Math.Min(progress, 1.0) * Math.PI) * (0.45 + (1.0 - progress) * 0.55);
        var halfW = 2.4 * profile;

        // Tilted center at this height
        var tiltCx = cx + windTilt * dy * 0.16;

        var startPx = (int)(tiltCx - halfW - 1);
        var endPx   = (int)(tiltCx + halfW + 1);

        for (var px = startPx; px <= endPx; px++)
        {
            var normDx = halfW > 0.01 ? Math.Abs(px - tiltCx) / halfW : 99.0;
            if (normDx > 1.0) continue;

            double r, g, b;

            if (normDx < 0.28)
            {
                // Core: white-yellow fading to yellow at tip
                r = 1.0;
                g = Math.Max(0.0, 0.97 - progress * 0.42);
                b = Math.Max(0.0, 0.62 - progress * 0.70 - normDx * 0.8);
            }
            else if (normDx < 0.65)
            {
                // Mid zone: yellow-orange
                var zone = (normDx - 0.28) / 0.37;
                r = 1.0;
                g = Math.Max(0.0, 0.72 - progress * 0.30 - zone * 0.38);
                b = Math.Max(0.0, 0.08 - progress * 0.08) * (1.0 - zone);
            }
            else
            {
                // Outer: orange fading to dark red at edges
                var zone = (normDx - 0.65) / 0.35;
                r = 1.0 - zone * 0.30;
                g = Math.Max(0.0, 0.28 - progress * 0.18 - zone * 0.22);
                b = 0.0;
            }

            // Dim near base (embers effect)
            var baseDim = progress < 0.08 ? progress / 0.08 : 1.0;
            // Fade near tip
            var tipFade = progress > 0.82 ? 1.0 - (progress - 0.82) / 0.23 : 1.0;

            var dim = baseDim * tipFade;
            r = Math.Clamp(r * dim, 0.0, 1.0);
            g = Math.Clamp(g * dim, 0.0, 1.0);
            b = Math.Clamp(b * dim, 0.0, 1.0);

            if (px >= 0 && px < 24 && py >= 0 && py < 24)
                ctx.SetPixel(px, py, new Color(r, g, b));
        }
    }

    // --- SMOKE ---
    var smokeX0 = cx + windTilt * flameH * 0.16;
    var smokeY0 = flameTipY - 0.5;

