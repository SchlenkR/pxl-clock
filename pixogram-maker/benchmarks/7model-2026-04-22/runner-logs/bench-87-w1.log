#:package Pxl@*

using Pxl.Ui.CSharp;

var flicker1 = Animate.EaseInOut(0.11, 0.0, 1.0, repeat: Repeat.PingPong);
var flicker2 = Animate.EaseInOut(0.17, 0.0, 1.0, repeat: Repeat.PingPong);

var scene = (DrawingContext ctx) =>
{
    ctx.DrawBackground(Colors.Black);

    var t = ctx.Elapsed.TotalSeconds % 6.0 / 6.0; // 0..1 cycle position
    var f1 = flicker1.Eval(ctx);
    var f2 = flicker2.Eval(ctx);

    var cx = 12.0;
    var wickY = 9.0;

    var bendAmount = 0.0;
    var flameHeight = 3.5;
    var flameIntensity = 1.0;
    var isFlare = false;
    var isUpright = true;
    var flameR = 1.0;
    var flameG = 0.55;
    var flameB = 0.05;

    if (t < 0.5)
    {
        // Gentle sway phase
        var st = t / 0.5;
        bendAmount = Math.Sin(st * Math.PI * 2.5) * 1.2 + f1 * 0.4 - 0.2;
        flameHeight = 3.5 + f2 * 0.8;
        flameR = 1.0; flameG = 0.55 + f1 * 0.15; flameB = 0.05;
    }
    else if (t < 0.8)
    {
        // Progressive bend rightward — flame cools toward blue-white
        isUpright = false;
        var bt = (t - 0.5) / 0.3;
        bendAmount = bt * bt * 9.0 + f1 * 0.3;
        flameHeight = 3.5 * (1.0 - bt * 0.6);
        flameIntensity = 1.0 - bt * 0.65;
        flameR = 1.0 - bt * 0.3;
        flameG = 0.55 + bt * 0.3;
        flameB = bt * 0.9;
    }
    else if (t < 0.88)
    {
        // Near extinction — tiny blue-white core ember
        isUpright = false;
        var et = (    [anthropic] Unknown event: ping
t - 0.8) / 0.08;
        bendAmount = 9.0 + et * 0.5;
        flameHeight = 1.5 - et * 0.9;
        flameIntensity = 0.35 - et * 0.25;
        flameR = 0.6; flameG = 0.75; flameB = 1.0;
    }
    else if (t < 0.94)
    {
        // Violent snap-back flare
        isFlare = true;
        var ft = (t - 0.88) / 0.06;
        bendAmount = 9.5 * (1.0 - ft) - 1.5 * ft;
        flameHeight = 3.5 + (1.0 - ft) * 2.5;
        flameIntensity = 1.0 + (1.0 - ft) * 0.6;
        flameR = 1.0; flameG = 0.35 + ft * 0.2; flameB = 0.02;
    }
    else
    {
        // Settle back to gentle sway
        var st = (t - 0.94) / 0.06;
        bendAmount = -1.5 * (1.0 - st) + f1 * 0.4;
        flameHeight = 3.5 + f2 * 0.6;
        flameR = 1.0; flameG = 0.55 + f1 * 0.1; flameB = 0.05;
    }

    var clampedIntensity = Math.Min(flameIntensity, 1.0);

    // Glow around flame base — shrinks with intensity, blooms during flare
    var glowRadius = clampedIntensity * 5.0 * (isFlare ? 1.7 : 1.0);
    if (glowRadius > 0.5)
    {
        var gi = clampedIntensity * 0.45;
        ctx.DrawCircle(
            cx + bendAmount * 0.3, wickY,
            glowRadius,
            colorFill: new Color(gi, gi * 0.35, gi * 0.05, 0.6),
            isAntialias: true);
    }

    // Time digits — faintly amber, pulsing with flame life
    var now = ctx.Now;
    var timeStr = now.ToString("HH:mm");
    var ambient = clampedIntensity * 0.45 + 0.07;
    var timeColor = new Color(ambient * 0.92, ambient * 0.38, 0.03);
    var timeX = (ctx.Width - ctx.MeasureTextMono4x5(timeStr)) / 2.0;
    ctx.DrawTextMono4x5(timeStr, timeX, 19, color: timeColor);

    // Candle body
    ctx.DrawRectXyWh(cx - 1.5, 10.0, 4.0, 8.0, colorFill: new Color(0.85, 0.82, 0.65));

    // Wick
    ctx.DrawLine(cx, 10.0, cx, wickY + 0.5, color: new Color(0.15, 0.1, 0.05));

    // Flame — chain of circles from wick to tip
    var flameTipX = cx + bendAmount;
    var flameTipY = wickY - flameHeight;

    if (flameIntensity > 0.02)
    {
        for (var i = 0; i <= 7; i++)
        {
            var frac = i / 7.0;
            var fx = cx + (flameTipX - cx) * frac;
            var fy = wickY + (flameTipY - wickY) * frac;
            var sz = (1.0 - frac * 0.85) * 1.3 * clampedIntensity;
            var alpha = clampedIntensity * (1.0 - frac * 0.4);
            var df = frac * 0.4;
            ctx.DrawCircle(
                fx, fy,
                Math.Max(sz, 0.25),
                colorFill: new Color(
                    Math.Min(flameR * (1.0 - df * 0.1), 1.0),
                    Math.Max(flameG * (1.0 - df * 0.5), 0.0),
                    Math.Max(flameB * (1.0 - df * 0.7), 0.0),
                    Math.Min(alpha, 1.0)),
