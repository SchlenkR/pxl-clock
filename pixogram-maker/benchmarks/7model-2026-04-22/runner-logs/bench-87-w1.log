```csharp
// ---
// app: KerzenlichtImWind
// displayName: Kerzenlicht im Wind
// appType: ClockFace
// author: SchlenkR
// description: Eine einzelne Kerze flackert sanft im Wind mit warmem Glühen
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;
    ctx.DrawBackground(Colors.Black);

    var cx = 12.0;

    // Slow organic sway — two sine waves, gentle, never threatening
    var lean = Math.Sin(t * 0.55) * 1.9 + Math.Sin(t * 1.15) * 0.65;
    var straightness = 1.0 - Math.Abs(lean) / 2.8; // 1 = upright, ~0.3 = full lean
    var glowStr = 0.6 + straightness * 0.4;         // pulse with posture

    // Candle geometry
    var wickTopY  = 15.0;
    var candleTopY = 17.0;
    var candleBotY = 23.0;
    var flameBaseX = cx;
    var flameBaseY = wickTopY;
    var flameTipX  = cx + lean;
    var flameTipY  = 9.0;
    var flameMidX  = cx + lean * 0.45;
    var flameMidY  = 12.0;

    // ── Glow pass ──────────────────────────────────────────────────────────
    for (var py = 0; py < 24; py++)
    {
        for (var px = 0; px < 24; px++)
        {
            // Halo around flame body
            var dx = px - flameMidX;
            var dy = py - flameMidY;
            var dist = Math.Sqrt(dx * dx + dy * dy);
            var halo = Math.Max(0.0, 1.0 - dist / 8.5) * glowStr;

            // Soft pool at candle top
            var pdx = px - cx;
            var pdy = py - candleTopY;
            var poolDist = Math.Sqrt(pdx * pdx + pdy * pdy);
            var pool = Math.Max(0.0, 1.0 - poolDist / 5.0) * glowStr * 0.55;

            var total = Math.Min(1.0, halo + pool);
            if (total > 0.008)
                ctx.SetPixel(px, py, new Color(total * 0.88, total * 0.33, total * 0.04));
        }
    }

    // ── Candle body ────────────────────────────────────────────────────────
    ctx.DrawRectXyXy(cx - 2, candleTopY, cx + 2, candleBotY,
        colorFill: Color.FromRgb(0.94, 0.90, 0.80));
    // Right-edge depth shadow
    ctx.DrawLine(cx + 2, candleTopY, cx + 2, candleBotY,
        color: Color.FromRgb(0.58, 0.52, 0.42));

    // Wick
    ctx.DrawLine(cx, wickTopY, cx, candleTopY - 0.5,
        color: Color.FromRgb(0.18, 0.12, 0.06));

    // ── Flame ──────────────────────────────────────────────────────────────
    for (var fy = (int)flameTipY; fy <= (int)flameBaseY; fy++)
    {
        var prog = (fy - flameTipY) / (flameBaseY - flameTipY + 0.001); // 0=tip 1=base
        var fxCenter = flameTipX + (flameBaseX - flameTipX) * prog;
        var halfW    = prog * 1.7;

        for (var fx = (int)(fxCenter - halfW - 1); fx <= (int)(fxCenter + halfW + 1); fx++)
        {
            if (fx < 0 || fx >= 24) continue;
            var d  = Math.Abs(fx - fxCenter);
            if (d > halfW + 0.5) continue;
            var cf = 1.0 - d / (halfW + 0.5);

            Color fc;
            if (cf > 0.72 && prog > 0.25)
                fc = Color.FromRgb(1.0, 0.97, 0.82);   // white-yellow core
            else if (cf > 0.38)
                fc = Color.FromRgb(1.0, 0.68, 0.10);   // warm orange-yellow
            else
                fc = Color.FromRgb(0.93, 0.32, 0.04);  // deep orange fringe

            ctx.SetPixel(fx, fy, fc);
        }
    }

    // ── Smoke ──────────────────────────────────────────────────────────────
    for (var si = 1; si <= 5; si++)
    {
        var sy = flameTipY - si * 1.6;
        var sx = flameTipX + lean * si * 0.22;
        if (sy >= 0 && sy < 24 && sx >= 0 && sx < 24)
        {
            var a = 0.13 - si * 0.022;
            if (a > 0)
                ctx.SetPixel((int)sx, (int)sy, new Color(0.65, 0.65, 0.65, a));
        }
    }

    // ── Time display — held in the candle's amber light ────────────────────
    var now     = ctx.Now;
    var timeStr = now.ToString("HH:mm");
    var tw      = ctx.MeasureTextMono4x5(timeStr);
    var tx      = (24.0 - tw) / 2.0;
    ctx.DrawTextMono4x5(timeStr, tx, 18, color: Color.FromRgb(1.0, 0.60, 0.16));
};
