```csharp
// ---
// app: CandleInWind
// displayName: Kerzenlicht im Wind
// author: Ollama nemotron-3-super
// appType: Scene
// description: A candle with flickering flame, smoke, and time display.
// ---
#:package Pxl@*

using Pxl.Ui.CSharp;

var scene = (DrawingContext ctx) =>
{
    ctx.DrawBackground(Colors.Black);

    double t = ctx.Elapsed.TotalSeconds;
    double cx = 12.0; // horizontal centre
    double baseY = 18.0; // top of candle base (y increases downwards)

    // Candle base (small dark rectangle)
    ctx.DrawRectXyWh(cx - 1.0, baseY, 2.0, 2.0, Colors.DarkGray);

    // Flame parameters
    double flameHeight = 4.0 + Math.Sin(t * 2.0) * 0.6; // 3.4 … 4.6 px
    double flameWidth  = 2.0 + Math.Sin(t * 0.9) * 0.4; // 1.6 … 2.4 px
    double offsetX     = Math.Sin(t * 1.3) * 0.5; // tilt left/right

    // Draw flame as tapered horizontal lines (bottom → tip)
    for (double y = baseY; y >= baseY - flameHeight; y -= 1.0)
    {
        double progress = (baseY - y) / flameHeight; // 0 at base, 1 at tip
        double widthAtY = flameWidth * (1.0 - progress); // taper
        double offsetAtY = offsetX * progress; // more tilt towards tip
        double left  = cx - widthAtY/2.0 + offsetAtY;
        double right = cx + widthAtY/2.0 + offsetAtY;
        ctx.DrawLine(left, y, right, y, Colors.OrangeRed);
    }

    // Soft glow around the flame
    double glowRadius = flameWidth * 1.5 + Math.Sin(t * 0.5) * 0.3;
    ctx.DrawCircle(cx + offsetX, baseY - flameHeight/2.0, glowRadius, Colors.Orange.WithAlpha(0.2));

    // Smoke plume (thin fading line)
    double smokeStartY = baseY - flameHeight; // tip of flame
    for (int i = 0; i < 4; i++)
    {
        double y = smokeStartY - i * 1.2;
        if (y < 0) continue; // stay inside canvas
        double alpha = 1.0 - (i / 3.0);
        ctx.DrawPoint(cx + offsetX * (1.0 + i*0.2), y, Colors.Gray.WithAlpha(alpha));
    }

    // Time display: seconds modulo 10 as a single digit inside the flame core
    int seconds = ctx.Now.Second % 10;
    string secText = seconds.ToString();
    // Approximate centre of flame core
    double textX = cx - 2.0; // mono3x5 char width ≈2px (including spacing)
    double textY = baseY - flameHeight/2.0 - 2.0; // vertical centre, adjusted for font height
    ctx.DrawTextMono3x5(secText, textX, textY, Colors.White.WithAlpha(0.8));
};
```
