// ---
// app: CandleFlagClock
// displayName: Candle Flag Clock
// appType: Scene
// author: Ollama nemotron-3-super
// description: A candle with a flickering flame, a waving flag showing scrolling seconds.
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

// State variables (persist between frames)
var flagHeight = 6;
var flagPixels = new bool[flagHeight];
var lastSecond = -1;
var flagBaseX = 14;   // right of candle center
var flagBaseY = 10;   // above flame
var flameHeight = 5;
var cx = 12.0;
var cy = 20.0;

var scene = (DrawingContext ctx) =>
{
    ctx.DrawBackground(Colors.Black);

    // Time-based wave for flame tilt and flag flutter
    var t = ctx.Elapsed.TotalSeconds;
    var wave = Math.Sin(t * 1.5) * 2.0; // amplitude ~2 pixels
    var flicker = Math.Sin(t * 3.0) * 0.5; // small vertical flicker

    // ----- Candle flame -----
    // Soft glow
    var glowRadius = 3.0 + Math.Abs(flicker) * 0.5;
    var glowColor = Color.FromRgbaByte(255, 165, 0, 60); // orange, low alpha
    ctx.DrawCircle(cx + wave, cy - flameHeight / 2.0 + flicker, glowRadius, colorFill: glowColor);

    // Flame core
    var coreRadius = 2.0;
    var coreColor = Color.FromRgbByte(255, 200, 0); // bright yellow-orange
    ctx.DrawCircle(cx + wave * 0.5, cy - flameHeight / 2.0 + flicker * 0.5, coreRadius, colorFill: coreColor);

    // ----- Flag -----
    // Update ticker tape on second change
    var sec = ctx.Now.Second;
    if (sec != lastSecond)
    {
        // Shift pixels up: each second a new lit pixel appears at bottom
        for (var i = flagHeight - 1; i > 0; i--)
        {
            flagPixels[i] = flagPixels[i - 1];
        }
        flagPixels[0] = true; // new second lit at bottom
        lastSecond = sec;
    }

    // Flag position (flutters with same wave as flame)
    var flagX = flagBaseX + wave;
    var flagYBase = flagBaseY;

    // Draw two-pixel-wide vertical strips where flagPixels is true
    for (var i = 0; i < flagHeight; i++)
    {
        if (flagPixels[i])
        {
            var y = flagYBase + i;
            ctx.DrawPoint(flagX, y, Colors.White);
            ctx.DrawPoint(flagX + 1, y, Colors.White);
        }
    }
};    [ollama] prompt_eval: 11403 tok in 36,04s, gen: 3393 tok @ 29,5 tok/s, total: 151,8s

