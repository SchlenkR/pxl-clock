    ctx.DrawRectXyWh(cx - 1.0, baseY, 2.0, 2.0, Colors.DarkGray);

    // Flame body - draw as a triangle approximated by lines
    // We'll draw multiple horizontal lines to fill
    for (double y = baseY; y <= baseY + flameHeight; y += 1.0)
    {
        double progress = (y - baseY) / flameHeight; // 0 at base, 1 at tip
        double widthAtY = flameWidth * (1.0 - progress); // taper
        double offsetAtY = offsetX * progress; // more tilt at tip
        double left = cx - widthAtY/2.0 + offsetAtY;
        double right = cx + widthAtY/2.0 + offsetAtY;
        // Draw line segment
        ctx.DrawLine(left, y, right, y, Colors.OrangeRed);
    }

    // Soft glow: larger ellipse with low alpha
    double glowRadius = flameWidth * 1.5 + Math.Sin(t * 0.5) * 0.3;
    ctx.DrawEllipse(cx + offsetX, baseY + flameHeight/2.0, glowRadius, glowRadius/2.0, Colors.Orange.WithAlpha(0.2));

    // Smoke plume
    double smokeStartY = baseY - flameHeight;
    double smokeLen = 4.0;
    for (int i = 0; i< 4; i++)
    {
        double y = smokeStartY - i * 1.2;
        double alpha = 1.0 - (i / 3.0);
        ctx.DrawPoint(cx + offsetX * (1.0 + i*0.2), y, Colors.Gray.WithAlpha(alpha));
    }

    // Time display inside flame core: show seconds modulo 10 as single digit
    int seconds = ctx.Now.Second % 10;
    string secText = seconds.ToString();
    // Draw centered at flame core approx
    double textX = cx - 2.0; // mono3x5 char width 2? Actually each char 3px wide plus 1 spacing? We'll approximate
    double textY = baseY + flameHeight/2.0 - 2.0; // adjust
    ctx.DrawTextMono3x5(secText, textX, textY, Colors.White.WithAlpha(0.8));
};

// Note: DrawEllipse not defined; need to use DrawCircle with different radii? Not available.
