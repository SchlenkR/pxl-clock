**What's asked:** A complete reimagining — a violent storm scene rather than peaceful sailing. Key elements:
1. Massive dark waves (near-black, grey-green) rolling right to left, dominating the whole screen
2. Sailboat reduced to a tiny desperate white triangle — barely visible, swallowed by waves
3. Lightning flash: every few seconds, 1-2 frames of near-white blinding light, then back to darkness
4. Time at the **very top** of screen (not bottom)
5. Dark, threatening atmosphere throughout

**Plan:**
- Draw order: dark sky → tiny sail → waves on top (waves naturally hide/reveal the sail)
- Wave formula: multi-harmonic sine waves, base ~y=15, amplitude ±10px → waves range from y≈4 to below screen = very dominant
- Wave scroll: negative time coefficient = rightward phase travel = leftward visual motion
- Lightning: product of three slow sines at different frequencies — only exceeds threshold 0.88 briefly and irregularly (~every 4-6s, for ~1-2 frames)
- Pixel-by-pixel wave drawing with depth gradient (grey-green surface → near-black deep)
- Time in muted blue-grey at top row

```csharp
// ---
// app: SegelbootSturm
// displayName: Sailboat in Storm
// appType: ClockFace
// author: claude
// description: Storm scene - massive dark waves, tiny desperate sailboat, lightning flashes
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;
    var now = ctx.Now;

    // Lightning: product of three slow sines at different frequencies
    // -> very brief, infrequent flashes (1-2 frames every ~5-7 seconds)
    var lightningVal = Math.Sin(t * 0.73) * Math.Sin(t * 1.31) * Math.Sin(t * 2.97);
    var isLightning = lightningVal > 0.88;

    if (isLightning)
    {
        // Blinding bleach — full near-white frame
        ctx.DrawBackground(Color.FromRgb(0.95, 0.97, 1.0));
        ctx.DrawTextMono3x5(now.ToString("HH:mm"), 2, 1, Color.FromRgb(0.05, 0.05, 0.2));
        return;
    }

    // Stormy near-black sky
    ctx.DrawBackground(Color.FromRgb(0.01, 0.01, 0.06));

    // Boat: tiny sail drawn BEFORE waves so waves paint over it naturally
    // Hull and sail only show above the wave surface
    var bx = 11.0;
    var boatWY = 15.0
        + 5.0 * Math.Sin(bx * 0.48 - t * 1.2)
        + 3.5 * Math.Sin(bx * 0.85 - t * 0.72)
        + 2.0 * Math.Sin(bx * 1.4  + t * 0.38);

    // Tiny mast (4px vertical)
    ctx.DrawLine(bx, boatWY - 1, bx, boatWY - 5, Colors.White, strokeWidth: 1);
    // Sail: line from mast top to lower    [anthropic] Unknown event: ping
-right
    ctx.DrawLine(bx, boatWY - 5, bx + 2, boatWY - 1, Colors.White, strokeWidth: 1);
    // Hull: tiny horizontal line
    ctx.DrawLine(bx - 1, boatWY, bx + 2, boatWY, Colors.White, strokeWidth: 1);

    // Massive rolling waves — drawn on top, covering the boat when high
    for (var xi = 0; xi < 24; xi++)
    {
        var wx = (double)xi;
        // Multi-harmonic wave, scrolling right-to-left (negative t phase)
        var wy = 15.0
            + 5.0 * Math.Sin(wx * 0.48 - t * 1.2)
            + 3.5 * Math.Sin(wx * 0.85 - t * 0.72)
            + 2.0 * Math.Sin(wx * 1.4  + t * 0.38);
        var wyI = (int)Math.Round(wy);
        wyI = Math.Max(1, Math.Min(23, wyI));

        // Depth fill: grey-green surface fading to near-black deep
        for (var yi = wyI; yi < 24; yi++)
        {
            var d = Math.Min(1.0, (yi - wyI) / 9.0);
            var g = 0.18 * (1.0 - d) + 0.02 * d;
            var b = 0.22 * (1.0 - d) + 0.05 * d;
            ctx.SetPixel(xi, yi, new Color(0.0, g, b));
        }

        // Wave crest: lighter grey-green foam line
        ctx.SetPixel(xi, wyI, Color.FromRgb(0.10, 0.30, 0.36));

        // Second crest highlight one pixel above (spray/foam effect)
        if (wyI - 1 >= 0)
            ctx.SetPixel(xi, wyI - 1, Color.FromRgb(0.03, 0.10, 0.13));
    }

    // Time at the very top — watching dry from above the raging sea
    ctx.DrawTextMono3x5(now.ToString("HH:mm"), 2, 1, Color.FromRgb(0.40, 0.52, 0.68));
};
