// ---
// app: KerzenlichtImWind
// displayName: Kerzenlicht im Wind
// author: SchlenkR
// description: Candle in the wind, flickering flame, rising smoke, dark background.
// appType: Scene
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var flameCenterXBase = 12.0;
var flameBaseY = 12.0;
var smokeYStart = 13.0;
var smokeColor = Color.FromRgbByte(150,150,150).WithAlphaByte(180);

var scene = (DrawingContext ctx) =>
{
    ctx.DrawBackground(Colors.Black);

    // Candle body (hardcoded)
    ctx.DrawRectXyWh(
        11.0,
        14.0,
        2.0,
        6.0,
        colorFill: Colors.Gray);

    // Smoke
    var t = ctx.Elapsed.TotalSeconds;
    var smokeX = flameCenterXBase + Math.Sin(t * 3) * 0.3;
    var smokeY = smokeYStart - t * 0.5;
    ctx.SetPixel(smokeX, smokeY, smokeColor);

    // Flame animation
    var flameXOffset = Math.Sin(t * 3) * 0.3;
    var flameYOffset = Math.Sin(t * 4) * 0.2;

    double flameCenterX = flameCenterXBase + flameXOffset;
    double flameCenterY = flameBaseY - flameYOffset;

    for (int i = 0; i< 5; i++)
    {
        int haloWidth = i * 2 + 3;
        double haloX = flameCenterX - haloWidth / 2.0;
        double haloY = flameCenterY - i;
        var haloColor = Color.FromRgbByte(255,200,80).WithAlphaByte(128);
        ctx.DrawRectXyWh(haloX, haloY, (double)haloWidth, 1.0, colorFill: haloColor);

        int flameWidth = i * 2 + 1;
        double flameX = flameCenterX - flameWidth / 2.0;
        double flameY = flameCenterY - i;
        var flameColor = i == 0
            ? Color.FromRgbByte(255,160,30)
            : i == 1
                ? Color.FromRgbByte(255,220,100)
                : Color.FromRgbByte(255,200,80);
        ctx.DrawRectXyWh(flameX, flameY, (double)flameWidth, 1.0, colorFill: flameColor);
    }
};

This should fix the error because we are no longer passing the candle variables (which might have caused the type confusion) and we are using literals for the candle drawing.

