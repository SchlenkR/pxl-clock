// displayName: Lava Field Clock
// appType: ClockFace
// author: pixogram-maker
// description: Cooling lava field from above. Glowing fissures breathe like a heartbeat; time written in fire.
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

// Crack network: hand-crafted irregular polygon web across 24x24
var cracks = new (double, double, double, double)[]
