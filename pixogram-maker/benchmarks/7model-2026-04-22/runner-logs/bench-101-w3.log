    (0, 6, 4, 8),
    (4, 8, 9, 6),
    (9, 6, 15, 8),
    (15, 8, 20, 6),
    (20, 6, 23, 7),
    // Verticals / diagonals top→upper-mid
    (6, 0, 4, 8),
    (12, 2, 9, 6),
    (18, 0, 15, 8),
    (23, 2, 23, 7),
    (0, 1, 0, 6),
    // Middle band
    (0, 13, 5, 11),
    (5, 11, 10, 13),
    (10, 13, 16, 11),
    (16, 11, 21, 13),
    (21, 13, 23, 12),
    // Verticals upper-mid→middle
    (4, 8, 5, 11),
    (9, 6, 10, 13),
    (15, 8, 16, 11),
    (20, 6, 21, 13),
    (0, 6, 0, 13),
    (23, 7, 23, 12),
    // Lower-mid band
    (0, 18, 4, 17),
    (4, 17, 9, 19),
    (9, 19, 14, 17),
    (14, 17, 19, 19),
    (19, 19, 23, 18),
    // Verticals middle→lower-mid
    (5, 11, 4, 17),
    (10, 13, 9, 19),
    (16, 11, 14, 17),
    (21, 13, 19, 19),
    (0, 13, 0, 18),
    (23, 12, 23, 18),
    // Bottom band
    (0, 23, 5, 22),
    (5, 22, 11, 23),
    (11, 23, 17, 21),
    (17, 21, 22, 23),
    (22, 23, 23, 22),
    // Verticals lower-mid→bottom
    (4, 17, 5, 22),
    (9, 19, 11, 23),
    (14, 17, 17, 21),
    (19, 19, 22, 23),
    (0, 18, 0, 23),
    (23, 18, 23, 22),
    // Extra diagonals for texture
    (6, 0, 9, 6),
    (12, 2, 15, 8),
    (4, 8, 10, 13),
    (15, 8, 21, 13),
    (5, 11, 9, 19),
    (10, 13, 14, 17),
    (16, 11, 19, 19),
};

// Per-crack organic pulse parameters
var rng = new Random(7);
var crackPhase = new double[cracks.Length];
var crackFreq1 = new double[cracks.Length];
var crackFreq2 = new double[cracks.Length];
for (var i = 0; i < cracks.Length; i++)
{
    crackPhase[i] = rng.NextDouble() * Math.PI * 2.0;
    crackFreq1[i] = 0.25    [anthropic] Unknown event: ping
 + rng.NextDouble() * 0.45;
    crackFreq2[i] = 0.4 + rng.NextDouble() * 0.6;
}

// Intersection nodes (key junctions — drawn brighter)
var nodes = new (double, double)[]
{
    (6, 0), (12, 2), (18, 0),
    (0, 6), (4, 8), (9, 6), (15, 8), (20, 6), (23, 7),
    (0, 13), (5, 11), (10, 13), (16, 11), (21, 13), (23, 12),
    (0, 18), (4, 17), (9, 19), (14, 17), (19, 19), (23, 18),
    (5, 22), (11, 23), (17, 21), (22, 23),
};

var scene = (DrawingContext ctx) =>
{
    ctx.DrawBackground(Colors.Black);
    var t = ctx.Elapsed.TotalSeconds;

    // Draw cracks with organic pulsing glow
    for (var i = 0; i < cracks.Length; i++)
    {
        var (x1, y1, x2, y2) = cracks[i];
        // Two sine waves combined for irregular organic rhythm
        var s1 = Math.Sin(t * crackFreq1[i] + crackPhase[i]);
        var s2 = Math.Sin(t * crackFreq2[i] + crackPhase[i] * 0.6);
        var pulse = ((s1 + s2) * 0.5 + 1.0) * 0.5; // 0..1

        // Deep ember-red (low) → bright orange-yellow (high)
        var hue = 0.055 - pulse * 0.045;      // 0.055 (orange-red) → 0.01 (red)
        var light = 0.10 + pulse * 0.55;      // 0.10 → 0.65
        var col = Color.FromHsl(hue, 1.0, light);
        ctx.DrawLine(x1, y1, x2, y2, col, strokeWidth: 1.0, isAntialias: true);
    }

    // Draw intersection nodes — always hotter / brighter
    for (var i = 0; i < nodes.Length; i++)
    {
        var (nx, ny) = nodes[i];
        var pulse = (Math.Sin(t * 0.55 + i * 0.63) + Math.Sin(t * 0.91 + i * 0.37)) * 0.5;
        pulse = (pulse + 1.0) * 0.5;
        var light = 0.45 + pulse * 0.5;       // 0.45 → 0.95 (near white-hot)
        var hue = 0.09 + pulse * 0.04;        // orange → yellow
        var nc = Color.FromHsl(hue, 1.0, light);
        ctx.DrawCircle(nx, ny, 0.9, colorFill: nc, isAntialias: true);
    }

    // Global pulse for the time display
    var glow = (Math.Sin(t * 0.7) + Math.Sin(t * 1.13)) * 0.5;
    glow = (glow + 1.0) * 0.5;

    // HH:mm — carved in hottest fissure light
    var now = ctx.Now;
    var hhmm = now.ToString("HH:mm");
    var tw = ctx.MeasureTextMono4x5(hhmm);
    var tx = Math.Round((ctx.Width - tw) * 0.5);
    var timeLight = 0.72 + glow * 0.28;
    var timeHue = 0.10 + glow * 0.05;
    var timeColor = Color.FromHsl(timeHue, 1.0, timeLight);
    ctx.DrawTextMono4x5(hhmm, tx, 9, color: timeColor);

    // ss — cooler, ember-orange
    var ss = now.ToString("ss");
    var sw = ctx.MeasureTextMono3x5(ss);
    var sx = Math.Round((ctx.Width - sw) * 0.5);
    var secLight = 0.42 + glow * 0.18;
    var secColor = Color.FromHsl(0.05, 1.0, secLight);
    ctx.DrawTextMono3x5(ss, sx, 17, color: secColor);
};
