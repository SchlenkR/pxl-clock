            col = new Color(1.0 - f * 0.35, 0.45 - f * 0.45, 0.0);
        }
        else
        {
            var f = (lr - 0.72) / 0.28;
            col = new Color((0.65 - f * 0.55) * (1 - f * 0.3), 0.0, 0.0);
        }

        if (p.size >= 0.75)
        {
            ctx.DrawCircle(newX, newY, p.size * 0.6, colorFill: col, isAntialias: false);
        }
        else
        {
            var px = (int)(newX + 0.5);
            var py = (int)(newY + 0.5);
            if (px >= 0 && px < 24 && py >= 0 && py < 24)
                ctx.SetPixel(px, py, col);
        }
    }
};
