#:package Pxl@*

using Pxl.Ui.CSharp;

var rng = new Random(7);
// Each particle: x, y, vx, vy, age, maxAge, size, wobble, gravity
var particles = new List<(double x, double y, double vx, double vy, double age, double maxAge, double size, double wobble, double grav)>();
var nextBurst = 0.0;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;
    var dt = 1.0 / Math.Max(ctx.Fps, 1);

    // Night sky
    ctx.DrawBackground(new Color(0.02, 0.01, 0.05));

    // Stars — each twinkles at its own irrational rate
    var starRng = new Random(31337);
    for (var i = 0; i < 22; i++)
    {
        var sx = starRng.NextDouble() * 24;
        var sy = starRng.NextDouble() * 10;
        var rate = 0.7 + starRng.NextDouble() * 2.3;
        var phase = starRng.NextDouble() * Math.PI * 2;
        var bright = 0.25 + 0.75 * (0.5 + 0.5 * Math.Sin(t * rate + phase));
        ctx.SetPixel((int)sx, (int)sy, new Color(bright, bright, bright * 0.85));
    }

    // Volcano silhouette — triangle from peak at y≈9 to full width at bottom
    var peakX = 12.0;
    var peakY = 9.0;
    for (var row = (int)peakY; row < 24; row++)
    {
        var frac = (row - peakY) / (24.0 - peakY);
        var halfW = frac * 13.0;
        var left = (int)Math.Round(peakX - halfW);
        var right = (int)Math.Round(peakX + halfW);
        for (var col = left; col <= right; col++)
        {
            var edgeDist = Math.Min(col - left, right - col);
            if (edgeDist < 3)
            {
                // Organic lava-crack shimmer along edges
                var shimmer = 0.5 + 0.5 * Math.Sin(t * 3.1 + col * 0.7 + row * 0.4);
                var g = Math.Max(0.0, 0.25 * shimmer * (1 - edgeDist / 3.0));
                ctx.SetPixel(col, row, new Color(0.09 + g * 0.45, 0.04 + g * 0.10, 0.02));
            }
            else
            {
                ctx.SetPixel(col, row, new Color(0.06, 0.03, 0.015));
            }
        }
    }

    // Crater glow — breathes at irrational dual frequency
    var craterPulse = 0.55 + 0.25 * Math.Sin(t * 4.71) + 0.20 * Math.Sin(t * 7.13 + 1.1);
    ctx.DrawCircle(peakX, peakY, 2.8, colorFill: new Color(craterPulse, craterPulse * 0.32, 0.0), isAntialias: false);
    ctx.DrawCircle(peakX, peakY, 1.4, colorFill: new Color(1.0, 0.75 + 0.25 * Math.Sin(t * 9.3), 0.15), isAntialias: false);

    // Emit particles in irregular bursts
    if (t >= nextBurst)
    {
        var burstCount = 2 + (int)(rng.NextDouble() * 5);
        for (var i = 0; i < burstCount; i++)
        {
            // Slightly biased spread — not perfectly symmetric
            var angle = -Math.PI / 2.0 + (rng.NextDouble() - 0.48) * 1.3;
            var isSpark = rng.NextDouble() > 0.35; // sparks vs    [anthropic] Unknown event: ping
 heavy embers
            var speed = isSpark ? (18 + rng.NextDouble() * 16) : (9 + rng.NextDouble() * 9);
            var vx = Math.Cos(angle) * speed;
            var vy = Math.Sin(angle) * speed;
            var maxAge = isSpark ? (0.5 + rng.NextDouble() * 0.8) : (1.0 + rng.NextDouble() * 1.2);
            var size = isSpark ? (0.4 + rng.NextDouble() * 0.5) : (0.7 + rng.NextDouble() * 0.8);
            var wobble = (rng.NextDouble() - 0.5) * 5.0;
            var grav = isSpark ? (22 + rng.NextDouble() * 12) : (14 + rng.NextDouble() * 8);
            var startX = peakX + (rng.NextDouble() - 0.5) * 2.0;
            particles.Add((startX, peakY, vx, vy, 0.0, maxAge, size, wobble, grav));
        }
        // Irregular interval: short bursts close together, occasional pauses
        nextBurst = t + 0.06 + rng.NextDouble() * 0.22;
    }

    // Update and draw particles
    for (var i = particles.Count - 1; i >= 0; i--)
    {
        var p = particles[i];
        var newAge = p.age + dt;

        if (newAge >= p.maxAge || p.y > 23.5 || p.x < -1 || p.x > 25)
        {
            particles.RemoveAt(i);
            continue;
        }

        // Organic turbulence: per-particle wobble offset drives drift
        var drift = Math.Sin(t * 2.7 + p.wobble) * 0.8 + Math.Sin(t * 5.1 + p.wobble * 1.3) * 0.3;
        var newVx = p.vx + drift * dt * 6;
        var newVy = p.vy + p.grav * dt;
        var newX = p.x + p.vx * dt;
        var newY = p.y + p.vy * dt;

        particles[i] = (newX, newY, newVx, newVy, newAge, p.maxAge, p.size, p.wobble, p.grav);

        // Color: white-hot → yellow → orange → red → dark red
        var lr = newAge / p.maxAge;
        Color col;
        if (lr < 0.15)
        {
            var f = lr / 0.15;
            col = new Color(1.0, 1.0, 1.0 - f * 0.9);
        }
        else if (lr < 0.4)
        {
            var f = (lr - 0.15) / 0.25;
            col = new Color(1.0, 1.0 - f * 0.55, 0.1 - f * 0.1);
        }
        else if (lr < 0.72)
        {
            var f = (lr - 0.4) / 0.32;
            col = new Color(1.0 - f * 0.35, 0.45 - f * 0.45, 0.0);
        }
        else
        {
            var f = (lr - 0.72) / 0.28;
            col = new Color((0.65 - f * 0.55) * (1 - f * 0.3), 0.0, 0.0);
        }

        if (p.size >= 0.75)
            ctx.DrawCircle(newX, newY, p.size * 0.6, colorFill: col, isAntialias: false);
        else
            ctx.SetPixel((int)(newX + 0.5), (int)(newY + 0.5), col);
    }
};
