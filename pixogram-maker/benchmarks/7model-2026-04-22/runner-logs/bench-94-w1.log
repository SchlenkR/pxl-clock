// ---
// app: SegelbootAufWellen
// displayName: Segelboot auf Wellen
// appType: ClockFace
// author: SchlenkR
// description: Kleines Segelboot auf goldenen Abendsee-Wellen
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;
    var waveOff = t * 2.2;

    // Sky: warm amber/golden gradient (rows 0–8)
    for (var y = 0; y < 9; y++)
    {
        var f = y / 8.0;
        var r = 1.0 - f * 0.15;
        var g = 0.55 - f * 0.25;
        var b = 0.05 + f * 0.02;
        for (var x = 0; x < 24; x++)
            ctx.SetPixel(x, y, Color.FromRgb(r, g, b));
    }

    // Water: teal near surface, deep indigo at bottom
    for (var y = 9; y < 24; y++)
    {
        var wf = (y - 9.0) / 14.0;
        for (var x = 0; x < 24; x++)
        {
            var wr = 0.04 + 0.12 * (1 - wf);
            var wg = 0.18 + 0.16 * (1 - wf);
            var wb = 0.38 + 0.18 * (1 - wf);
            ctx.SetPixel(x, y, Color.FromRgb(wr, wg, wb));
        }
    }

    // Sun outer glow (behind disc)
    ctx.DrawCircle(20, 3, 3.8, colorFill: Color.FromRgba(1.0, 0.55, 0.05, 0.22));
    ctx.DrawCircle(20, 3, 3.0, colorFill: Color.FromRgba(1.0, 0.58, 0.08, 0.35));
    // Sun disc
    ctx.DrawCircle(20, 3, 2.2, colorFill: Color.FromRgb(1.0, 0.62, 0.08));

    // Golden shimmer: sun reflection down the right side
    for (var y = 9; y < 22; y++)
    {
        var shimAlpha = 0.72 * (1.0 - (y - 9.0) / 13.0);
        var wobble = Math.Sin(y * 0.9 + waveOff * 0.5) * 0.9;
        var shimW = (int)(2.2 + wobble + 0.5);
        var shimStart = 24 - shimW - 1;
        for (var x = shimStart; x < 24; x++)
        {
            if (x >= 0)
                ctx.SetPixel(x, y, Color.FromRgba(1.0, 0.80, 0.25, shimAlpha));
        }
    }

    // Wave crests: staggered rows scrolling left
    var rows = new (int wy, double spd, double ph, double freq)[]
    {
        (10, 1.00, 0.0,  0.52),
        (12, 0.85, 2.1,  0.48),
        (14, 0.95, 4.3,  0.55),
        (16, 0.75, 1.05, 0.50),
        (18, 0.90, 3.4,  0.53),
    };

    foreach (var (wy, spd, ph, freq) in rows)
    {
        for (var x = 0; x < 24; x++)
        {
            var cv = Math.Sin(x * freq - waveOff * spd + ph);
            if (cv > 0.42)
            {
                var intensity = (cv - 0.42) / 0.58;
                var cr = 0.20 + 0.45 * intensity;
                var cg = 0.52 + 0.35 * intensity;
                var cb = 0.60 + 0.28 * intensity;
                ctx.SetPixel(x, wy, Color.FromRgb(cr, cg, cb));
            }
        }
