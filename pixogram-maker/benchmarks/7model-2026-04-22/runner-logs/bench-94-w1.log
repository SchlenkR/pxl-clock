```csharp
// ---
// app: SegelbootMondnacht
// displayName: Segelboot Mondnacht
// appType: ClockFace
// author: PXL
// description: Sailboat sailing through moonlit night waters, flaring in the silver corridor
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var boatX    = Animate.EaseInOut(9.0,  1.0, 21.0, repeat: Repeat.PingPong);
var boatBob  = Animate.EaseInOut(2.3,  0.0,  1.5, repeat: Repeat.PingPong);
var boatTilt = Animate.EaseInOut(2.0, -7.0,  7.0, repeat: Repeat.PingPong);
var waveScroll = Animate.Linear(6.0, 0.0, 24.0, repeat: Repeat.Loop);

var scene = (DrawingContext ctx) =>
{
    // Sky: near-black, slight violet
    ctx.DrawBackground(new Color(0.02, 0.01, 0.05));

    var bx      = boatX.Eval(ctx);
    var bob     = boatBob.Eval(ctx);
    var tilt    = boatTilt.Eval(ctx);
    var wScroll = waveScroll.Eval(ctx);

    var horizon    = 11.0;
    var corridorCx = 17.5;
    var corridorR  = 4.5;

    // Moon — cold, upper right
    ctx.DrawCircle(18.5, 3.5, 2.5,
        colorFill: new Color(0.88, 0.93, 1.0),
        isAntialias: true);

    // Water with moon-reflection corridor
    for (var py = (int)horizon; py < 23; py++)
    {
        for (var px = 0; px < 24; px++)
        {
            var dist = Math.Abs(px - corridorCx);
            var c = Math.Max(0.0, 1.0 - dist / corridorR);
            c = c * c * c;
            var depthFade = 1.0 - (py - horizon) / 13.0 * 0.55;
            var s = c * depthFade * 0.38;
            ctx.SetPixel(px, py, new Color(
                0.02 + s * 0.45,
                0.02 + s * 0.55,
                0.05 + s
            ));
        }
    }

    // Wave crests — faint silver, scrolling left
    for (var wave = 0; wave < 5; wave++)
    {
        var baseY = horizon + 1.5 + wave * 2.3;
        for (var px = 0; px < 24; px++)
        {
            // world coord scrolls left as wScroll increases
            var wx = ((px + wScroll + wave * 5.5) % 24.0 + 24.0) % 24.0;
            var wy = baseY + Math.Sin(wx * 0.45) * 0.5;
            var pyInt = (int)Math.Round(wy);
            if (pyInt >= (int)horizon && pyInt < 23)
            {
                var ex = ctx.GetPixel(px, pyInt);
                ctx.SetPixel(px, pyInt, new Color(
                    Math.Min(1.0, ex.R + 0.07),
                    Math.Min(1.0, ex.G + 0.09),
                    Math.Min(1.0, ex.B + 0.13)
                ));
            }
        }
    }

    // Sailboat
    var boatY = horizon - 0.5 + bob;

    // Flare factor based on proximity to moon corridor
    var distC = Math.Abs(bx - corridorCx);
    var flare = Math.Max(0.0, 1.0 - distC / corridorR);
    flare = flare * flare;

    var hullR = 0.08 + flare * 0.88;
    var hullG = 0.10 + flare * 0.86;
    var hullB = 0.18 + flare * 0.78;
    var sailR = 0.12 + flare * 0.84;
    var sailG = 0.14 + flare * 0.82;
    var sailB = 0.22 + flare * 0.74;

    var hullColor = new Color(hullR, hullG, hullB);
    var sailColor = new Color(sailR, sailG, sailB);

    var layer = ctx.NewLayer(clearColor: Colors.TransparentBlack);

    // Hull
    layer.DrawRectXyWh(bx - 2.0, boatY + 0.8, 4.0, 1.5, colorFill: hullColor);

    // Mast
    layer.DrawLine(bx, boatY + 0.8, bx, boatY - 4.2,
        color: hullColor, strokeWidth: 1.0);

    // Sail — triangle via tapering lines
    for (var si = 0; si <= 4; si++)
    {
        var frac = si / 4.0;
        var sy = boatY + 0.8 - frac * 4.5;
        var sw = 2.8 * (1.0 - frac);
        layer.DrawLine(bx, sy, bx + sw, sy, color: sailColor, strokeWidth: 1.0);
    }

    // Tilt around hull base
    layer.Rotate(tilt, bx, boatY + 1.5);
    layer.Apply(BlendMode.SourceOver);

    // Time — phosphorescent blue-white at bottom
    var timeStr = ctx.Now.ToString("HH:mm");
    var tw = ctx.MeasureTextMono4x5(timeStr);
    ctx.DrawTextMono4x5(timeStr, (24.0 - tw) / 2.0, 19.0,
        color: new Color(0.38, 0.52, 0.78));
};
