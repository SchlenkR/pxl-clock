    }

    // Sun (top right)
    ctx.DrawCircle(19, 4, 3.2, colorFill: Color.FromRgb(1.0, 0.88, 0.28).WithAlpha(0.25), isAntialias: true);
    ctx.DrawCircle(19, 4, 2.2, colorFill: Color.FromRgb(1.0, 0.92, 0.35));

    // Wave function helper — inline via lambdas
    var waveAt = (double x) =>
        13.5
        + Math.Sin(x * 0.55 - ws) * 1.3
        + Math.Sin(x * 0.85 - ws * 1.4) * 0.55;

    // Draw waves as water surface
    for (var x = 0; x < 24; x++)
    {
        var wy = waveAt(x);
        var wyInt = (int)Math.Round(wy);
        // Crest highlight
        if (wyInt >= 0 && wyInt < 24)
            ctx.SetPixel(x, wyInt, Color.FromRgb(0.45, 0.75, 1.0));
        // Secondary crest
        if (wyInt + 1 < 24)
            ctx.SetPixel(x, wyInt + 1, Color.FromRgb(0.1, 0.35, 0.72));
    }

    // Boat wave position at x=11
    var bx = 11.0;
    var bWaveY = waveAt(bx);

    // Wave slope → rocking angle (subtle)
    var slopeY = waveAt(bx + 1.5) - waveAt(bx - 1.5);
    var rockAngle = Math.Atan2(slopeY, 3.0) * 180.0 / Math.PI * 0.6;

    // Boat layer — local coords: hull top at y=16, pivot center (11, 17)
    var boat = ctx.NewLayer(clearColor: Colors.Transparent);

    // Hull (trapezoid, 3 rows)
    boat.DrawRectXyWh(7, 16, 9, 1, colorFill: Colors.White);   // deck
    boat.DrawRectXyWh(8, 17, 7, 1, colorFill: Colors.White);   // mid
    boat.DrawRectXyWh(9, 18, 5, 1, colorFill: Colors.White);   // keel row

    // Mast
    boat.DrawLine(11, 7, 11, 16, Colors.White, strokeWidth: 1);

    // Sail (triangle, opening to right from mast)
    for (var si = 0; si < 9; si++)
    {
        var sw = (int)(si * 0.85) + 1;
        boat.DrawRectXyWh(12, 7 + si, sw, 1, colorFill: Colors.White);
    }

    // Apply rocking rotation around hull pivot, then shift to wave
    boat.Rotate(rockAngle, 11, 17);
    boat.Translate(0, bWaveY - 16.0);
    boat.Apply(BlendMode.SourceOver, Interpolation.NearestNeighbor);

    // Foreground wave crest in front of hull (depth)
    for (var x = 0; x < 24; x++)
