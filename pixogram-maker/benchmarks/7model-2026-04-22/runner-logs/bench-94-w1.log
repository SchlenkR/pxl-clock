#:package Pxl@*

using Pxl.Ui.CSharp;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;
    var now = ctx.Now;
    var ws = t * 2.2; // wave scroll

    // Sky gradient
    for (var y = 0; y < 13; y++)
    {
        var f = y / 12.0;
        ctx.DrawRectXyWh(0, y, 24, 1, colorFill: Color.FromRgb(0.04 + f * 0.02, 0.12 + f * 0.08, 0.38 + f * 0.12));
