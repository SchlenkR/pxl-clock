    }
    for (var i = 0; i < targets.Count; i++)
    {
        var tgt = targets[i];
        sparks.Add(new Spark
        {
            Birth = t + 0.035 * i + rng.NextDouble() * 0.12,
            Ascent = 0.7 + rng.NextDouble() * 0.5,
            OriX = cratX + (rng.NextDouble() - 0.5) * 1.6,
            OriY = cratY - 1,
            TgtX = tgt.Item1,
            TgtY = tgt.Item2,
            SeedA = rng.NextDouble() * 6.2831,
            SeedB = rng.NextDouble() * 6.2831,
            Amp = 1.3 + rng.NextDouble() * 2.8,
            HoldFlick = rng.NextDouble() * 6.2831,
        });
    }
    var escapeCount = 5 + rng.Next(4);
    for (var i = 0; i < escapeCount; i++)
    {
        var angle = -Math.PI / 2 + (rng.NextDouble() - 0.5) * 2.1;
        var speed = 3.5 + rng.NextDouble() * 6.5;
        sparks.Add(new Spark
        {
            Birth = t + rng.NextDouble() * 0.35,
            Ascent = 1.0,
            OriX = cratX + (rng.NextDouble() - 0.5) * 2.2,
            OriY = cratY - 1,
            Escape = true,
            EscVx = Math.Cos(angle) * speed,
            EscVy = Math.Sin(angle) * speed,
            SeedA = rng.NextDouble() * 6.2831,
        });
    }
};

var shatter = (double t) =>
{
    foreach (var s in sparks)
    {
        if (s.Escape) continue;
        s.ShatterT = t + rng.NextDouble() * 0.28;
        s.ShatterDur = 0.45 + rng.NextDouble() * 0.35;
    }
};

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;

    for (var y = 0; y < 24; y++)
    {
        var f = y / 23.0;
        var col = Color.FromRgb(0.01 + f * 0.02, 0.005 + f * 0.012, 0.025 + f * 0.04);
        for (var x = 0; x < 24; x++)
            ctx.SetPixel(x, y, col);
    }

    var stars = new (int, int, double)[]
    {
        (2, 2, 0.3), (7, 1, 0.8), (13, 3, 0.5), (19, 2, 0.9),
        (22, 5, 0.4), (1, 8, 0.6), (5, 11, 0.2), (17, 11, 0.7),
        (21, 13, 0.5), (10, 14, 0.3)
    };
    foreach (var (sx, sy, seed) in stars)
    {
        var tw = 0.35 + 0.55 * (0.5 + 0.5 * Math.Sin(t * 1.4 + seed * 9.3));
        ctx.SetPixel(sx, sy, Color.FromRgb(tw * 0.75, tw * 0.72, tw * 0.85));
    }

    if (eruptionCount == 0 && t > 0.25)
    {
        launch(ctx.Now, t);
        eruptionCount++;
        nextTrigger = t + 5.5 + rng.NextDouble() * 2.5;
    }

    var minuteChanged = ctx.Now.Minute != lastMinute && lastMinute != -1;
    lastMinute = ctx.Now.Minute;

    if ((t >= nextTrigger || minuteChanged) && state == 0 && eruptionCount > 0)
    {
        shatter(t);
        state = 1;
    }
    if (state == 1)
    {
        var allDone = true;
        foreach (var s in sparks)
        {
            if (s.Escape) continue;
            if (s.ShatterT < 0) { allDone = false; break; }
            if (t < s.ShatterT + s.ShatterDur) { allDone = false; break; }
        }
        if (allDone)
        {
            launch(ctx.Now, t + 0.12);
            state = 0;
            eruptionCount++;
            nextTrigger = t + 5.0 + rng.NextDouble() * 3.0;
        }
    }

    var volcanoRows = new (int, int, int)[]
    {
        (23, 3, 21), (22, 5, 19), (21, 6, 18),
        (20, 8, 16), (19, 9, 15), (18, 10, 14),
    };
    foreach (var (vy, vs, ve) in volcanoRows)
    {
        for (var vx = vs; vx <= ve; vx++)
        {
            var dx = vx - cratX;
            var dy = vy - cratY;
            var dist = Math.Sqrt(dx * dx + dy * dy);
            var glow = Math.Max(0, 1 - dist / 6);
            var streak = 0.0;
            if ((vx * 3 + vy * 7) % 5 == 0 && vy >= 20)
                streak = 0.32 * (0.55 + 0.45 * Math.Sin(t * 2.1 + vx * 0.9));
            var r = Math.Min(1, 0.08 + glow * 0.3 + streak * 0.9);
            var g = Math.Min(1, 0.03 + glow * 0.08 + streak * 0.18);
            var b = 0.02;
            ctx.SetPixel(vx, vy, Color.FromRgb(r, g, b));
        }
    }

    var breathe = 0.55 + 0.25 * Math.Sin(t * 2.7) + 0.12 * Math.Sin(t * 5.3 + 1.1);
    var launchPulse = 0.0;
    foreach (var s in sparks)
    {
        if (s.Escape) continue;
        var age = t - s.Birth;
        if (age > 0 && age < 0.55)
            launchPulse = Math.Max(launchPulse, 1 - age / 0.55);
    }
    var craterBright = Math.Min(1, breathe * 0.55 + launchPulse * 0.85);
