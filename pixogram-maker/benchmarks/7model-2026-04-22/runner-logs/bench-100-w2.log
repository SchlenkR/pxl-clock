                    list.Add((xOff[i] + c, yOff + r));
    }
    list.Add((11, yOff + 1));
    list.Add((11, yOff + 3));
    return list;
};

var heatColor = (double h) =>
{
    h = Math.Clamp(h, 0, 1);
    if (h > 0.75)
    {
        var u = (h - 0.75) / 0.25;
        return Color.FromRgb(1, 0.88 + 0.12 * u, 0.55 + 0.45 * u);
    }
    if (h > 0.5)
    {
        var u = (h - 0.5) / 0.25;
        return Color.FromRgb(1, 0.55 + 0.33 * u, 0.12 + 0.43 * u);
    }
    if (h > 0.25)
    {
        var u = (h - 0.25) / 0.25;
        return Color.FromRgb(0.85 + 0.15 * u, 0.18 + 0.37 * u, 0.02 + 0.1 * u);
    }
    var u2 = h / 0.25;
    return Color.FromRgb(0.35 + 0.5 * u2, 0.0 + 0.18 * u2, 0.0 + 0.02 * u2);
