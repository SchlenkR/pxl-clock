 2.6;
        var ssx = cratX + Math.Sin(t * 0.28 + i * 1.23) * 2.6 + (i - 4) * 0.28;
        var ssy = cratY - 2 - u * 13;
        var ix = (int)ssx;
        var iy = (int)ssy;
        if (iy < 0 || iy > 23 || ix < 0 || ix > 23) continue;
        var alpha = (1 - u) * 0.22;
        var ex = ctx.GetPixel(ix, iy);
        var nr = Math.Min(1, ex.R + 0.28 * alpha);
        var ng = Math.Min(1, ex.G + 0.26 * alpha);
        var nb = Math.Min(1, ex.B + 0.3 * alpha);
        ctx.SetPixel(ix, iy, Color.FromRgb(nr, ng, nb));
    }

    if (t - lastAmbient > 0.07 + rng.NextDouble() * 0.14)
    {
        lastAmbient = t;
        var count = rng.Next(1, 3);
        for (var i = 0; i < count; i++)
        {
            var angle = -Math.PI / 2 + (rng.NextDouble() - 0.5) * 1.05;
            var speed = 1.8 + rng.NextDouble() * 4.2;
            ambient.Add(new Ember
            {
                Birth = t,
                X = cratX + (rng.NextDouble() - 0.5) * 2.0,
                Y = cratY - 1,
                Vx = Math.Cos(angle) * speed,
                Vy = Math.Sin(angle) * speed,
                Life = 0.7 + rng.NextDouble() * 1.1,
                Seed = rng.NextDouble() * 6.2831,
            });
        }
    }
    for (var i = ambient.Count - 1; i >= 0; i--)
    {
        var e = ambient[i];
        var age = t - e.Birth;
        if (age > e.Life) { ambient.RemoveAt(i); continue; }
        var wob = Math.Sin(age * 4.2 + e.Seed) * 0.28;
        var px = e.X + e.Vx * age + wob;
        var py = e.Y + e.Vy * age + 0.5 * 6.5 * age * age;
        if (py > 23.5) { ambient.RemoveAt(i); continue; }
        if (px < 0 || px > 23.4 || py < 0) continue;
        var heat = Math.Max(0, 1 - age / e.Life);
        ctx.DrawPoint(px, py, heatColor(heat));
    }

    foreach (var s in sparks)
    {
        var age = t - s.Birth;
        if (age < 0) continue;

        var px = 0.0;
        var py = 0.0;
        var heat = 0.0;

        if (s.Escape)
        {
            px = s.OriX + s.EscVx * age + Math.Sin(age * 4.1 + s.SeedA) * 0.42;
            py = s.OriY + s.EscVy * age + 0.5 * 7.0 * age * age;
            if (py > 23.5 || px < -1 || px > 24.5) continue;
            heat = Math.Max(0, 1 - age * 0.68);
        }
        else if (s.ShatterT < 0 || t < s.ShatterT)
        {
            if (age < s.Ascent)
            {
                var u = age / s.Ascent;
                var eu = 1 - Math.Pow(1 - u, 2.3);
                var bx = s.OriX + (s.TgtX - s.OriX) * eu;
                var by = s.OriY + (s.TgtY - s.OriY) * eu;
                var decay = Math.Pow(1 - u, 1.5);
                var wob = Math.Sin(u * 5.3 + s.SeedA) * decay * s.Amp
                        + Math.Sin(u * 12.7 + s.SeedB) * decay * 0.38 * s.Amp;
                px = bx + wob;
                py = by + Math.Sin(u * 7.1 + s.SeedB) * decay * 0.55;
                heat = 0.93 + 0.07 * Math.Sin(age * 23 + s.SeedA);
            }
            else
            {
                var hAge = age - s.Ascent;
                var jx = Math.Sin(t * 3.4 + s.SeedA) * 0.18 + Math.Sin(t * 7.9 + s.SeedB) * 0.08;
                var jy = Math.Sin(t * 4.1 + s.SeedB) * 0.14 + Math.Cos(t * 6.2 + s.SeedA) * 0.06;
                px = s.TgtX + jx;
                py = s.TgtY + jy;
                var cooling = Math.Max(0.34, 1 - hAge * 0.28);
                var flick = 0.86 + 0.14 * Math.Sin(t * 10.3 + s.HoldFlick);
                heat = cooling * flick;
            }
        }
        else
        {
            var sAge = t - s.ShatterT;
            if (sAge > s.ShatterDur) continue;
            var u = sAge / s.ShatterDur;
            var eu = u * u;
            var burstAngle = s.SeedA * 2;
            var burst = Math.Sin(u * Math.PI) * (2.0 + Math.Sin(s.SeedB) * 0.8);
            var dirX = Math.Cos(burstAngle);
            var dirY = Math.Sin(burstAngle) - 0.45;
            px = s.TgtX * (1 - eu) + s.OriX * eu + dirX * burst;
            py = s.TgtY * (1 - eu) + s.OriY * eu + dirY * burst;
            heat = Math.Max(0.22, 1 - u * 0.55);
        }

        if (px < 0 || px > 23.5 || py < 0 || py > 23.5) continue;
        ctx.DrawPoint(px, py, heatColor(heat));
    }
};

class Spark
{
    public double Birth;
    public double Ascent;
    public double OriX, OriY;
    public double TgtX, TgtY;
    public double SeedA, SeedB;
    public double Amp;
    public double ShatterT = -1;
    public double ShatterDur = 0.6;
    public double HoldFlick;
    public bool Escape;
    public double EscVx, EscVy;
}

class Ember
{
    public double Birth;
    public double X, Y;
    public double Vx, Vy;
    public double Life;
    public double Seed;
}
