**Analysis:**

1. **What changed?** The maintainer wants more organic, less mechanical, less predictable motion.
2. **What's broken?** The previous iteration likely used single sine waves per property, which creates a perfectly regular oscillation that reads as "mechanical". True organic feel needs several independent oscillators at irrational frequency ratios layered together — no single dominant period is perceivable.
3. **What's the fix?**
   - Replace each single `sin(t * freq)` with a sum of 3–4 sines at irrational-ratio frequencies (e.g. 1.0, 1.618, 2.414, 3.141) with different phases
   - Give flame brightness, sway, height, and glow independent multi-oscillator signals so they never visibly sync up
   - Add a fast micro-jitter layer on top of the slow sway for the tip
   - Smoke drift direction should also use compound oscillators
   - Keep the candle/glow/smoke visual structure intact; only change the timing math
4. **Verify:** Irrational ratios like π, φ, √2 prevent the animation from visibly repeating in any reasonable timespan, breaking the periodic "mechanical" feel.

```csharp
// ---
// app: KerzenlichtImWind
// displayName: Kerzenlicht im Wind
// appType: Scene
// author: pixogram-maker
// description: Eine Kerze flackert organisch im Wind mit warmem Glühen
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;

    // Multi-frequency sway — irrational ratios ensure no perceived period
    var sway =  Math.Sin(t * 0.71)  * 0.90
              + Math.Sin(t * 1.618) * 0.45
              + Math.Sin(t * 2.414) * 0.22
              + Math.Sin(t * 4.236) * 0.10
              + Math.Sin(t * 7.389) * 0.04;
    sway /= 1.71; // normalise to roughly -1..1

    // Independent height flicker — different base frequencies
    var hFlicker =  Math.Sin(t * 3.141) * 0.18
                  + Math.Sin(t * 5.236) * 0.09
                  + Math.Sin(t * 8.854) * 0.04
                  + Math.Sin(t * 1.272) * 0.12;
    var heightMod = 1.0 + hFlicker;

    // Independent brightness flicker
    var bright =  0.88
                + Math.Sin(t * 4.669) * 0.07
                + Math.Sin(t * 7.854) * 0.04
                + Math.Sin(t * 2.718) * 0.06
                + Math.Sin(t * 11.33) * 0.02;
    bright = Math.Max(0.62, Math.Min(1.0, bright));

    // Independent glow pulse
    var glowPulse =  1.0
                   + Math.Sin(t * 3.927) * 0.12
                   + Math.Sin(t * 6.283) * 0.06
                   + Math.Sin(t * 1.414) * 0.09;

    // Dark warm background
    ctx.DrawBackground(new Color(0.04, 0.025, 0.01));

    var cx = 12.0;
    var candleTopY = 15.0;
    var candleBottomY = 23.0;
    var flameBaseY = candleTopY;
    var flameHeight = 5.2 * heightMod;
    var flameTipX = cx + sway * 2.2;
    var flameTipY = flameBaseY - flameHeight;

    // --- Ambient glow (painted per-pixel for smooth radial falloff) ---
    var glowCx = cx + sway * 0.8;
    var glowCy = flameBaseY - 1.5;
    var glowR = 7.0 * glowPulse;
    for (var py = 0; py < 24; py++)
    {
        for (var px = 0; px < 24; px++)
        {
            var dx = px - glowCx;
            var dy = py - glowCy;
            var dist = Math.Sqrt(dx * dx + dy * dy);
            if (dist < glowR)
            {
                var falloff = Math.Pow(1.0 - dist / glowR, 2.2) * 0.55 * bright;
                var existing = ctx.GetPixel(px, py);
                ctx.SetPixel(px, py, new Color(
                    Math.Min(1.0, existing.R + 0.95 * falloff),
                    Math.Min(1.0, existing.G + 0.32 * falloff),
                    Math.Min(1.0, existing.B + 0.01 * falloff)
                ));
            }
        }
    }

    // --- Candle body ---
    ctx.DrawRectXyWh(cx - 2, candleTopY, 5, candleBottomY - candleTopY,
        colorFill: new Color(0.82, 0.79, 0.75));
    ctx.DrawRectXyWh(cx + 1.5, candleTopY, 1.5, candleBottomY - candleTopY,
        colorFill: new Color(0.55, 0.52, 0.49));
    ctx.DrawRectXyWh(cx - 2, candleTopY, 1.0, candleBottomY - candleTopY,
        colorFill: new Color(0.93, 0.91, 0.88));

    // --- Wick ---
    ctx.DrawLine(cx, candleTopY, cx + sway * 0.25, candleTopY - 1.0,
        new Color(0.12, 0.08, 0.04), 1.0);

    // --- Flame layers (outer dark → inner bright) ---
    var flameLayers = new (double widthScale, double tipLift, Color col)[]
    {
        (1.00, 0.0,  new Color(0.65 * bright, 0.10 * bright, 0.0)),
        (0.78, 0.6,  new Color(0.82 * bright, 0.25 * bright, 0.0)),
        (0.58, 1.2,  new Color(0.94 * bright, 0.50 * bright, 0.01)),
        (0.38, 1.9,  new Color(1.00 * bright, 0.72 * bright, 0.08 * bright)),
        (0.20, 2.6,  new Color(1.00 * bright, 0.94 * bright, 0.55 * bright)),
    };

    // Micro-jitter for tip (    [anthropic] Unknown event: ping
very fast, small amplitude — makes flame "alive")
    var tipJitter =  Math.Sin(t * 13.7)  * 0.18
                   + Math.Sin(t * 19.43) * 0.10;

    for (var li = 0; li < flameLayers.Length; li++)
    {
        var (ws, tl, col) = flameLayers[li];
        var layerSway = (flameTipX - cx) * (1.0 - li * 0.04) + tipJitter * (li == flameLayers.Length - 1 ? 1.0 : 0.3);
        var layerTipX = cx + layerSway;
        var layerTipY = flameTipY + tl;
        var baseWidth = 2.6 * ws;

        var steps = 10;
        for (var s = 0; s <= steps; s++)
        {
            var frac = s / (double)steps;
            var fx = cx + (layerTipX - cx) * frac;
            var fy = flameBaseY + (layerTipY - flameBaseY) * frac;
            var fr = baseWidth * (1.0 - frac * 0.88);
            if (fr > 0.15)
                ctx.DrawCircle(fx, fy, fr, colorFill: col, isAntialias: true);
        }
    }

    // --- Smoke wisps ---
    for (var i = 0; i < 5; i++)
    {
        var sOffset = i * 0.55;
        var smokeT = (t - sOffset);
        var age = ((smokeT % 2.2) + 2.2) % 2.2 / 2.2;
        // Independent drift per particle using different frequencies
        var driftX = flameTipX + tipJitter
                   + Math.Sin(smokeT * 1.3 + i * 1.9) * 1.4
                   + Math.Sin(smokeT * 2.8 + i * 0.7) * 0.7;
        var driftY = flameTipY - age * 9.0;
        var alpha = (1.0 - age) * (1.0 - age) * 0.28;
        if (alpha > 0.02 && driftY > -1)
        {
            var g = 0.28 + age * 0.22;
            ctx.DrawCircle(driftX, driftY, 0.7 + age * 0.6,
                colorFill: new Color(g, g, g, alpha), isAntialias: true);
        }
    }
};
