```csharp
// ---
// app: KerzenlichtImWind
// displayName: Kerzenlicht im Wind
// appType: ClockFace
// author: claude
// description: A candle just extinguished. The ember cools, smoke drifts, until the wind rekindles briefly.
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;
    var now = ctx.Now;

    // 16-second cycle
    var ct = t % 16.0;

    // Compute ember and flame intensity from cycle phase
    var flameI = 0.0;
    var emberI = 0.0;

    if (ct < 6.0)
    {
        // Ember slowly cools, barely alive
        emberI = 0.18 - ct * 0.018;
        if (emberI < 0.04) emberI = 0.04;
        emberI += 0.015 * Math.Sin(t * 1.7 + 0.3);
        flameI = 0.0;
    }
    else if (ct < 8.0)
    {
        // Wind returns — ember brightens
        var pt = (ct - 6.0) / 2.0;
        emberI = 0.05 + pt * 0.95;
        // Flame blooms at very end
        flameI = pt > 0.88 ? (pt - 0.88) / 0.12 : 0.0;
    }
    else if (ct < 12.0)
    {
        // Flame alive — flickers
        var pt = (ct - 8.0) / 4.0;
        var flicker = 0.72 + 0.28 * (Math.Sin(t * 8.1) * 0.55 + Math.Sin(t * 13.3) * 0.45);
        flameI = flicker;
        if (pt < 0.08) flameI *= pt / 0.08;
        emberI = 1.0;
    }
    else
    {
        // Wind extinguishes — flame dies
        var pt = (ct - 12.0) / 4.0;
        var flicker = 0.45 + 0.55 * Math.Abs(Math.Sin(t * 5.9 + 0.4));
        flameI = (1.0 - pt) * (1.0 - pt) * flicker;
        if (flameI < 0.0) flameI = 0.0;
        emberI = 1.0 - pt * 0.82;
        if (emberI < 0.04) emberI = 0.04;
    }

    // Clear canvas
    ctx.DrawBackground(Colors.Black);

    // Candle geometry
    var cx = 12.0;
    var wickY = 12.0;

    // Candle body — barely visible in dark, gains warmth from flame
    var bodyB = 0.10 + flameI * 0.28;
    ctx.DrawRectXyWh(cx - 2, wickY + 1, 5, 6, colorFill: new Color(bodyB * 0.92, bodyB * 0.87, bodyB * 0.72, 1.0));

    // Wick line
    var wB = 0.08 + emberI * 0.22;
    ctx.DrawLine(cx, wickY + 1, cx, wickY + 2, color: new Color(wB * 0.55, wB * 0.28, wB * 0.08, 1.0));

    // Ember glow at wick tip
    if (emberI > 0.01)
    {
        var glowA = emberI * 0.38;
        ctx.DrawCircle(cx, wickY, 2.2, colorFill: new Color(0.88, 0.18, 0.02, glowA));
        var eR = Math.Min(1.0, 0.85 + emberI * 0.15);
        var eG = 0.05 + emberI * 0.22;
        ctx.SetPixel((int)cx, (int)wickY, new Color(eR, eG, 0.02, 1.0));
    }

    // Flame when rekindled
    if (flameI > 0.02)
    {
        var sway = 0.65 * Math.Sin(t * 2.7) * Math.Sin(t * 1.4 + 0.9);

        // Wide outer warm glow — makes the scene and time legible
        ctx.DrawCircle(cx + sway * 0.2, wickY - 3, 12, colorFill: new Color(0.75, 0.30, 0.04, flameI * 0.12));
        ctx.DrawCircle(cx + sway * 0.3, wickY - 1, 7    [anthropic] Unknown event: ping
, colorFill: new Color(0.92, 0.50, 0.08, flameI * 0.20));
        ctx.DrawCircle(cx + sway * 0.3, wickY - 1, 4, colorFill: new Color(1.0, 0.65, 0.12, flameI * 0.28));

        // Flame body layers
        ctx.DrawCircle(cx + sway * 0.35, wickY - 1.4, 1.9, colorFill: new Color(1.0, 0.48, 0.04, flameI));
        ctx.DrawCircle(cx + sway * 0.55, wickY - 3.0, 1.35, colorFill: new Color(1.0, 0.80, 0.14, flameI * 0.94));
        ctx.DrawCircle(cx + sway * 0.75, wickY - 4.5, 0.9, colorFill: new Color(1.0, 0.93, 0.60, flameI * 0.85));
        ctx.DrawCircle(cx + sway * 0.9, wickY - 5.6, 0.5, colorFill: new Color(1.0, 1.0, 0.92, flameI * 0.70));
    }

    // Smoke wisp — blue-grey, irregular spiral upward
    var smokeP = 1.0 - flameI;
    if (smokeP > 0.06)
    {
        for (var i = 1; i <= 10; i++)
        {
            var prog = (double)i / 10.0;
            var st = t * 0.55 + prog * 2.1;
            var sx = cx + 2.0 * Math.Sin(st * 1.5) * Math.Cos(st * 0.8 + 1.2) * prog;
            var sy = wickY - prog * 13.0;
            var sa = smokeP * (1.0 - prog) * 0.42;
            if (sy >= 0 && sa > 0.01)
                ctx.DrawCircle(sx, sy, 0.65, colorFill: new Color(0.52, 0.58, 0.64, sa));
        }
    }

    // Time in lower third — barely visible normally, warm and legible during flame
    var timeAlpha = 0.14 + flameI * 0.80;
    Color timeCol;
    if (flameI > 0.04)
        timeCol = new Color(1.0, 0.72 + flameI * 0.12, 0.18 * flameI, timeAlpha);
    else
        timeCol = new Color(0.32, 0.28, 0.25, timeAlpha);

    ctx.DrawTextMono4x5(now.ToString("HH:mm"), 2, 19, color: timeCol);
};
