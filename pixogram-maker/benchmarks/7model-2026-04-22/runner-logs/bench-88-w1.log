```csharp
// ---
// app: SparkInTheStorm
// displayName: Spark in the Storm
// appType: Scene
// author: Implementor
// description: A single intense spark streaks through a dark storm of embers, leaving a trail of light.
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

// --- State Management ---

var spark = new Spark();
var embers = new List<Ember>();
var sparkTrail = new List<TrailPoint>();
var random = new Random(42);

// Initialize embers
for (int i = 0; i < 30; i++)
{
    embers.Add(new Ember(random.NextDouble() * 24, random.NextDouble() * 24, random));
}

var scene = (DrawingContext ctx) =>
{
    ctx.DrawBackground(Colors.Black);
    var t = ctx.Elapsed.TotalSeconds;
    var cycle = ctx.CycleNo;

    // 1. Update Spark Position (Erratic Horizontal Streak)
    // Strong horizontal movement modulated by a slow sine wave, 
    // with high-frequency jitter for "erratic" feel.
    spark.VX = (2.5 + Math.Sin(t * 0.5) * 1.5) + (Math.Sin(t * 10.0) * 0.5);
    spark.VY = Math.Cos(t * 0.8) * 0.8 + (Math.Sin(t * 15.0) * 0.3);
    
    spark.X += spark.VX;
    spark.Y += spark.VY;

    // Boundary bounce
    if (spark.X < 0 || spark.X > 24) spark.VX *= -1;
    if (spark.Y < 0 || spark.Y > 24) spark.VY *= -1;

    // 2. Update Spark Trail
    sparkTrail.Add(new TrailPoint(spark.X, spark.Y, 1.0));
    for (int i = 0; i < sparkTrail.Count; i++)
    {
        sparkTrail[i] = sparkTrail[i] with { Alpha = sparkTrail[i].Alpha * 0.85 };
    }
    // Remove old/invisible trail points
    sparkTrail.RemoveAll(p => p.Alpha < 0.01);

    // 3. Update and Draw Embers
    foreach (var ember in embers)
    {
        ember.Update(24);
        
        // Distance to spark for "catching the light"
        var dx = ember.X - spark.X;
        var dy = ember.Y - spark.Y;
        var distSq = dx * dx + dy * dy;
        var glow = Math.Max(0, 1.0 - Math.Sqrt(distSq) / 6.0);
        
        var emberColor = Color.FromRgb(0.8, 0.3, 0.1).WithAlpha(0.3 + glow * 0.7);
        ctx.DrawPoint(ember.X, ember.Y, emberColor);
    }

    // 4. Draw Spark Trail
    foreach (var p in sparkTrail)
    {
        ctx.DrawPoint(p.X, p.Y, Colors.Orange.WithAlpha(p.Alpha * 0.4));
    }

    // 5. Draw Spark (Intense Core)
    // Core -> Inner Glow -> Outer Glow
    ctx.DrawCircle(spark.X, spark.Y, 2.5, colorFill: Colors.Orange.WithAlpha(0.3));
    ctx.DrawCircle(spark.X, spark.Y, 1.5, colorFill: Colors.Yellow.WithAlpha(0.6));
    ctx.DrawCircle(spark.X, spark.Y, 0.6, colorFill: Colors.White);

    // 6. Draw Time (Flickering Trail)
    // The time follows the spark and flickers
    var timeStr = ctx.Now.ToString("HH:mm");
    var flicker = 0.6 + Math.Sin(t * 25.0) * 0.4; // Rapid flickering
    var timeColor = Colors.White.WithAlpha(flicker);
    
    // Center the text roughly around the spark
    // Using Mono4x5 for clarity in motion
    ctx.DrawTextMono4x5(timeStr, spark.X - 10, spark.Y - 2, timeColor);
};

// --- Helper Classes ---

public class Spark
{
    public double X = 12.0;
    public double Y = 12.0;
    public double VX = 2.0;
    public double VY = 0.0;
}

public class Ember
{
    public double X;
    public double Y;
    public double VX;
    public double VY;
    public Color Color;

    public Ember(double x, double y, Random rng)
    {
        X = x;
        Y = y;
        VX = (rng.NextDouble() - 0.5) * 0.1;
        VY = (rng.NextDouble() - 0.5) * 0.1;
        Color = Color.FromRgb(1.0, 0.4, 0.1);
    }

    public void Update(double limit)
    {
        X += VX;
        Y += VY;
        if (X < 0 || X > limit) VX *= -1;
        if (Y < 0 || Y > limit) VY *= -1;
    }
}

public record TrailPoint(double X, double Y, double Alpha);
