// displayName: Kerzenlicht
// appType: Scene
// author: Implementor
// description: Eine einzelne Kerze flackert sanft im Wind mit Glühen und Rauch.
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

// Animationen für das Flackern und den Wind
var flicker = Animate.EaseInOut(0.15, 0.8, 1.0, repeat: Repeat.Loop);
var wind = Animate.EaseInOut(3.0, -1.5, 1.5, repeat: Repeat.PingPong);
var smokeWave = Animate.EaseInOut(2.0, 0.0, 1.0, repeat: Repeat.PingPong);

var scene = (DrawingContext ctx) =>
{
    ctx.DrawBackground(Colors.Black);

    var centerX = ctx.Width / 2.0;
    var centerY = ctx.Height / 2.0;
    var time = ctx.Elapsed.TotalSeconds;

    // 1. Der Glüheffekt (Glow)
    var glowIntensity = 0.4 + 0.2 * Math.Sin(time * 5.0);
    var glowColor = Color.FromRgbaByte(255, 150, 50, (byte)(glowIntensity * 100));
    ctx.DrawCircle(centerX, centerY - 4, 6, colorFill: glowColor);

    // 2. Der Rauch
    for (var i = 0; i < 5; i++)
    {
        var smokeY = (centerY - 8) - (i * 3.0) - (time % 10.0 * 2.0);
        if (smokeY < 0) continue;
        
        var smokeX = centerX + Math.Sin(time * 2.0 + i) * 1.5;
        var smokeAlpha = Math.Max(0, 0.3 - (i * 0.05));
        ctx.SetPixel((int)smokeX, (int)smokeY, Color.FromRgbaByte(150, 150, 150, (byte)(smokeAlpha * 255)));
    }

    // 3. Die Kerze (Wachs/Stumpf)
    var candleWidth = 4.0;
    var candleHeight = 8.0;
    ctx.DrawRectXyWh(centerX - candleWidth / 2.0, centerY, candleWidth, candleHeight, Colors.DimGray);
    
    // Docht
    ctx.DrawLine(centerX, centerY, centerX, centerY - 2, Colors.Black, 1);

    // 4. Die Flamme
    var tilt = wind.Eval(ctx);
    var flameScale = flicker.Eval(ctx);
    
    var flameX = centerX + tilt * 0.5;
    var flameY = centerY - 4;
    
    for (var r = 4; r >= 1; r--)
    {
        var radius = r * flameScale;
        var color = r == 4 ? Colors.Orange : (r == 3 ? Colors.Yellow : Colors.White);
        ctx.DrawCircle(flameX, flameY - (r * 0.5), radius, colorFill: color);
    }
};
