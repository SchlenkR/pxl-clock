// ---
// app: KerzenlichtImWind
// displayName: Kerzenlicht im Wind
// appType: Scene
// author: Implementor
// description: A lonely candle flickering in the dark with an organic flame, smoke, and amber time display.
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;
    var now = ctx.Now;
    var timeStr = now.ToString("HH:mm");

    // 1. Background
    ctx.DrawBackground(Colors.Black);

    // 2. Candle Body
    ctx.DrawRectXyWh(11.5, 16, 1, 7, Colors.DimGray);

    // 3. Organic Wind/Tilt calculation
    // Combined sine waves for irregular, struggling movement
    var tilt = Math.Sin(t * 0.8) * 2.0 + Math.Sin(t * 3.5) * 0.8 + Math.Sin(t * 8.0) * 0.3;
    
    // 4. Smoke (Fragile thread)
    for (var i = 0; i < 8; i++)
    {
        var sy = 13 - i * 1.2;
        if (sy < 2) break;
        var sx = 12 + tilt * 0.4 + Math.Sin(t * 1.5 + i) * 0.5;
        ctx.DrawPoint(sx, sy, Colors.Gray.WithAlpha(0.2));
    }

    // 5. Light Layer (Flame, Glow, and Time)
    var lightLayer = ctx.NewLayer(Colors.Transparent);
    var amber = new Color(1.0, 0.5, 0.1);

    // Subtle ambient glow around the flame
    lightLayer.DrawCircle(12 + tilt, 14, 5, colorFill: amber.WithAlpha(0.3));

    // Flickering Flame
    var flicker = 0.85 + 0.15 * Math.Sin(t * 12.0) + 0.05 * Math.Sin(t * 25.0);
    lightLayer.DrawCircle(12 + tilt, 14, 2 * flicker, colorFill: amber);

    // Time etched in the glow (to the left of the flame)
    // Using Var4x5 font, positioned to sit beside/under the light
    lightLayer.DrawTextVar4x5(timeStr, 7, 14, color: amber.WithAlpha(0.5));

    // Apply light layer using Screen to simulate illumination
    lightLayer.Apply(BlendMode.Screen);
};
