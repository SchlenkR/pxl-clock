Analysis:

The maverick wants something fundamentally new: ditch the previous "smokey candle with corner clock digits" concept entirely. The candle must be **small and patient** at the bottom center (short cream column + tilting teardrop flame + amber halo). The **smoke itself becomes the clock** — a single wisp rises from the wick, thickens, and curls into the four digits of the current time (HH:MM) in soft grey-white smoke strokes that shear with each wind gust (edges fraying, "3" briefly losing its middle, "0" stretching oval) before re-coiling into legibility.

Plan:
1. **Wind model**: sum of slow/medium/fast sines + an occasional gust, giving a wind value in roughly [-1..1].
2. **Candle**: 3-wide cream column at bottom center (y=19..23), with one shadow column on the right, tiny dark wick at y=18.
3. **Flame**: teardrop 3–4 px tall above the wick, top leans with wind (tilt ∝ ry²), layered core/yellow/orange. Subtle length flicker.
4. **Halo**: soft amber radial glow around the flame, squashed vertically, low-amplitude shimmer.
5. **Smoke clock** — the centerpiece:
   - Hardcoded 3×5 digit font for `0`–`9` and `:` so I don't depend on mask-layer readback.
   - Render HH:MM at baseX=3, baseY=4 (y rows 4..8).
   - For each canvas pixel in the digit rows, compute a per-row **shear** (proportional to height above wick, wind, gust, and a sine-curl term). Sample `IsOn(x - shear, y)` to find whether that pixel sits on a glyph.
   - Modulate alpha with a cheap sine-based noise → "never quite solid"; add fragmentation (skip pixels when wind is strong) and occasional holes ("3" loses its middle).
   - All smoke is blended (alpha-over) on top of black, giving a soft grey-white wash.
6. **Wisp trail**: single-pixel curly grey line from y=16 down to y=9, connecting the wick to the digits (sheared by the same wind field, plus extra jitter).
7. No `MathF`/`float`, everything `double`; all locals `var`; helpers as local functions inside the scene.

Shear scale is tuned so the top digit row shifts up to ~2.8 px in a strong gust while the bottom row shifts ~1.9 px — enough to visibly slant the digits without destroying legibility, so they "re-coil" as the wind eases.

```csharp
// ---
// app: SmokeClock
// displayName: Smoke Clock
// appType: ClockFace
// author: SchlenkR
// description: A small candle exhales the current time as curling smoke digits in the dark above.
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var scene = (DrawingContext ctx) =>
{
    ctx.DrawBackground(Colors.Black);
    var t = ctx.Elapsed.TotalSeconds;

    // --- Wind ---
    var wind = Math.Sin(t * 0.65) * 0.55
             + Math.Sin(t * 1.9 + 1.2) * 0.30
             + Math.Sin(t * 4.3 + 0.4) * 0.15;
    if (wind > 1) wind = 1;
    if (wind < -1) wind = -1;
    var gust = Math.Max(0, Math.Sin(t * 0.37 - 0.8)) * 0.40;
    var gustDir = wind >= 0 ? 1.0 : -1.0;

    // --- Geometry ---
    var cx = 12.0;
    var wickY = 17.5;
    var candleTopY = 19;
    var smokeTop = 2.0;
    var digitTopY = 4;
    var digitBottomY = 8;
    var baseX = 3;

    // --- 3x5 digit glyphs ---
    string[] Glyph(char c) => c switch
    {
        '0' => new[] { "111","101","101","101","111" },
        '1' => new[] { "010","110","010","010","111" },
        '2' => new[] { "111","001","111","100","111" },
        '3' => new[] { "111","001","111","001","111" },
        '4' => new[] { "101","101","111","001","001" },
        '5' => new[] { "111","100","111","001","    [anthropic] Unknown event: ping
111" },
        '6' => new[] { "111","100","111","101","111" },
        '7' => new[] { "111","001","010","010","010" },
        '8' => new[] { "111","101","111","101","111" },
        '9' => new[] { "111","101","111","001","111" },
        ':' => new[] { "000","010","000","010","000" },
        _   => new[] { "000","000","000","000","000" },
    };

    var timeText = ctx.Now.ToString("HH:mm");

    bool IsOn(int px, int py)
    {
        var gy = py - digitTopY;
        if (gy < 0 || gy > 4) return false;
        var cxp = px - baseX;
        if (cxp < 0) return false;
        var which = cxp / 4;
        if (which >= timeText.Length) return false;
        var col = cxp % 4;
        if (col > 2) return false;
        return Glyph(timeText[which])[gy][col] == '1';
    }

    double Noise(double x, double y, double tt) =>
        (Math.Sin(x * 1.31 + tt * 0.71) * Math.Cos(y * 1.73 - tt * 0.43)
        + Math.Sin(x * 0.47 + y * 0.61 + tt * 0.29) * 0.7 + 1.7) / 3.4;

    void Blend(int x, int y, Color c)
    {
        if (x < 0 || x >= 24 || y < 0 || y >= 24) return;
        var a = c.A;
        if (a <= 0) return;
        var cur = ctx.GetPixel(x, y);
        ctx.SetPixel(x, y, new Color(
            cur.R * (1 - a) + c.R * a,
            cur.G * (1 - a) + c.G * a,
            cur.B * (1 - a) + c.B * a));
    }

    double Shear(double y)
    {
        var r = (wickY - y) / (wickY - smokeTop);
        if (r < 0) r = 0;
        if (r > 1) r = 1;
        var curl = Math.Sin(r * 3.1 + t * 1.05) * 0.7;
        return wind * r * 3.2 + curl * r * 1.0 + gust * gustDir * r * 2.0;
    }

    // --- Wisp trail from wick up toward the digits ---
    for (var yy = 16; yy >= 9; yy--)
    {
        var r = (wickY - yy) / (wickY - smokeTop);
        if (r < 0) r = 0; if (r > 1) r = 1;
        var sh = Shear(yy);
        var jitter = Math.Sin(yy * 0.9 + t * 2.3) * 0.8 * r;
        var wx = (int)Math.Round(cx + sh + jitter);
        var a = (0.30 + 0.25 * Math.Sin(t * 3.1 + yy * 1.3)) * (1.0 - r * 0.25);
        if (a < 0) a = 0;
        Blend(wx, yy, new Color(0.80, 0.80, 0.75, a));
        var stray = Noise(wx * 0.9, yy * 0.9, t);
        if (stray > 0.78)
            Blend(wx + (stray > 0.88 ? 1 : -1), yy,
                new Color(0.72, 0.72, 0.67, a * 0.55));
    }

    // --- Smoke digits ---
    for (var y = digitTopY; y <= digitBottomY; y++)
    {
        var shear = Shear(y);
        var r = (wickY - y) / (wickY - smokeTop);
        if (r < 0) r = 0; if (r > 1) r = 1;

        for (var x = 0; x < 24; x++)
        {
            var sxi = (int)Math.Round(x - shear);
            if (!IsOn(sxi, y)) continue;

            var n = Noise(x * 0.85, y * 0.85 + t * 1.3, t);
            var vFade = 1.0 - Math.Pow(r, 2.2) * 0.55;
            var edge = 0.55 + 0.45 * n;
            var alpha = vFade * edge * 0.95;

            var fragChance = Math.Abs(wind) * 0.35 * r;
            var frag = Noise(x * 1.73 + 10.1, y * 1.73 + t * 0.9, t * 0.5);
            if (frag < fragChance) alpha *= 0.15;

            var hole = Noise(x * 2.1 + 4, y * 2.1 + 7 + t * 0.6, t * 0.7);
            if (hole < 0.06 + Math.Abs(wind) * 0.1) alpha *= 0.25;

            if (alpha < 0) alpha = 0;
            if (alpha > 1) alpha = 1;
            Blend(x, y, new Color(0.90, 0.89, 0.84, alpha));
        }
    }

    // --- Amber halo ---
    var flameX = cx + wind * 1.1 + gust * gustDir * 0.5;
    var flameBaseY = wickY - 0.3;
    var flameLen = 3.4 + Math.Sin(t * 6.1) * 0.25 + Math.Sin(t * 10.7) * 0.18;
    var flameTopY = flameBaseY - flameLen;

    for (var y = 11; y <= 18; y++)
    {
        for (var x = 6; x <= 18; x++)
        {
            var dx = x - flameX;
            var dy = (y - (flameBaseY - 1.3)) * 1.15;
            var d = Math.Sqrt(dx * dx + dy * dy);
            if (d > 4.2) continue;
            var h = 1.0 - d / 4.2;
            h = Math.Pow(h, 2.3) * 0.50;
            h *= 0.85 + 0.15 * Math.Sin(t * 8.1 + d * 2);
            Blend(x, y, new Color(1.0, 0.55, 0.12, h));
        }
    }

    // --- Flame (teardrop with tilt) ---
    var yStart = (int)Math.Floor(flameTopY);
    var yEnd = (int)Math.Ceiling(flameBaseY);
    for (var y = yStart; y <= yEnd; y++)
    {
        var ry = (flameBaseY - y) / (flameBaseY - flameTopY);
        if (ry < 0) ry = 0; if (ry > 1) ry = 1;
        var tilt = wind * ry * ry * 1.8;
        var fx = flameX + tilt;
        var w = 1.35 * Math.Sin(Math.Pow(ry, 0.85) * Math.PI * 0.95);
        w *= 0.90 + 0.15 * Math.Sin(t * 9.1 + y * 1.7);
        if (w < 0.25) continue;

        for (var x = (int)Math.Floor(fx - w - 0.3); x <= (int)Math.Ceiling(fx + w + 0.3); x++)
        {
            var dist = Math.Abs(x - fx);
            if (dist > w + 0.2) continue;
            var col = (dist < w * 0.32 && ry < 0.65 && ry > 0.08)
                ? new Color(1.0, 0.98, 0.78)
                : (dist < w * 0.78
                    ? new Color(1.0, 0.72, 0.18)
                    : new Color(0.96, 0.38, 0.08));
            ctx.SetPixel(x, y, col);
        }
    }

    // --- Candle column ---
    var cream = new Color(0.94, 0.90, 0.76);
    var creamShadow = new Color(0.72, 0.66, 0.50);
    ctx.DrawRectXyWh(cx - 1.5, candleTopY, 3, 5, colorFill: cream);
    for (var y = candleTopY; y <= 23; y++)
        ctx.SetPixel(13, y, creamShadow);

    // Wick
    ctx.SetPixel(12, candleTopY - 1, new Color(0.25, 0.18, 0.10));
};
