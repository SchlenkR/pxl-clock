                ctx.SetPixel(px, py, Color.FromRgb(0.35, 0.20, 0.12)); // dark wood bottom
        }
    }

    // Mast
    var mastX = (int)Math.Round(boatX + angle * -2.0);
    var mastTopY = (int)Math.Round(hullY - 6);
    var mastBotY = (int)Math.Round(hullY - 1);
    for (var y = mastTopY; y <= mastBotY; y++)
    {
        var mx = (int)Math.Round(boatX + angle * (y - hullY) * -0.5);
        if (mx >= 0 && mx < 24 && y >= 0 && y < 24)
            ctx.SetPixel(mx, y, Color.FromRgb(0.85, 0.70, 0.50));
    }

    // Sail — a triangular white sail to the right of the mast
    // Triangle vertices relative to mast base
    var mbx = boatX + angle * -0.5;
    var mby = hullY - 1;
    var mtx = boatX + angle * -3.0;
    var mty = hullY - 6;
    // third point (sail foot, right side)
    var sfx = boatX + 3 + angle * -0.5;
    var sfy = hullY - 1;

    // Rasterize triangle via scan
    for (var py = (int)Math.Floor(Math.Min(mty, Math.Min(mby, sfy))); py <= (int)Math.Ceiling(Math.Max(mty, Math.Max(mby, sfy))); py++)
    {
        for (var px = (int)Math.Floor(Math.Min(mtx, Math.Min(mbx, sfx))); px <= (int)Math.Ceiling(Math.Max(mtx, Math.Max(mbx, sfx))); px++)
        {
            if (px < 0 || px >= 24 || py < 0 || py >= 24) continue;
            // barycentric
            var x0 = mtx; var y0 = mty;
            var x1 = mbx; var y1 = mby;
            var x2 = sfx; var y2 = sfy;
            var denom = (y1 - y2) * (x0 - x2) + (x2 - x1) * (y0 - y2);
            if (Math.Abs(denom) < 1e-6) continue;
            var a = ((y1 - y2) * (px - x2) + (x2 - x1) * (py - y2)) / denom;
            var b = ((y2 - y0) * (px - x2) + (x0 - x2) * (py - y2)) / denom;
            var c = 1 - a - b;
            if (a >= -0.05 && b >= -0.05 && c >= -0.05)
            {
                // subtle shading — right edge slightly shadowed
                var shade = 0.92 + (c - a) * 0.05;
                var s = Math.Clamp(shade, 0.75, 1.0);
                ctx.SetPixel(px, py, Color.FromRgb(s, s, s));
            }
        }
    }

    // Small flag at mast top
    var flagX = mtx + 1;
    var flagPx = (int)Math.Round(flagX);
    var flagPy = (int)Math.Round(mty);
    if (flagPx >= 0 && flagPx < 24 && flagPy >= 0 && flagPy < 24)
        ctx.SetPixel(flagPx, flagPy, Color.FromRgb(0.95, 0.25, 0.25));

    // Time display — discreet, bottom center
    var timeStr = ctx.Now.ToString("HH:mm");
    var tw = ctx.MeasureTextVar3x5(timeStr);
    var tx = (24 - tw) / 2.0;
    // subtle dark backdrop for readability
    ctx.DrawRectXyWh(tx - 1, 19, tw + 2, 5, colorFill: Color.FromRgba(0, 0, 0, 0.35));
    ctx.DrawTextVar3x5(timeStr, tx, 19, color: Color.FromRgba(1.0, 1.0, 1.0, 0.85));
};
