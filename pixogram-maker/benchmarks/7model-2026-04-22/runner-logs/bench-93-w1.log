```csharp
// ---
// app: UnderwaterView
// displayName: Underwater View
// appType: ClockFace
// author: SchlenkR
// description: Underwater looking up at a drifting sailboat hull, caustic sun and light shafts
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var rand = new Random(17);
var bubbles = new List<(double x, double phase, double speed, double wob)>();
for (var i = 0; i < 7; i++)
{
    bubbles.Add((
        rand.NextDouble() * 24,
        rand.NextDouble(),
        0.07 + rand.NextDouble() * 0.06,
        0.4 + rand.NextDouble() * 0.8
    ));
}

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;

    // --- Base vertical gradient: pale cyan (top) -> deep blue (bottom)
    for (var y = 0; y < 24; y++)
    {
        var d = y / 23.0;
        var r = 0.68 * (1 - d) + 0.03 * d;
        var g = 0.90 * (1 - d) + 0.09 * d;
        var b = 0.96 * (1 - d) + 0.28 * d;
        var rowCol = Color.FromRgb(r, g, b);
        for (var x = 0; x < 24; x++)
            ctx.SetPixel(x, y, rowCol);
    }

    // --- Drifting light shafts (right-to-left, angled downward)
    for (var y = 2; y < 24; y++)
    {
        for (var x = 0; x < 24; x++)
        {
            var u = x + y * 0.35 + t * 2.2;
            var s = Math.Sin(u * 0.42) * 0.5 + 0.5;
            s = Math.Pow(s, 3.0);
            var fade = Math.Max(0.35, 1.0 - (y / 23.0) * 0.55);
            var k = s * fade * 0.45;
            if (k > 0.02)
            {
                var c = ctx.GetPixel(x, y);
                ctx.SetPixel(x, y, Color.FromRgb(
                    Math.Min(1.0, c.R + k * 0.95),
                    Math.Min(1.0, c.G + k * 0.98),
                    Math.Min(1.0, c.B + k * 0.70)));
            }
        }
    }

    // --- Wobbling caustic sun disc (seen through water ceiling)
    var sunCx = 7.0 + Math.Sin(t * 0.8) * 0.6;
    var sunCy = 4.0 + Math.Sin(t * 1.1) * 0.5;
    for (var dy = -4; dy <= 4; dy++)
    {
        for (var dx = -4; dx <= 4; dx++)
        {
            var dist = Math.Sqrt(dx * dx + dy * dy);
            var wob = Math.Sin(t * 2.6 + dx * 0.7 + dy * 0.6) * 0.5;
            var rad = 2.8 + wob;
            if (dist < rad)
            {
                var falloff = Math.Max(0.0, 1.0 - dist / rad);
                var caustic = 0.45 + 0.55 * Math.Sin(t * 3.8 + dx * 1.3 + dy * 1.1);
                var k = falloff * (0.55 + caustic * 0.5);
                var px = (int)Math.Round(sunCx + dx);
                var py = (int)Math.Round(sunCy + dy);
                if (px >= 0 && px < 24 && py >= 0 && py < 24)
                {
                    var c = ctx.GetPixel(px, py);
                    ctx.SetPixel(px, py, Color.FromRgb(
                        Math.Min(1.0, c.R + k * 0.95),
                        Math.Min(1.0, c.G + k * 0.88),
                        Math.Min(1.0, c.B + k * 0.55)));
                }
            }
        }
    }

    // --- Rippled surface undersides (top three rows, drifting right-to-left)
    for (var x = 0; x < 24; x++)
    {
        // nearest pale-cyan crests
        var w1 = Math.Sin((x * 0.75 + t * 3.8)) * 0.55 + Math.Sin(x * 1.4 + t * 2.1) * 0.25;
        var y1 = (int)Math.Round(0.6 + w1);
        if (y1 >= 0 && y1 < 24)
        {
            var c = ctx.GetPixel(x, y1);
            ctx.SetPixel(x, y1, Color.FromRgb(
                Math.Min(1.0, c.R * 0.4 + 0.75),
                Math.Min(1.0, c.G * 0.4 + 0.95),
                Math.Min(1.0, c.B * 0.4 + 1.0)));
        }
        // mid ripple band
        var w2 = Math.Sin(x * 0.5 + t * 2.6 + 1.2) * 0.7;
        var y2 = (int)Math.Round(2.4 + w2);
        if (y2 >= 0 && y2 < 24)
        {
            var c = ctx.GetPixel(x, y2);
            ctx.SetPixel(x, y2, Color.FromRgb(
                c.R * 0.5 + 0.28,
                c.G * 0.5 + 0.55,
                c.B * 0.5 + 0.75));
        }
    }

    // --- Sailboat hull dipping from surface, drifting right-to-left
    var    [anthropic] Unknown event: ping
 boatCycle = 18.0;
    var boatPhase = (t % boatCycle) / boatCycle;
    var boatX = 28.0 - boatPhase * 34.0; // right -> left
    var swell = Math.Sin(t * 1.3) * 0.6;
    var tilt = Math.Sin(t * 1.3 + 0.4) * 0.35;
    var hullCol = Color.FromRgb(0.03, 0.05, 0.12);

    // hull body: rows 1..6, wider at top, tapering
    for (var dy = 0; dy <= 5; dy++)
    {
        var depth = dy / 5.0;
        var halfW = 3.0 * (1.0 - depth * 0.85);
        var yy = 1.2 + dy + swell;
        var tiltOff = (dy - 2.5) * tilt;
        for (var dx = -4; dx <= 4; dx++)
        {
            if (Math.Abs(dx) <= halfW + 0.2)
            {
                var px = (int)Math.Round(boatX + dx + tiltOff);
                var py = (int)Math.Round(yy);
                if (px >= 0 && px < 24 && py >= 0 && py < 24)
                    ctx.SetPixel(px, py, hullCol);
            }
        }
    }
    // keel: narrow fin extending deeper
    for (var dy = 6; dy <= 8; dy++)
    {
        var yy = 1.2 + dy + swell;
        var tiltOff = (dy - 2.5) * tilt;
        var px = (int)Math.Round(boatX + tiltOff);
        var py = (int)Math.Round(yy);
        if (px >= 0 && px < 24 && py >= 0 && py < 24)
            ctx.SetPixel(px, py, hullCol);
        // slight widening near top of keel
        if (dy == 6)
        {
            var px2 = (int)Math.Round(boatX + tiltOff + 1);
            if (px2 >= 0 && px2 < 24 && py >= 0 && py < 24)
                ctx.SetPixel(px2, py, hullCol);
        }
    }

    // --- Lazy rising bubbles
    foreach (var b in bubbles)
    {
        var p = (t * b.speed + b.phase) % 1.0;
        var by = 23.0 - p * 21.0;
        var bx = b.x + Math.Sin(t * 1.4 + b.phase * 6.28) * b.wob;
        var px = (int)Math.Round(bx);
        var py = (int)Math.Round(by);
        if (px >= 0 && px < 24 && py >= 3 && py < 24)
        {
            var c = ctx.GetPixel(px, py);
            ctx.SetPixel(px, py, Color.FromRgb(
                Math.Min(1.0, c.R * 0.4 + 0.55),
                Math.Min(1.0, c.G * 0.4 + 0.65),
                Math.Min(1.0, c.B * 0.4 + 0.65)));
        }
    }

    // --- Time on seafloor, cream, half-lit by passing shaft
    var timeStr = ctx.Now.ToString("HH:mm");
    var ty = 19;
    var tx = 3;
    for (var i = 0; i < timeStr.Length; i++)
    {
        var cx = tx + i * 4 + 1.5;
        var u = cx + ty * 0.35 + t * 2.2;
        var s = Math.Pow(Math.Sin(u * 0.42) * 0.5 + 0.5, 3.0);
        var lit = 0.45 + s * 0.55;
        var col = Color.FromRgb(
            0.35 * lit + 0.18,
            0.32 * lit + 0.16,
            0.22 * lit + 0.10);
        ctx.DrawTextMono4x5(timeStr[i].ToString(), tx + i * 4, ty, col);
    }
};
