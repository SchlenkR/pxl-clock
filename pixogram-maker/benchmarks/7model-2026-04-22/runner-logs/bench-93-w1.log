Looking at the visionary's direction, I need to build out:

1. **Warm peach-cream sky** (not blue) as background for upper area
2. **Yellow sun** upper-left with 2-3 soft rays
3. **Three wave layers** — darkest blue at bottom, mid-blue middle, pale cyan crests — sliding right-to-left with ~4 second full cycle
4. **Plump white sailboat** center with triangular sail, tilting gently side-to-side in sync with wave slope passing beneath
5. **Muted cream time** tucked at very bottom in the dark wave trough

**Key implementation decisions:**
- Wave motion: `y = base + A*sin(k*x + phase)` with `phase = 2π·t/4` — peaks move leftward as phase increases ✓
- Three wave bands layered back-to-front, each slightly phase-shifted for depth
- Boat tilt: compute slope of top wave at boat's x-position via finite difference, rotate boat layer around hull pivot
- Boat shape: 5-wide deck + 3-wide lower hull (plump), 6-tall mast, right-facing triangular sail that widens from 1 to 5 pixels
- Time in `Mono3x5` cream at y=19 — sits in the dark-blue water zone along the bottom rows

```csharp
// ---
// app: Segelboot
// displayName: Segelboot auf Wellen
// appType: ClockFace
// author: SchlenkR
// description: A plump white sailboat drifts on three layers of waves on a warm summer afternoon
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;
    var phase = t * 2.0 * Math.PI / 4.0;

    // Warm peach-cream sky
    ctx.DrawBackground(Color.FromRgbByte(255, 218, 185));

    // Sun upper-left with soft rays
    var sunBright = Color.FromRgbByte(255, 230, 110);
    var sunCore = Color.FromRgbByte(255, 248, 195);
    ctx.DrawCircle(3, 3, 2, colorFill: sunBright, isAntialias: false);
    ctx.DrawPoint(3, 3, color: sunCore);
    ctx.DrawPoint(3, 7, color: sunBright);
    ctx.DrawPoint(7, 3, color: sunBright);
    ctx.DrawPoint(6, 6, color: sunBright);

    // Wave colors
    var paleCyan = Color.FromRgbByte(175, 225, 240);
    var midBlue = Color.FromRgbByte(55, 130, 200);
    var darkBlue = Color.FromRgbByte(18, 48, 105);

    // Wave shape functions — peaks drift right-to-left as phase grows
    var wave3 = (double x) => 13.5 + 1.3 * Math.Sin(x * 0.55 + phase);
    var wave2 = (double x) => 17.0 + 1.0 * Math.Sin(x * 0.55 + phase - 0.7);
    var wave1 = (double x) => 20.5 + 0.8 * Math.Sin(x * 0.55 + phase - 1.4);

    for (var x = 0; x < 24; x++)
    {
        var w3 = wave3(x);
        var w2 = wave2(x);
        var w1 = wave1(x);
        for (var y = 0; y < 24; y++)
        {
            if (y >= w1) ctx.SetPixel(x, y, darkBlue);
            else if (y >= w2) ctx.SetPixel(x, y, midBlue);
            else if (y >= w3) ctx.SetPixel(x, y, paleCyan);
        }
    }

    // Boat — drawn in its own layer so we can rotate with the wave's slope
    var boatX = 12.0;
    var waterY = wave3(boatX);
    var slope = wave3(boatX + 1.5) - wave3(boatX - 1.5);
    var tiltDeg = slope * 6.0;

    var boat = ctx.NewLayer(clearColor: Colors.TransparentBlack);
    var white = Colors.White;
    var deck = Color.FromRgbByte(235, 235, 235);

    var hy = waterY - 0.3;

    // Plump hull: 5-wide deck, 3-wide lower hull
    boat.DrawLine(boatX - 2, hy - 1, boatX + 2, hy - 1, color: white, isAntialias: false);
    boat.DrawLine(boatX - 1, hy, boatX + 1, hy, color: deck, isAntialias: false);

    // Mast
    boat.DrawLine(boatX, hy - 7, boatX, hy - 2, color: white, isAntialias: false);

    // Triangular sail to the right of the mast (grows from 1 to 5 wide)
    for (var i = 1; i <= 5; i++)
        boat.DrawLine(boatX + 1, hy - 8 + i, boatX + i, hy - 8 + i, color: white, isAntialias: false);

    boat.Rotate(tiltDeg, boatX, hy);
    boat.Apply(BlendMode.SourceOver);

    // Time — muted cream tucked into the dark water at the very bottom
    var cream = Color.FromRgbByte(240, 228, 195);
    var timeStr = ctx.Now.ToString("HH:mm");
    var tw = ctx.MeasureTextMono3x5(timeStr);
    ctx.DrawTextMono3x5(timeStr, (24 - tw) / 2.0, 19, cream);
};
