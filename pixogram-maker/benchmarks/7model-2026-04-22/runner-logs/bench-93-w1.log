            var g = 0.30 - depth * 0.15 + shimmer;
            var b = 0.65 - depth * 0.25 + shimmer;
            ctx.SetPixel(x, y, Color.FromRgb(
                Math.Clamp(r, 0, 1),
                Math.Clamp(g, 0, 1),
                Math.Clamp(b, 0, 1)));
        }
    }

    // Wave crests (lighter highlight on top row of ocean)
    for (var x = 0; x < 24; x++)
