Looking at the maintainer's feedback: they want the motion to feel more organic and natural, less mechanical/predictable. The underwater scene concept from iteration 3 should stay, but every animated element needs irregular, non-periodic motion — I'll layer multiple sines at different incommensurate frequencies, pre-randomize per-element properties, and add asymmetric drift.

**Plan for organic motion:**
1. **Surface waves** — combine 3 sines at different spatial & temporal frequencies (not one clean sine)
2. **Boat rocking** — stack 3 tilt sines + 2 bob sines so the rhythm never repeats visibly
3. **Bubbles** — each gets its own pre-randomized speed, wobble amplitude/frequency, phase, size, lifetime → no two behave alike
4. **Light shafts** — add per-shaft flicker, drift, and y-wobble that sway independently
5. **Sun disc** — caustic edge noise from two interfering sines, plus wobbling position
6. **Seafloor** — uneven silt line
7. **Time text** — lit per-character by the passing light shaft, so brightness ripples organically across digits

Using `var` everywhere, no `float`, multi-harmonic phase offsets to avoid detectable periodicity.

```csharp
// ---
// app: UnderwaterBoat
// displayName: Underwater Boat
// appType: ClockFace
// author: Claude
// description: View from beneath the waves looking up at a drifting sailing boat
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var rnd = new Random(1337);

var bubbleCount = 11;
var bubbles = new (double phase, double speed, double xBase, double xAmp, double xFreq, double xFreq2, double size, double life)[bubbleCount];
for (var i = 0; i < bubbleCount; i++)
{
    bubbles[i] = (
        rnd.NextDouble() * 12.0,
        0.55 + rnd.NextDouble() * 1.3,
        1.0 + rnd.NextDouble() * 22.0,
        0.4 + rnd.NextDouble() * 1.6,
        0.5 + rnd.NextDouble() * 1.4,
        0.25 + rnd.NextDouble() * 0.9,
        rnd.NextDouble() < 0.3 ? 1.2 : 0.6,
        4.0 + rnd.NextDouble() * 4.5
    );
}

var shaftCount = 4;
var shafts = new (double xBase, double drift, double driftFreq, double tilt, double flickerFreq, double flickerPhase, double widthBase, double widthMod)[shaftCount];
for (var i = 0; i < shaftCount; i++)
{
    shafts[i] = (
        2.0 + rnd.NextDouble() * 22.0,
        1.5 + rnd.NextDouble() * 2.5,
        0.18 + rnd.NextDouble() * 0.35,
        0.35 + rnd.NextDouble() * 0.35,
        1.5 + rnd.NextDouble() * 2.0,
        rnd.NextDouble() * 6.28,
        0.9 + rnd.NextDouble() * 0.6,
        0.2 + rnd.NextDouble() * 0.4
    );
}

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;

    // --- deep water gradient (top = lighter near surface, bottom = near-black abyss) ---
    for (var y = 0; y < 24; y++)
    {
        var depth = y / 23.0;
        var r = 0.02 + (1 - depth) * 0.14;
        var g = 0.14 + (1 - depth) * 0.42;
        var b = 0.24 + (1 - depth) * 0.52;
        var row = Color.FromRgb(r, g, b);
        for (var x = 0; x < 24; x++)
            ctx.SetPixel(x, y, row);
    }

    // --- organic multi-harmonic wave surface ---
    var surfaceY = (double x) =>
    {
        var w1 = Math.Sin(x * 0.55 + t * 0.8) * 0.9;
        var w2 = Math.Sin(x * 1.1 - t * 1.27 + 1.2) * 0.45;
        var w3 = Math.Sin(x * 0.27 + t * 0.41 + 0.7) * 0.6;
        var w4 = Math.Sin(x * 1.83 + t * 0.63 + 2.1) * 0.22;
        return 2.9 + w1 + w2 + w3 + w4;
    };

    // --- sun disc through surface, wobbling & caustic-fractured ---
    var sunCx = 17.6 + Math.Sin(t * 0.33) * 0.7 + Math.Sin(t * 0.81 + 1.2) * 0.3;
    var sunCy = 1.3 + Math.Sin(t * 0.62 + 0.4) * 0.4;
    for (var y = 0; y < 8; y++)
    {
        for (var x = 9; x < 24; x++)
        {
            var dx = x - sunCx;
            var dy = (y - sunCy) * 1.25;
            var d = Math.Sqrt(dx * dx + dy * dy);
            var caustic =
                Math.Sin(d * 1.7 - t * 2.8) * 0.35 +
                Math.Sin(dx * 1.9 + t * 1.7) * 0.25 +
                Math.Sin(dy * 2.4 - t * 2.1 + 0.7) * 0.18;
            var radius = 3.6 + caustic;
            if (d < radius)
            {
                var intensity = Math.Pow(Math.Max(0, 1 - d / radius), 0.7);
                var cur = ctx.GetPixel(x, y);
                ctx.SetPixel(x, y, Color.FromRgb(
                    Math.Min(1, cur.R + intensity * 0.95),
                    Math.Min(1, cur.G + intensity * 0.82),
                    Math.Min(1, cur.B + intensity * 0.38)));
            }
        }
    }

    // --- diagonal god-rays with per-shaft irregular flicker & drift ---
    for (var s = 0; s < shaftCount; s++)
    {
        var sh = shafts[s];
        var xDrift = Math.Sin(t * sh.driftFreq + sh.flickerPhase) * sh.drift
                   + Math.Sin(t * sh.driftFreq * 0.43 + 1.7) * sh.drift * 0.5;
        var widthNow = sh.widthBase + Math.Sin(t * 0.9 + sh.flickerPhase) * sh.widthMod;
        for (var y = 1; y < 24; y++)
        {
            var curveX = sh.xBase + xDrift - (y - 2) * s    [anthropic] Unknown event: ping
h.tilt;
            curveX += Math.Sin(y * 0.38 + t * 1.1 + sh.flickerPhase) * 0.35;
            var flicker = 0.55
                + Math.Sin(t * sh.flickerFreq + sh.flickerPhase + y * 0.12) * 0.25
                + Math.Sin(t * sh.flickerFreq * 2.3 + sh.flickerPhase) * 0.15;
            var depthFade = 1.0 - y / 30.0;
            for (var px = (int)(curveX - widthNow - 1); px <= (int)(curveX + widthNow + 1); px++)
            {
                if (px < 0 || px >= 24) continue;
                var dist = Math.Abs(px + 0.5 - curveX);
                if (dist > widthNow) continue;
                var alpha = (1 - dist / widthNow) * flicker * depthFade * 0.28;
                if (alpha < 0.02) continue;
                var cur = ctx.GetPixel(px, y);
                ctx.SetPixel(px, y, Color.FromRgb(
                    Math.Min(1, cur.R + alpha * 0.75),
                    Math.Min(1, cur.G + alpha * 0.85),
                    Math.Min(1, cur.B + alpha * 0.55)));
            }
        }
    }

    // --- pale cyan water-surface "ceiling" with soft antialiased edge ---
    for (var x = 0; x < 24; x++)
    {
        var sy = surfaceY(x);
        var iy = (int)sy;
        var frac = sy - iy;
        var bright = Color.FromRgb(0.55, 0.85, 0.95);
        if (iy >= 0 && iy < 24)
        {
            var cur = ctx.GetPixel(x, iy);
            var mix = 1 - frac;
            ctx.SetPixel(x, iy, Color.FromRgb(
                cur.R * (1 - mix * 0.85) + bright.R * mix * 0.85,
                cur.G * (1 - mix * 0.85) + bright.G * mix * 0.85,
                cur.B * (1 - mix * 0.85) + bright.B * mix * 0.85));
        }
        if (iy + 1 >= 0 && iy + 1 < 24)
        {
            var cur2 = ctx.GetPixel(x, iy + 1);
            var mix2 = frac * 0.4;
            ctx.SetPixel(x, iy + 1, Color.FromRgb(
                cur2.R * (1 - mix2) + bright.R * mix2,
                cur2.G * (1 - mix2) + bright.G * mix2,
                cur2.B * (1 - mix2) + bright.B * mix2));
        }
    }

    // --- boat silhouette: drifts right-to-left with irregular rocking ---
    var boatX = 22.0 - ((t * 0.85) % 30.0);
    var tilt = Math.Sin(t * 1.05) * 0.32
             + Math.Sin(t * 0.47 + 1.3) * 0.17
             + Math.Sin(t * 2.31 + 0.9) * 0.07;
    var boatBob = Math.Sin(t * 0.88 + 0.4) * 0.35
                + Math.Sin(t * 1.69 + 1.1) * 0.12;
    var boatSurfY = surfaceY(boatX) + boatBob;
    var hullColor = Color.FromRgb(0.03, 0.05, 0.10);

    for (var dx = -3; dx <= 3; dx++)
    {
        var hullDepth = 2 - Math.Abs(dx) * 0.45;
        if (hullDepth <= 0) continue;
        for (var dy = 0; dy < (int)Math.Ceiling(hullDepth); dy++)
        {
            var px = boatX + dx + tilt * dy * 0.35;
            var py = boatSurfY + dy - tilt * dx * 0.22;
            var ix = (int)Math.Round(px);
            var iy = (int)Math.Round(py);
            if (ix >= 0 && ix < 24 && iy >= 0 && iy < 24)
                ctx.SetPixel(ix, iy, hullColor);
        }
    }
    // keel dipping below hull
    var keelX = boatX + tilt * 2.8;
    var keelTopY = boatSurfY + 1.6;
    for (var dy = 0; dy < 3; dy++)
    {
        var px = keelX - tilt * dy * 0.3;
        var py = keelTopY + dy;
        var ix = (int)Math.Round(px);
        var iy = (int)Math.Round(py);
        if (ix >= 0 && ix < 24 && iy >= 0 && iy < 24)
            ctx.SetPixel(ix, iy, hullColor);
    }

    // --- bubbles: each with individual speed, wobble pattern, and lifecycle ---
    for (var i = 0; i < bubbleCount; i++)
    {
        var b = bubbles[i];
        var progress = ((t + b.phase) * b.speed / b.life) % 1.0;
        var by = 23.5 - progress * 22.5;
        var wobble =
            Math.Sin((t + b.phase) * b.xFreq * 2.1) * b.xAmp +
            Math.Sin((t + b.phase) * b.xFreq2 * 1.3 + 1.1) * b.xAmp * 0.55 +
            Math.Sin((t + b.phase) * 0.7 + i) * 0.25;
        var bx = b.xBase + wobble;
        var alpha = Math.Sin(progress * Math.PI);
        if (alpha < 0.06) continue;
        var ix = (int)Math.Round(bx);
        var iy = (int)Math.Round(by);
        if (ix < 0 || ix >= 24 || iy < 0 || iy >= 24) continue;
        var cur = ctx.GetPixel(ix, iy);
        ctx.SetPixel(ix, iy, Color.FromRgb(
            Math.Min(1, cur.R + alpha * 0.38),
            Math.Min(1, cur.G + alpha * 0.52),
            Math.Min(1, cur.B + alpha * 0.58)));
        if (b.size > 1.0 && iy - 1 >= 0)
        {
            var cur2 = ctx.GetPixel(ix, iy - 1);
            ctx.SetPixel(ix, iy - 1, Color.FromRgb(
                Math.Min(1, cur2.R + alpha * 0.22),
                Math.Min(1, cur2.G + alpha * 0.32),
                Math.Min(1, cur2.B + alpha * 0.38)));
        }
    }

    // --- irregular silted seafloor band ---
    for (var x = 0; x < 24; x++)
    {
        var floorN = Math.Sin(x * 0.33 + t * 0.18) * 0.6
                   + Math.Sin(x * 0.81 - t * 0.27 + 1.2) * 0.35;
        var floorY = 23 - (int)Math.Max(0, floorN + 0.5);
        if (floorY < 0 || floorY >= 24) continue;
        var cur = ctx.GetPixel(x, floorY);
        ctx.SetPixel(x, floorY, Color.FromRgb(
            cur.R * 0.4 + 0.05,
            cur.G * 0.4 + 0.04,
            cur.B * 0.4 + 0.06));
    }

    // --- time display: muted cream, swept by a passing light shaft ---
    var shaftX = 12.0 + Math.Sin(t * 0.42) * 7.0 + Math.Sin(t * 0.19 + 1.3) * 2.0;
    var timeStr = ctx.Now.ToString("HH:mm");
    var timeY = 18;
    var timeX = 5;
    var charW = 4;
    var baseCream = Color.FromRgb(0.32, 0.27, 0.18);
    for (var i = 0; i < timeStr.Length; i++)
    {
        var cx = timeX + i * charW;
        var distToShaft = Math.Abs(cx + 1.5 - shaftX);
        var lit = Math.Pow(Math.Max(0, 1 - distToShaft / 7.5), 1.6);
        var col = Color.FromRgb(
            Math.Min(1, baseCream.R + lit * 0.55),
            Math.Min(1, baseCream.G + lit * 0.48),
            Math.Min(1, baseCream.B + lit * 0.28));
        ctx.DrawTextMono3x5(timeStr[i].ToString(), cx, timeY, col);
    }
};
