// ---
// app: VulkanAusbruch
// displayName: Vulkan Ausbruch
// appType: Scene
// author: Claude
// description: Volcano eruption with glowing sparks cooling from white-yellow to deep red
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var rng = new Random(42);
var n = 80;
var px   = new double[80];
var py   = new double[80];
var pvx  = new double[80];
var pvy  = new double[80];
var page = new double[80];
var plif = new double[80];
var actv = new bool[80];
var lastT   = 0.0;
var spawnT  = 0.0;

var scene = (DrawingContext ctx) =>
{
    var t  = ctx.Elapsed.TotalSeconds;
    var dt = t - lastT;
    if (dt > 0.08) dt = 0.08;
    lastT = t;

    // Update particles
    for (var i = 0; i < n; i++)
    {
        if (!actv[i]) continue;
        page[i] += dt;
        if (page[i] >= plif[i]) { actv[i] = false; continue; }
        pvy[i] += 11.0 * dt;   // gravity
        px[i]  += pvx[i] * dt;
        py[i]  += pvy[i] * dt;
    }

    // Spawn sparks
    spawnT += dt;
    var rate = 0.038;
    while (spawnT >= rate)
    {
        spawnT -= rate;
        for (var i = 0; i < n; i++)
        {
            if (actv[i]) continue;
            actv[i] = true;
            px[i]   = 12.0 + (rng.NextDouble() - 0.5) * 2.0;
            py[i]   = 10.5;
            var ang  = -Math.PI / 2.0 + (rng.NextDouble() - 0.5) * 1.1;
            var spd  = 7.0 + rng.NextDouble() * 11.0;
            pvx[i]  = Math.Cos(ang) * spd;
            pvy[i]  = Math.Sin(ang) * spd;
            plif[i] = 0.9 + rng.NextDouble() * 0.9;
            page[i] = 0.0;
            break;
        }
    }

    // Background — night sky
    ctx.DrawBackground(new Color(0.01, 0.01, 0.04));

    // Stars
    ctx.SetPixel(2,  1, new Color(0.6, 0.6, 0.7));
    ctx.SetPixel(7,  2, new Color(0.8, 0.8, 0.9));
    ctx.SetPixel(14, 1, new Color(0.5, 0.5, 0.65));
    ctx.SetPixel(19, 3, new Color(0.7, 0.7, 0.8));
    ctx.SetPixel(22, 1, new Color(0.5, 0.5, 0.6));
    ctx.SetPixel(1,  5, new Color(0.4, 0.4, 0.55));
    ctx.SetPixel(21, 7, new Color(0.45, 0.45, 0.55));
    ctx.SetPixel(5,  8, new Color(0.35, 0.35, 0.45));

    // Volcano body — filled triangle, tip at (12,10), base rows 10..23
    for (var row = 10; row <= 23; row++)
    {
        var prog    = (row - 10.0) / 13.0;       // 0=tip, 1=base
        var hw      = 1.0 + prog * 9.5;
        var x1      = (int)Math.Floor(12.0 - hw);
        var x2      = (int)Math.Ceiling(12.0 + hw);
        for (var col = x1; col <= x2; col++)
        {
            if (col < 0 || col > 23) continue;
            var shade = 0.12 + prog * 0.08;
            // slight lava-glow warmth near crater
            var glow  = Math.Max(0.0, 1.0 - prog * 3.0) * 0.25;
            ctx.SetPixel(col, row, new Color(shade * 1.3 + glow, shade * 0.55, shade * 0.35));
        }
    }

    // Crater lip glow
    ctx.SetPixel(10, 10, new Color(0.9, 0.35, 0.0));
    ctx.SetPixel(11, 10, new Color(1.0, 0.6,  0.05));
    ctx.SetPixel(12, 10, new Color(1.0, 0.75, 0.1));
    ctx.SetPixel(13, 10, new Color(1.0, 0.6,  0.05));
    ctx.SetPixel(14, 10, new Color(0.9, 0.35, 0.0));

    // Draw sparks
    for (var i = 0; i < n; i++)
    {
        if (!actv[i]) continue;
        var na = page[i] / plif[i];   // 0=fresh, 1=dying
        Color    [anthropic] Unknown event: ping
 c;
        if (na < 0.15)
        {
            var s = na / 0.15;
            c = new Color(1.0, 1.0, 1.0 - s * 0.95);
        }
        else if (na < 0.4)
        {
            var s = (na - 0.15) / 0.25;
            c = new Color(1.0, 1.0 - s * 0.45, 0.05 - s * 0.05);
        }
        else if (na < 0.7)
        {
            var s = (na - 0.4) / 0.3;
            c = new Color(1.0, 0.55 - s * 0.55, 0.0);
        }
        else
        {
            var s = (na - 0.7) / 0.3;
            c = new Color(1.0 - s * 0.6, 0.0, 0.0);
        }
        var ix = (int)Math.Round(px[i]);
        var iy = (int)Math.Round(py[i]);
        if (ix >= 0 && ix < 24 && iy >= 0 && iy < 24)
            ctx.SetPixel(ix, iy, c);
    }
