    if (cycleT >= calmDuration - 0.6)
        glow = Math.Min(1.0, glow + 0.35);
    ctx.DrawCircle(12, 15.5, 2.8, colorFill: new Color(glow * 0.65, glow * 0.18, 0.0));
    ctx.DrawCircle(12, 15.5, 1.8, colorFill: new Color(glow, glow * 0.42, 0.0));
    ctx.DrawCircle(12, 15.5, 0.9, colorFill: new Color(1.0, glow * 0.85, glow * 0.25));

    // Time — cool dim blue-white, starlight feel
    var now = ctx.Now;
    var timeStr = now.ToString("HH:mm");
    var tw = ctx.MeasureTextMono4x5(timeStr);
    ctx.DrawTextMono4x5(timeStr, (int)((24.0 - tw) / 2.0), 1, new Color(0.35, 0.45, 0.65));
};
