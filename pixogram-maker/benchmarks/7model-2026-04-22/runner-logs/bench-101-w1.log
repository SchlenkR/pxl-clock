// ---
// app: VulkanausbruchFunken
// displayName: Vulkan mit Funkenflug
// appType: ClockFace
// author: claude-sonnet-4-6
// description: Kleiner Vulkan mit regelmäßigem Funkenflug und    [anthropic] Unknown event: ping
 Zeitanzeige
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var sparks = new List<(double x, double y, double vx, double vy, double age, double maxAge)>();
var lastBurstCycle = -1L;
var rng = new Random(123);
var cycleDuration = 5.0;
var calmDuration = 3.0;

var scene = (DrawingContext ctx) =>
{
    ctx.DrawBackground(new Color(0.01, 0.01, 0.04));

    var t = ctx.Elapsed.TotalSeconds;
    var dt = 1.0 / ctx.Fps;
    var cycleNo = (long)(t / cycleDuration);
    var cycleT = t % cycleDuration;

    // Spawn sparks once per cycle at burst time
    if (cycleT >= calmDuration && cycleNo != lastBurstCycle)
    {
        var numSparks = rng.Next(8, 13);
        for (var i = 0; i < numSparks; i++)
        {
            var angle = -Math.PI / 2.0 + (rng.NextDouble() - 0.5) * Math.PI * 0.75;
            var speed = 6.0 + rng.NextDouble() * 7.0;
            sparks.Add((
                12.0 + (rng.NextDouble() - 0.5) * 2.0,
                15.0,
                Math.Cos(angle) * speed,
                Math.Sin(angle) * speed,
                0.0,
                1.5 + rng.NextDouble() * 1.2
            ));
        }
        lastBurstCycle = cycleNo;
    }

    // Update sparks — apply gravity, age, remove old/out-of-bounds
    for (var i = sparks.Count - 1; i >= 0; i--)
    {
        var s = sparks[i];
        var newAge = s.age + dt;
        if (newAge >= s.maxAge || s.y > 23.0)
        {
            sparks.RemoveAt(i);
        }
        else
        {
            var newVy = s.vy + 5.0 * dt;
            sparks[i] = (s.x + s.vx * dt, s.y + newVy * dt, s.vx, newVy, newAge, s.maxAge);
        }
    }

    // Subtle fixed stars
    ctx.SetPixel(3, 2, new Color(0.25, 0.25, 0.35));
    ctx.SetPixel(19, 3, new Color(0.2, 0.2, 0.3));
    ctx.SetPixel(8, 7, new Color(0.22, 0.22, 0.32));
    ctx.SetPixel(21, 5, new Color(0.25, 0.25, 0.35));
    ctx.SetPixel(1, 10, new Color(0.2, 0.2, 0.3));
    ctx.SetPixel(22, 12, new Color(0.2, 0.2, 0.28));
    ctx.SetPixel(5, 13, new Color(0.18, 0.18, 0.27));

    // Draw sparks with color transition
    foreach (var s in sparks)
    {
        if (s.x < 0 || s.x >= 24 || s.y < 0 || s.y >= 24) continue;
        var progress = s.age / s.maxAge;
        Color sparkColor;
        if (progress < 0.25)
        {
            var p = progress / 0.25;
            sparkColor = new Color(1.0, 1.0 - p * 0.08, 1.0 - p * 0.9);
        }
        else if (progress < 0.55)
        {
            var p = (progress - 0.25) / 0.3;
            sparkColor = new Color(1.0, 0.92 - p * 0.52, 0.1 - p * 0.1);
        }
        else if (progress < 0.8)
        {
            var p = (progress - 0.55) / 0.25;
            sparkColor = new Color(1.0 - p * 0.35, 0.4 - p * 0.4, 0.0);
        }
        else
        {
            var p = (progress - 0.8) / 0.2;
            sparkColor = new Color(0.65 - p * 0.65, 0.0, 0.0).WithAlpha(1.0 - p);
        }
        ctx.DrawPoint(s.x, s.y, sparkColor, strokeWidth: 1.5);
    }

    // Draw volcano silhouette — per-row fill, narrows toward crater
    for (var row = 15; row < 24; row++)
    {
        var frac = (row - 15.0) / 8.0;
        var halfW = 2.5 + frac * 9.5;
        var x1 = (int)Math.Round(12.0 - halfW);
        var x2 = (int)Math.Round(12.0 + halfW);
        for (var col = Math.Max(0, x1); col <= Math.Min(23, x2); col++)
            ctx.SetPixel(col, row, new Color(0.1, 0.06, 0.03));
    }

    // Pulsing glowing crater throat
