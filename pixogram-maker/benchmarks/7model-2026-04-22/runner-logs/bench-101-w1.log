```csharp
// ---
// app: CometSparks
// displayName: Comet Sparks
// appType: ClockFace
// author: Pixogram Maker
// description: A comet crosses the upper frame, shedding falling sparks that smolder crimson at the bottom. Clock digits glow in the afterglow.
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var sparks = new List<(double x, double y, double vx, double vy, double startY)>();
var smolder = new double[24];
var rng = new Random(42);

var scene = (DrawingContext ctx) =>
{
    var dt = 1.0 / ctx.Fps;
    var t = ctx.Elapsed.TotalSeconds;

    // Comet: 2s crossing, 2s gap, repeat
    var phase = t % 4.0;
    var cometActive = phase < 2.0;
    var cometX = phase / 2.0 * 26.0 - 1.0;
    var cometY = 5.0;

    // Shed sparks along comet path
    if (cometActive && cometX >= -0.5 && cometX < 24.5 && sparks.Count < 90)
    {
        if (rng.NextDouble() < 0.65)
        {
            sparks.Add((
                cometX + (rng.NextDouble() - 0.5),
                cometY + rng.NextDouble() * 0.5,
                (rng.NextDouble() - 0.5) * 3.5,
                rng.NextDouble() * 1.2,
                cometY
            ));
        }
    }

    // Update sparks with gravity
    for (var i = sparks.Count - 1; i >= 0; i--)
    {
        var s = sparks[i];
        var newVy = s.vy + 15.0 * dt;
        var newX = s.x + s.vx * dt;
        var newY = s.y + newVy * dt;

        if (newY >= 22.0 || newX < 0.0 || newX >= 24.0)
        {
            var xi = (int)Math.Clamp(newX, 0, 23);
            smolder[xi] = Math.Min(1.0, smolder[xi] + 0.38);
            sparks.RemoveAt(i);
        }
        else
        {
            sparks[i] = (newX, newY, s.vx, newVy, s.startY);
        }
    }

    // Slowly fade smolder (0.003/frame ≈ full fade in ~8s)
    for (var i = 0; i < 24; i++)
        smolder[i] = Math.Max(0.0, smolder[i] - 0.003);

    // --- Draw ---
    ctx.DrawBackground(Colors.Black);

    // Smolder glow — brightest at floor (y=23), fading upward
    for (var x = 0; x < 24; x++)
    {
        var sm = smolder[x];
        if (sm < 0.01) continue;
        for (var y = 19; y < 24; y++)
        {
            var fromBottom = (23.0 - y) / 4.0; // 0 at y=23, 1 at y=19
            var intensity = sm * (1.0 - fromBottom * 0.72);
            ctx.SetPixel(x, y, Color.FromRgb(intensity * 0.62, intensity * 0.04, 0.0));
        }
    }

    // Clock in low red afterglow
    var now = ctx.Now;
    ctx.DrawTextMono4x5(now.ToString("HH:mm"), 2, 17, Color.FromRgb(0.68, 0.10, 0.03));

    // Sparks — cool from orange-white (born) to deep red (near floor)
    foreach (var s in sparks)
    {
        var lifeT = Math.Clamp((s.y - s.startY) / (22.0 - s.startY), 0.0, 1.0);
        Color col;
        if (lifeT < 0.3)
        {
            var g = Math.Max(0.0, 0.88 - lifeT * 1.6);
            var b = Math.Max(0.0, 0.55 - lifeT * 1.5);
            col = Color.FromRgb(1.0, g, b);
        }
        else
        {
            var fade = (lifeT - 0.3) / 0.7;
            var r = 1.0 - fade * 0.42;
            var g = Math.Max(0.0, 0.35 - fade * 0.35);
            col = Color.FromRgb(r, g, 0.0);
        }
        var px = (int)Math.Clamp(s.x, 0, 23);
        var py = (int)Math.Clamp(s.y, 0, 23);
        ctx.SetPixel(px, py, col);
    }

    // Comet head — hard white-yellow point with one pixel warm trail
    if (cometActive)
    {
        var cx = (int)Math.Clamp(cometX, 0, 23);
        var cy = (int)cometY;
        if (cx >= 0 && cx < 24)
        {
            ctx.SetPixel(cx, cy, Colors.White);
            if (cx - 1 >= 0)
                ctx.SetPixel(cx - 1, cy, Color.FromRgb(1.0, 0.95, 0.55));
        }
    }
};
