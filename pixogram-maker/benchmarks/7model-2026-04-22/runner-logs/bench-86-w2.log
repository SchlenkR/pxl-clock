             + wind * dt * 0.55;
        if (s.Y < -1) { smokes.RemoveAt(i); continue; }
        var a = Math.Max(0, (1.0 - s.Age / 4.5) * 0.32);
        var sx = (int)Math.Round(s.X);
        var sy = (int)Math.Round(s.Y);
        if (sx >= 0 && sx < 24 && sy >= 0 && sy < 24)
        {
            var cur = ctx.GetPixel(sx, sy);
            var gv = 0.45;
