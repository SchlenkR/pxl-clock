using Pxl.Ui.CSharp;

var rnd = new Random(20260422);
var drips = new List<Drip>();
var smokes = new List<Smoke>();
var prevT = 0.0;

var gustTarget = 0.0;
var windGust = 0.0;
var nextGustAt = 1.2;

var flickerE = 0.0;
var nextFlickerAt = 0.25;

var cycleLen = 45.0;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;
    var dt = Math.Clamp(t - prevT, 0.001, 0.1);
    prevT = t;

    ctx.DrawBackground(Colors.Black);

    // ---- Life cycle ----
    var ct = (t % cycleLen) / cycleLen;
    var candleTop = 10.0;
    var flameStrength = 1.0;
    var hasFlame = true;
    var smoking = false;
    var fadeIn = 1.0;

    if (ct < 0.04)
    {
        fadeIn = ct / 0.04;
        flameStrength = fadeIn;
    }
    else if (ct < 0.82)
    {
        var a = (ct - 0.04) / 0.78;
        // Non-linear melt: slow start, slight acceleration
        var melt = a * 0.55 + a * a * 0.45;
        candleTop = 10 + melt * 9;
    }
    else if (ct < 0.90)
    {
        candleTop = 19;
        var a = (ct - 0.82) / 0.08;
        flameStrength = 1.0 - a * 0.35;
    }
    else if (ct < 0.94)
    {
        candleTop = 20;
        var a = (ct - 0.90) / 0.04;
        flameStrength = (1.0 - a) * 0.55;
    }
    else
    {
        candleTop = 21;
        flameStrength = 0;
        hasFlame = false;
        if (ct < 0.99) smoking = true;
    }

    // ---- Organic wind: multi-octave + smooth random gusts ----
    var windBase = Math.Sin(t * 0.31) * 0.35
                 + Math.Sin(t * 0.73 + 1.7) * 0.20
                 + Math.Sin(t * 1.57 + 4.1) * 0.10
                 + Math.Sin(t * 3.13 + 2.3) * 0.05;

    if (t > nextGustAt)
    {
        gustTarget = (rnd.NextDouble() - 0.5) * 1.1;
        nextGustAt = t + 0.4 + rnd.NextDouble() * 2.8;
    }
    windGust += (gustTarget - windGust) * dt * 2.6;

    var wind = windBase + windGust;

    // ---- Flicker impulses (irregular) ----
    if (t > nextFlickerAt)
    {
        flickerE = (rnd.NextDouble() - 0.35) * 0.9;
        nextFlickerAt = t + 0.08 + rnd.NextDouble() * 0.62;
    }
    flickerE *= Math.Pow(0.01, dt);

    // ---- Time in corners (dim) ----
    var now = ctx.Now;
    var dimCol = Color.FromRgb(0.32, 0.32, 0.42);
    ctx.DrawTextVar3x5(now.ToString("HH"), 1, 1, dimCol);
    ctx.DrawTextVar3x5(now.ToString("mm"), 17, 1, dimCol);

    // ---- Wax pool at base ----
    var poolProgress = Math.Clamp(ct * 1.12, 0.0, 1.0);
    var poolR = 1.5 + poolProgress * 5.0;
    var poolDark = Color.FromRgb(0.70, 0.58, 0.30);
    var poolBright = Color.FromRgb(0.90, 0.78, 0.46);
    for (var px = (int)Math.Floor(12 - poolR); px <= (int)Math.Ceiling(12 + poolR); px++)
    {
        if (px < 0 || px >= 24) continue;
        var edge = Math.Abs(px - 12) / Math.Max(0.5, poolR);
        if (edge > 1.0) continue;
        var a = 1.0 - edge;
        var r = poolDark.R + (poolBright.R - poolDark.R) * a;
        var g = poolDark.G + (poolBright.G - poolDark.G) * a;
        var b = poolDark.B + (poolBright.B - poolDark.B) * a;
        ctx.SetPixel(px, 23, Color.FromRgb(r * fadeIn, g * fadeIn, b * fadeIn));
    }

    // ---- Wax mound (when candle mostly gone) ----
    if (ct > 0.78 && ct < 0.96)
    {
        var mT = Math.Min(1.0, (ct - 0.78) / 0.12);
        var moundH = (int)Math.Round(mT * 2 + 1);
        for (var dy = 0; dy < moundH; dy++)
        {
            var w = moundH - dy + 1;
            for (var px = 12 - w; px <= 12 + w; px++)
            {
                if (px >= 0 && px < 24)
                {
                    var shade = 0.78 - Math.Abs(px - 12) * 0.08;
                    ctx.SetPixel(px, 22 - dy, Color.FromRgb(shade, shade * 0.83, shade * 0.48));
                }
            }
        }
    }

    // ---- Candle body ----
    if (candleTop < 21 && fadeIn > 0.05)
    {
        var bodyTop = (int)Math.Round(candleTop);
        var bodyBot = 22;
        for (var y = bodyTop; y <= bodyBot; y++)
        {
            for (var x = 11; x <= 13; x++)
            {
                var shadeVar = Math.Sin(y * 0.4 + t * 0.25 + x * 1.3) * 0.06
                             + Math.Sin(y * 0.9 - t * 0.4 + x * 0.7) * 0.03;
                var side = Math.Abs(x - 12);
                var bright = 0.82 - side * 0.18 + shadeVar;
                bright = Math.Clamp(bright, 0.25, 1.0);
                var r = 0.96 * bright;
                var g = 0.87 * bright;
                var b = 0.58 * bright;
                ctx.SetPixel(x, y, Color.FromRgb(
                    Math.Clamp(r * fadeIn, 0, 1),
                    Math.Clamp(g * fadeIn, 0, 1),
                    Math.Clamp(b * fadeIn, 0, 1)));
            }
            // Shimmering highlight column
            var shimmer =    [anthropic] Unknown event: ping
 1.0 + Math.Sin(y * 0.45 + t * 0.5) * 0.07
                              + Math.Sin(y * 1.3 - t * 0.8) * 0.04;
            ctx.SetPixel(11, y, Color.FromRgb(
                Math.Clamp(1.0 * shimmer * fadeIn, 0, 1),
                Math.Clamp(0.94 * shimmer * fadeIn, 0, 1),
                Math.Clamp(0.75 * shimmer * fadeIn, 0, 1)));
        }
        // Wick
        ctx.SetPixel(12, bodyTop - 1, Color.FromRgb(0.24 * fadeIn, 0.17 * fadeIn, 0.10 * fadeIn));
    }

    // ---- Spawn drips probabilistically ----
    if (ct > 0.12 && ct < 0.85 && rnd.NextDouble() < dt * 1.3)
    {
        var side = rnd.Next(2) == 0 ? 11.0 : 13.0;
        drips.Add(new Drip
        {
            X = side + (rnd.NextDouble() - 0.5) * 0.4,
            Y = Math.Round(candleTop) + 1 + rnd.NextDouble() * 1.8,
            Vy = 0.6 + rnd.NextDouble() * 1.6,
            Life = 0,
            Seed = rnd.NextDouble() * 6.28
        });
    }

    for (var i = drips.Count - 1; i >= 0; i--)
    {
        var d = drips[i];
        d.Vy += 9.0 * dt;
        d.Y += d.Vy * dt;
        d.X += Math.Sin(d.Life * 3.2 + d.Seed + d.Y * 0.6) * dt * 0.25;
        d.Life += dt;
        if (d.Y >= 23 || d.Life > 4.5) { drips.RemoveAt(i); continue; }
        var dx = (int)Math.Round(d.X);
        var dy = (int)Math.Round(d.Y);
        if (dx >= 0 && dx < 24 && dy >= 0 && dy < 24)
        {
            var age = Math.Clamp(1.0 - d.Life / 4.5, 0, 1);
            ctx.SetPixel(dx, dy, Color.FromRgb(0.92 * age + 0.3, 0.80 * age + 0.25, 0.46 * age + 0.15));
        }
    }

    // ---- Flame ----
    if (hasFlame && flameStrength > 0.02)
    {
        var flameBaseY = (int)Math.Round(candleTop) - 1;

        var sway = wind * 0.95;

        var baseH = 3.3
                  + flickerE * 1.1
                  + Math.Sin(t * 4.7) * 0.22
                  + Math.Sin(t * 11.3 + 1.1) * 0.14
                  + Math.Sin(t * 17.9 + 3.3) * 0.08;
        var flameHeight = Math.Max(1.0, baseH * flameStrength);

        // Glow halo
        var glowCx = 12 + sway * 0.55;
        var glowCy = flameBaseY - flameHeight * 0.45;
        var glowR = flameHeight * 1.15 + 1.6;
        for (var gy = (int)(glowCy - glowR); gy <= (int)(glowCy + glowR); gy++)
        {
            for (var gx = (int)(glowCx - glowR); gx <= (int)(glowCx + glowR); gx++)
            {
                if (gx < 0 || gx >= 24 || gy < 0 || gy >= 24) continue;
                var dgx = gx - glowCx;
                var dgy = (gy - glowCy) * 1.15;
                var dist = Math.Sqrt(dgx * dgx + dgy * dgy);
                if (dist > glowR) continue;
                var fall = 1.0 - dist / glowR;
                fall = fall * fall * 0.20 * flameStrength * (0.9 + flickerE * 0.15);
                var cur = ctx.GetPixel(gx, gy);
                ctx.SetPixel(gx, gy, new Color(
                    Math.Min(1.0, cur.R + fall * 1.0),
                    Math.Min(1.0, cur.G + fall * 0.55),
                    Math.Min(1.0, cur.B + fall * 0.15)));
            }
        }

        // Flame body
        var topY = flameBaseY - flameHeight;
        for (var yfi = (int)Math.Floor(topY); yfi <= flameBaseY; yfi++)
        {
            if (yfi < 0 || yfi >= 24) continue;
            var frac = (flameBaseY - yfi) / Math.Max(0.5, flameHeight);
            if (frac < -0.05 || frac > 1.1) continue;
            frac = Math.Clamp(frac, 0, 1);

            // Tapered width
            var width = Math.Pow(1.0 - frac, 0.6) * 1.05 * flameStrength + 0.28;

            // Per-row organic wobble
            var wobble = Math.Sin(yfi * 1.2 + t * 5.3) * 0.18
                       + Math.Sin(yfi * 2.5 - t * 8.9 + 0.7) * 0.12
                       + Math.Sin(yfi * 0.7 + t * 3.1 + 2.1) * 0.09;

            var cx = 12.0 + sway * (0.25 + frac * 0.95) + wobble * (0.25 + frac * 0.75);

            var x0 = (int)Math.Round(cx - width);
            var x1 = (int)Math.Round(cx + width);

            for (var xf = x0; xf <= x1; xf++)
            {
                if (xf < 0 || xf >= 24) continue;
                var ddx = (xf - cx) / Math.Max(0.4, width);
                var intX = Math.Max(0, 1.0 - Math.Abs(ddx));
                if (intX < 0.08) continue;

                // Heat: max at center of base, falls toward edges and tip
                var heat = (1.0 - frac * 0.85) * intX;

                double r, g, b;
                if (heat > 0.75)
                { r = 1.0; g = 0.96; b = 0.72; }
                else if (heat > 0.5)
                {
                    var k = (heat - 0.5) / 0.25;
                    r = 1.0; g = 0.72 + k * 0.24; b = 0.22 + k * 0.50;
                }
                else if (heat > 0.25)
                {
                    var k = (heat - 0.25) / 0.25;
                    r = 0.95 + k * 0.05; g = 0.34 + k * 0.38; b = 0.06 + k * 0.16;
                }
                else
                {
                    var k = heat / 0.25;
                    r = 0.55 + k * 0.40; g = 0.08 + k * 0.26; b = 0.02 + k * 0.04;
                }

                var a = Math.Min(1.0, intX * flameStrength * 1.1);
                if (frac > 0.82) a *= Math.Max(0, 1.0 - (frac - 0.82) / 0.18);

                var cur = ctx.GetPixel(xf, yfi);
                ctx.SetPixel(xf, yfi, new Color(
                    cur.R + (r - cur.R) * a,
                    cur.G + (g - cur.G) * a,
                    cur.B + (b - cur.B) * a));
            }
        }

        // Occasional thin smoke tendril while burning
        if (rnd.NextDouble() < dt * 0.22)
        {
            smokes.Add(new Smoke
            {
                X = 12 + sway * 1.1,
                Y = topY - 0.4,
                Age = 0,
                Phase = rnd.NextDouble() * Math.PI * 2,
                Speed = 2.0 + rnd.NextDouble() * 1.2
            });
        }
    }

    // ---- Heavy smoke on snuff ----
    if (smoking && rnd.NextDouble() < dt * 9.0)
    {
        smokes.Add(new Smoke
        {
            X = 12 + (rnd.NextDouble() - 0.5) * 0.8,
            Y = 19.5,
            Age = 0,
            Phase = rnd.NextDouble() * Math.PI * 2,
            Speed = 1.6 + rnd.NextDouble() * 1.0
        });
    }

    // ---- Update & draw smoke ----
    for (var i = smokes.Count - 1; i >= 0; i--)
    {
        var s = smokes[i];
        s.Age += dt;
        if (s.Age > 4.5) { smokes.RemoveAt(i); continue; }
        s.Y -= dt * (s.Speed + Math.Sin(s.Phase + s.Age * 1.3    [anthropic] Unknown event: ping
) * 0.4);
