Looking at the new direction: completely pivot to a **top-down drone view into a crater**. Key elements:

1. **Black surrounding** outside a jagged circular rim of rock
2. **Molten lava pool** with drifting metaball blobs (lava-lamp style, yellow/orange)
3. **Inner rim glow** — bright orange crust just inside the black rock
4. **Time digits** as dark rock islands bobbing in center, with thin orange halo
5. **Spiral pinwheel sparks** erupting periodically, cooling white→yellow→red as they fly toward the rim and wink out

Approach:
- Pixel-by-pixel crater render with metaball field calculation
- Jagged rim via multi-frequency sine wave on angle
- Digits stacked HH/mm, bobbing; 4-way offset "glow" draw + dark core on top = orange halo
- Sparks as list; each has emit time, angle0, spin rate, speed → Archimedean spiral
- Stray sparks continuously + big burst every ~5s

```csharp
// ---
// app: VolcanoEye
// displayName: Volcano Eye
// appType: ClockFace
// author: Claude
// description: Drone view straight down into a crater; time floats as rock islands on a churning lava pool
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var rng = new Random(17);
var sparks = new List<Spark>();
var lastBurst = -2.5;
var burstInterval = 5.0;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;
    var cx = 11.5;
    var cy = 11.5;

    ctx.DrawBackground(Colors.Black);

    // Drifting lava blobs (metaballs), all asymmetric phases for lava-lamp feel
    var blobs = new (double x, double y, double r)[] {
        (cx + Math.Sin(t * 0.37) * 3.6,          cy + Math.Cos(t * 0.29    [anthropic] Unknown event: ping
) * 3.2,          2.9),
        (cx + Math.Sin(t * 0.23 + 1.7) * 3.2,    cy + Math.Cos(t * 0.41 + 2.3) * 3.7,    2.5),
        (cx + Math.Sin(t * 0.31 + 3.1) * 4.0,    cy + Math.Cos(t * 0.19 + 0.8) * 2.6,    2.3),
        (cx + Math.Sin(t * 0.45 + 5.0) * 2.5,    cy + Math.Cos(t * 0.33 + 4.2) * 4.2,    2.0),
        (cx + Math.Sin(t * 0.17 + 2.0) * 5.0,    cy + Math.Cos(t * 0.25 + 6.0) * 4.5,    1.6),
    };

    // Crater pixels
    for (var py = 0; py < 24; py++)
    {
        for (var px = 0; px < 24; px++)
        {
            var dx = px - cx;
            var dy = py - cy;
            var dist = Math.Sqrt(dx * dx + dy * dy);
            var ang = Math.Atan2(dy, dx);

            // Jagged rim radius — layered sines, slowly morphing
            var rim = 10.7
                    + 0.75 * Math.Sin(5 * ang + t * 0.35)
                    + 0.50 * Math.Sin(3 * ang - t * 0.22)
                    + 0.35 * Math.Sin(7 * ang + t * 0.12);

            if (dist > rim) continue; // outside crater — black

            if (dist > rim - 0.8)
            {
                // dark basalt rim with subtle texture
                var rockL = 0.02 + 0.035 * (Math.Sin(px * 1.7 + py * 2.3) * 0.5 + 0.5);
                ctx.SetPixel(px, py, Color.FromHsl(0.05, 0.35, rockL));
                continue;
            }

            // Lava pool — metaball field
            var field = 0.0;
            foreach (var b in blobs)
            {
                var bdx = px - b.x;
                var bdy = py - b.y;
                var d2 = bdx * bdx + bdy * bdy;
                field += (b.r * b.r) / (d2 + 1.0);
            }

            var hot = Math.Clamp((field - 0.4) * 0.35, 0.0, 1.0);
            var hue = 0.02 + 0.12 * hot;
            var light = 0.22 + 0.34 * hot;

            // Inner rim glow — bright orange crust just inside the rock
            if (dist > rim - 2.2)
            {
                var glowAmt = 1.0 - ((rim - 0.8) - dist) / 1.4;
                glowAmt = Math.Max(0.0, Math.Min(1.0, glowAmt));
                hue = 0.055 + 0.02 * (1.0 - glowAmt);
                light = Math.Max(light, 0.34 + 0.26 * glowAmt);
            }

            ctx.SetPixel(px, py, Color.FromHsl(hue, 1.0, light));
        }
    }

    // Periodic pinwheel surge
    if (t - lastBurst > burstInterval)
    {
        lastBurst = t;
        var baseAng = rng.NextDouble() * Math.PI * 2;
        var n = 9;
        for (var i = 0; i < n; i++)
        {
            sparks.Add(new Spark {
                Emitted = t,
                Angle0 = baseAng + i * (Math.PI * 2 / n),
                Speed = 3.2 + rng.NextDouble() * 1.1,
                Spin = 1.0 + rng.NextDouble() * 0.45,
                Life = 3.0 + rng.NextDouble() * 0.8,
            });
        }
    }

    // Occasional stray spark between surges
    if (rng.NextDouble() < 0.08)
    {
        sparks.Add(new Spark {
            Emitted = t,
            Angle0 = rng.NextDouble() * Math.PI * 2,
            Speed = 1.8 + rng.NextDouble() * 1.6,
            Spin = 0.4 + rng.NextDouble() * 0.7 * (rng.NextDouble() < 0.5 ? -1 : 1),
            Life = 1.6 + rng.NextDouble() * 0.9,
        });
    }

    // Update + draw sparks
    for (var i = sparks.Count - 1; i >= 0; i--)
    {
        var s = sparks[i];
        var age = t - s.Emitted;
        if (age > s.Life) { sparks.RemoveAt(i); continue; }
        var age01 = age / s.Life;
        var r = age * s.Speed;
        var ang = s.Angle0 + age * s.Spin;
        var sx = cx + Math.Cos(ang) * r;
        var sy = cy + Math.Sin(ang) * r;
        if (sx < -0.5 || sx > 23.5 || sy < -0.5 || sy > 23.5) continue;

        // wink out past rim
        var sdx = sx - cx;
        var sdy = sy - cy;
        var sdist = Math.Sqrt(sdx * sdx + sdy * sdy);
        var sangle = Math.Atan2(sdy, sdx);
        var srim = 10.7
                 + 0.75 * Math.Sin(5 * sangle + t * 0.35)
                 + 0.50 * Math.Sin(3 * sangle - t * 0.22)
                 + 0.35 * Math.Sin(7 * sangle + t * 0.12);
        if (sdist > srim + 0.4) continue;

        // color: white-hot (age=0) → yellow → deep red (age=1)
        var hue = Math.Max(0.0, 0.14 - 0.13 * age01);
        var sat = Math.Min(1.0, 0.18 + age01 * 1.3);
        var lt = 0.95 - 0.55 * age01;
        if (lt < 0.18) continue;
        ctx.DrawPoint(sx, sy, Color.FromHsl(hue, sat, lt));
    }

    // Time digits as bobbing rock islands with orange molten crust
    var now = ctx.Now;
    var hh = now.ToString("HH");
    var mm = now.ToString("mm");
    var bob1 = Math.Sin(t * 0.7) * 0.35;
    var bob2 = Math.Sin(t * 0.7 + 1.6) * 0.35;

    var glow = Color.FromHsl(0.075, 1.0, 0.55);
    var rock = Color.FromHsl(0.05, 0.55, 0.035);

    for (var k = 0; k < 2; k++)
    {
        var s = k == 0 ? hh : mm;
        var ty = k == 0 ? 5.0 + bob1 : 13.0 + bob2;
        var tx = 8.0;
        // 4-way outline for glow halo
        ctx.DrawTextMono4x5(s, tx - 1, ty, glow);
        ctx.DrawTextMono4x5(s, tx + 1, ty, glow);
        ctx.DrawTextMono4x5(s, tx, ty - 1, glow);
        ctx.DrawTextMono4x5(s, tx, ty + 1, glow);
        // dark rock core on top
        ctx.DrawTextMono4x5(s, tx, ty, rock);
    }
};

class Spark
{
    public double Emitted;
    public double Angle0;
    public double Speed;
    public double Spin;
    public double Life;
}
