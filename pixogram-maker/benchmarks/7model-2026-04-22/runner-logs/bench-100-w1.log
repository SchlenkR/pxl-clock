// ---
// app: VulkanFunkenflug
// displayName: Vulkan Funkenflug
// appType: ClockFace
// author: Claude
// description: Funken aus dem Vulkan formen die Uhrzeit am Himmel
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var digits = new Dictionary<char, string[]>
{
    ['0'] = new[] {"111","101","101","101","111"},
    ['1'] = new[] {"010","110","010","010","111"},
    ['2'] = new[] {"111","001","111","100","111"},
    ['3'] = new[] {"111","001","111","001","111"},
    ['4'] = new[] {"101","101","111","001","001"},
    ['5'] = new[] {"111","100","111","001","111"},
    ['6'] = new[] {"111","100","111","101","111"},
    ['7'] = new[] {"111","001","010","010","010"},
    ['8'] = new[] {"111","101","111","101","111"},
    ['9'] = new[] {"111","101","111","001","111"},
    [':'] = new[] {"0","1","0","1","0"},
};

var sky = Color.FromRgb(0.02, 0.02, 0.08);

var stars = new (int x, int y, double b)[]
{
    (2, 2, 0.6), (18, 1, 0.85), (7, 3, 0.5), (21, 5, 0.7),
    (3, 9, 0.4), (15, 11, 0.45), (22, 12, 0.55), (1, 6, 0.5)
};

var craterX = 12.0;
var craterY = 14.0;

Color Cool(double h)
{
    h = Math.Clamp(h, 0.0, 1.0);
    if (h < 0.25)
    {
        var u = h / 0.25;
        return Color.FromRgb(1.0, 1.0 - u * 0.1, 0.9 - u * 0.6);
    }
    if (h < 0.6)
    {
        var u = (h - 0.25) / 0.35;
        return Color.FromRgb(1.0, 0.9 - u * 0.4, 0.3 - u * 0.25);
    }
    var v = (h - 0.6) / 0.4;
    return Color.FromRgb(1.0 - v * 0.45, 0.5 - v * 0.47, 0.05 - v * 0.05);
}

int Hash(int a, int b)
{
    unchecked
    {
        var h = a * 374761393 + b * 668265263;
        h = (h ^ (h >> 13)) * 1274126177;
        return h ^ (h >> 16);
    }
}

List<(double x, double y)> Targets(DateTime n, Dictionary<char, string[]> dig)
{
    var time = n.ToString("HH:mm");
    var list = new List<(double, double)>();
    var x0 = 4.0;
    var y0 = 4.0;
    foreach (var ch in time)
    {
        var rows = dig[ch];
        var w = rows[0].Length;
        for (var ry = 0; ry < 5; ry++)
        {
            for (var rx = 0; rx < w; rx++)
            {
                if (rows[ry][rx] == '1') list.Add((x0 + rx, y0 + ry));
            }
        }
        x0 += w + 1;
    }
    return list;
}

var scene = (DrawingContext ctx) =>
{
    var now = ctx.Now;
    ctx.DrawBackground(sky);

    // twinkling stars
    var tt = ctx.Elapsed.TotalSeconds;
    foreach (var (sx, sy, sb) in stars)
    {
        var tw = 0.7 + 0.3 * Math.Sin(tt * 2 + sx * 1.7 + sy * 1.3);
        var b = sb * tw;
        ctx.DrawPoint(sx, sy, Color.FromRgb(b * 0.9, b * 0.9, b));
    }

    // cycle timing (2 seconds per pulse)
    var elapsed = ctx.Elapsed.TotalSeconds;
    var cycleIdx = (long)Math.Floor(elapsed / 2.0);
    var cycleT = elapsed - cycleIdx * 2.0;
    var t = cycleT / 2.0; // 0..1

    // eruption intensity curve (peak during rise)
    var erupt = t < 0.35 ? Math.Sin(t / 0.35 * Math.PI) :
                t > 0.85 ? Math.Sin((1.0 - t) / 0.15 * Math.PI) * 0.55 : 0.18;

    // volcano silhouette — pitch-black triangle
    for (var y = 14; y <= 23; y++)
    {
        var pr = (y - 14) / 9.0;
        var lx = (int)Math.Floor(9 - pr * 5);
        var rx = (int)Math.Ceiling(15 + pr * 5);
        for (var x = lx; x <= rx; x++)
        {
            ctx.SetPixel(x, y, Colors.Black);
        }
    }

    // shoulder glow (pulses with eruption)
    var shI = 0.22 + erupt * 0.65;
    ctx.SetPixel(9, 14, Color.FromRgb(shI * 0.7, shI * 0.25, 0));
    ctx.SetPixel(15, 14, Color.FromRgb(shI * 0.7, shI * 0.25, 0));
    ctx.SetPixel(8, 15, Color.FromRgb(shI * 0.35, shI * 0.1, 0));
    ctx.SetPixel(16, 15, Color.FromRgb(shI * 0.35, shI * 0.1, 0));
    ctx.SetPixel(10, 15, Color.FromRgb(shI * 0.4, shI * 0.12, 0));
    ctx.SetPixel(14, 15, Color.FromRgb(shI * 0.4, shI * 0.12, 0));

    // crater — orange wound
    var cI = 0.7 + erupt * 0.3;
    ctx.SetPixel(11, 14, Color.FromRgb(cI, cI * 0.5, 0.05));
    ctx.SetPixel(12, 14, Color.FromRgb(1.0, cI * 0.72, 0.15));
    ctx.SetPixel(13, 14, Color.FromRgb(cI, cI * 0.5, 0.05));
    ctx.SetPixel(12, 15, Color.FromRgb(cI * 0.65, cI * 0.22, 0));

    // embers forging the clock
    var targets = Targets(now, digits);
    var seed = unchecked((int)(cycleIdx * 73856093L + 12345));

    for (var i = 0; i < targets.Count; i++)
    {
        var (tx, ty) = targets[i];
        var h = Hash(seed, i);
        var r1 = (h & 0xFF) / 255.0;
        var r2 = ((h >> 8) & 0xFF) / 255.0;
        var r3 = ((h >> 16) & 0xFF) / 255.0;

        var phaseOff = r1 * 0.06;       // slight launch stagger
        var curveX = (r2 - 0.5) * 5.0;  // lateral arc
        var arcPeak = 6.5 - r3 * 2.5;   // peak y of the rise arc

        var localT = t - phaseOff;
        if (localT < 0) continue;
        if (localT >= 1.0) continue;

        double px, py;
        Color color;

        if (localT < 0.35)
        {
            // rise: tight plume → fan out to target via quadratic bezier
            var u = localT / 0.35;
            var eu = 1 - Math.Pow(1 - u, 1.7); // ease-out for lock-in feel
            var cpx = (craterX + tx) / 2 + curveX;
            var cpy = Math.Min(arcPeak, (craterY + ty) / 2 - 1);
            var om = 1 - eu;
            px = om * om * craterX + 2 * om * eu * cpx + eu * eu * tx;
            py = om * om * craterY + 2 * om * eu * cpy + eu * eu * ty;
            color = Color.FromRgb(1.0, 0.98 - u * 0.05, 0.75 - u * 0.35);
        }
        else if (localT < 0.85)
        {
            // hold: lock on digit pixel, cool through yellow → deep red
            px = tx;
            py = ty;
            var hh = (localT - 0.35) / 0.5;
            color = Cool(hh);
        }
        else
        {
            // shatter: suck down into crater with swirl
            var u = (localT - 0.85) / 0.15;
            var eu = u * u;
            var swirl = curveX * Math.    [anthropic] Unknown event: ping
Sin(u * Math.PI) * 0.45;
            px = tx + (craterX - tx) * eu + swirl;
            py = ty + (craterY - ty) * eu;
            var fade = 1 - u;
            color = Color.FromRgb(0.55 * fade, 0.05 * fade, 0);
        }

        if (px < 0 || px >= 24 || py < 0 || py >= 24) continue;
        ctx.DrawPoint(px, py, color);
    }
};
