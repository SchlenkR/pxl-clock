```csharp
// ---
// app: VulkanausbruchFunkenflug
// displayName: Volcano Eruption
// appType: ClockFace
// author: Claude
// description: A restless volcano lobs white-hot lava and sparks that cool from white to deep red against a starless night
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var rng = new Random(1234);
var sparks = new List<Spark>();
var lastEruption = -10.0;
var lastTime = -1.0;
var eruptionInterval = 2.0;

var scene = (DrawingContext ctx) =>
{
    ctx.DrawBackground(Colors.Black);

    var t = ctx.Elapsed.TotalSeconds;
    var dt = lastTime < 0 ? 0.025 : Math.Min(0.1, t - lastTime);
    lastTime = t;

    // Eruption trigger
    var sinceEruption = t - lastEruption;
    if (sinceEruption >= eruptionInterval)
    {
        lastEruption = t;
        sinceEruption = 0;
        var count = 6 + rng.Next(3); // 6-8 sparks
        for (var i = 0; i < count; i++)
        {
            var angle = -Math.PI / 2.0 + (rng.NextDouble() - 0.5) * 1.7;
            var speed = 8.0 + rng.NextDouble() * 5.5;
            sparks.Add(new Spark
            {
                X = 12.0 + (rng.NextDouble() - 0.5) * 1.2,
                Y = 14.5,
                Vx = Math.Cos(angle) * speed,
                Vy = Math.Sin(angle) * speed,
                Age = 0.0,
                Life = 1.2 + rng.NextDouble() * 0.9
            });
        }
    }

    // Update sparks (simple ballistic with gravity)
    var gravity = 11.5;
    for (var i = sparks.Count - 1; i >= 0; i--)
    {
        var s = sparks[i];
        s.Vy += gravity * dt;
        s.X += s.Vx * dt;
        s.Y += s.Vy * dt;
        s.Age += dt;
        if (s.Age >= s.Life || s.Y > 22 || s.X < -2 || s.X > 26)
            sparks.RemoveAt(i);
    }

    // Pulse strength from eruption (sharp decay over 0.9s)
    var glowPulse = Math.Max(0.0, 1.0 - sinceEruption / 0.9);

    // Sky glow pulsing on the volcano's shoulders (drawn before cone)
    var glowBase = 0.22 + 0.55 * glowPulse;
    for (var gy = 9; gy <= 15; gy++)
    {
        for (var gx = 3; gx <= 21; gx++)
        {
            var dx = gx - 12.0;
            var dy = gy - 15.0;
            var d = Math.Sqrt(dx * dx + dy * dy);
            if (d >= 6.5) continue;
            var a = (1.0 - d / 6.5) * glowBase * 0.6;
            if (a <= 0.01) continue;
            var ex = ctx.GetPixel(gx, gy);
            var r = Math.Min(1.0, ex.R + (1.0 - ex.R) * a);
            var g = Math.Min(1.0, ex.G + (0.38 - ex.G) * a * 0.85);
            var b = Math.Min(1.0, ex.B + (0.08 - ex.B) * a * 0.55);
            ctx.SetPixel(gx, gy, Color.FromRgb(r, g, b));
        }
    }

    // Time display — ember red, high and centered, steady
    var timeStr = ctx.Now.ToString("HH:mm");
    var tw = ctx.MeasureTextVar4x5(timeStr);
    var ember = Color.FromRgb(0.72, 0.17, 0.06);
    ctx.DrawTextVar4x5(timeStr, (24.0 - tw) / 2.0, 1, ember);

    // Volcano cone — black triangular silhouette in bottom third
    for (var y = 15; y <= 23; y++)
    {
        var spread = (y - 15) * 1.0 + 0.5;
        var xL = 12.0 - spread;
        var xR = 12.0 + spread;
        var xLi = (int)Math.Floor(xL);
        var xRi = (int)Math.Ceiling(xR);
        for (var x = xLi; x <= xRi; x++)
        {
            if (x < 0 || x >= 24) continue;
            var edgeDist = Math.Min(x - xL, xR - x);
            if (edgeDist < -0.1) continue;
            var cone = edgeDist < 0.45 ? Color.FromRgb(0.16, 0.08, 0.05)
                     : edgeDist < 1.3  ? Color.FromRgb(0.07, 0.035, 0.02)
                                       : Color.FromRgb(0.03, 0.015, 0.01);
            ctx.SetPixel(x    [anthropic] Unknown event: ping
, y, cone);
        }
    }

    // Crater — glowing orange "wound" at the cone's peak
    var craterPulse = 0.7 + 0.3 * glowPulse;
    ctx.SetPixel(11, 15, Color.FromRgb(0.85 * craterPulse, 0.32 * craterPulse, 0.05));
    ctx.SetPixel(12, 15, Color.FromRgb(1.0  * craterPulse, 0.58 * craterPulse, 0.15));
    ctx.SetPixel(13, 15, Color.FromRgb(0.85 * craterPulse, 0.32 * craterPulse, 0.05));
    ctx.SetPixel(11, 16, Color.FromRgb(0.45 * craterPulse, 0.12 * craterPulse, 0.02));
    ctx.SetPixel(12, 16, Color.FromRgb(0.65 * craterPulse, 0.22 * craterPulse, 0.04));
    ctx.SetPixel(13, 16, Color.FromRgb(0.45 * craterPulse, 0.12 * craterPulse, 0.02));

    // Sparks — cool from white → yellow → orange → deep red → gone
    foreach (var s in sparks)
    {
        var age = s.Age / s.Life;
        var c = age < 0.12 ? Color.FromRgb(1.0, 1.0, 0.95)
              : age < 0.30 ? Color.FromRgb(1.0, 0.93, 0.42)
              : age < 0.55 ? Color.FromRgb(1.0, 0.55, 0.1)
              : age < 0.85 ? Color.FromRgb(0.9, 0.16, 0.04)
              : Color.FromRgb(
                    0.55 * (1.0 - (age - 0.85) / 0.15),
                    0.05 * (1.0 - (age - 0.85) / 0.15),
                    0.01 * (1.0 - (age - 0.85) / 0.15));
        var sx = (int)Math.Round(s.X);
        var sy = (int)Math.Round(s.Y);
        if (sx >= 0 && sx < 24 && sy >= 0 && sy < 24)
            ctx.SetPixel(sx, sy, c);
    }
};

class Spark
{
    public double X, Y, Vx, Vy, Age, Life;
}
