```csharp
// ---
// app: VulkanausbruchFunken
// displayName: Vulkanausbruch
// appType: Scene
// author: Claude
// description: A small volcano erupts glowing lava and sparks that cool from white-yellow to deep red as they rise through a dark night sky
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var rng = new Random(1337);
var sparks = new List<Spark>();
var lastEruption = -10.0;
var eruptionInterval = 3.5;
var lastFrameTime = 0.0;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;
    var dt = Math.Max(0.001, Math.Min(0.08, t - lastFrameTime));
    lastFrameTime = t;

    // Dark night sky
    ctx.DrawBackground(Color.FromRgb(0.015, 0.015, 0.05));

    // Twinkling stars (upper half only)
    for (var i = 0; i < 11; i++)
    {
        var sx = (i * 7 + 3) % 24;
        var sy = (i * 13 + 5) % 11;
        var tw = 0.35 + 0.35 * Math.Sin(t * 1.7 + i * 1.9);
        if (tw > 0.2)
            ctx.SetPixel(sx, sy, Color.FromRgb(tw * 0.55, tw * 0.55, tw * 0.7));
    }

    // Eruption trigger
    if (t - lastEruption > eruptionInterval)
    {
        lastEruption = t;
        var count = 22 + rng.Next(10);
        for (var i = 0; i < count; i++)
        {
            var angle = -Math.PI / 2.0 + (rng.NextDouble() - 0.5) * 1.6;
            var speed = 7.0 + rng.NextDouble() * 7.5;
            sparks.Add(new Spark
            {
                X = 12.0 + (rng.NextDouble() - 0.5) * 1.4,
                Y = 13.6,
                Vx = Math.Cos(angle) * speed,
                Vy = Math.Sin(angle) * speed,
                Age = 0.0,
                Life = 1.3 + rng.NextDouble() * 1.4
            });
        }
    }

    // Update sparks (physics)
    var gravity = 10.5;
    for (var i = sparks.Count - 1; i >= 0; i--)
    {
        var s = sparks[i];
        s.Vy += gravity * dt;
        s.X += s.Vx * dt;
        s.Y += s.Vy * dt;
        s.Age += dt;
        if (s.Age > s.Life || s.Y > 23.5 || s.X < -2 || s.X > 26)
            sparks.RemoveAt(i);
    }

    // Volcano body (trapezoid) — darker near top, a touch lighter near base
    for (var y = 14; y <= 23; y++)
    {
        var frac = (y - 14) / 9.0;
        var halfWidth = 2.0 + frac * 6.0;
        var xl = (int)Math.Round(12 - halfWidth);
        var xr = (int)Math.Round(12 + halfWidth);
        var r = 0.11 + frac * 0.11;
        var g = 0.07 + frac * 0.07;
        var b = 0.05 + frac * 0.05;
        for (var x = xl; x <= xr; x++)
            if (x >= 0 && x < 24)
                ctx.SetPixel(x, y, Color.FromRgb(r, g, b));
    }

    // Crater glow — pulses strongest right after eruption, then cools
    var sinceErupt = t - lastEruption;
    var glow = 0.35 + 0.65 * Math.Max(0.0, 1.0 - sinceErupt / (eruptionInterval * 0.7));
    // Crater lip
    for (var x = 10; x <= 14; x++)
        ctx.SetPixel(x, 14, Color.FromRgb(Math.Min(1.0, glow), 0.45 * glow, 0.08 * glow));
    // Inner glow just above lip (bright lava fountain base)
    ctx.SetPixel(11, 13, Color.FromRgb(glow, 0.55 * glow, 0.12 * glow));
    ctx.SetPixel(12, 13, Color.FromRgb(Math.Min(1.0, glow * 1.1), 0.7 * glow, 0.18 * glow));
    ctx.SetPixel(13, 13, Color.FromRgb(glow, 0.55 * glow, 0.12 * glow));

    // Subtle volcano side glow from crater light
    for (var y = 14; y <= 17; y++)
    {
        var d = y - 14;
        var sideGlow = glow * (0.25 - d * 0.05);
        if (sideGlow > 0)
        {
            var xl = (int)Math.Round(12 - (2.0 + (d / 9.0) * 6.0)) + 1;
            var xr = (int)Math.Round(12 + (2.0 + (d / 9.0) * 6.0)) - 1;
            if (xl >= 0 && xl < 24)
            {
                var p = ctx.GetPixel(xl, y);
                ctx.SetPixel(xl, y, Color.FromRgb(
                    Math.Min(1.0, p.R + sideGlow * 0.8),
                    Math.Min(1.0, p.G + sideGlow * 0.3),
                    Math.Min(1.0, p.B + sideGlow * 0.05)));
            }
            if (xr >= 0 && xr < 24 && xr != xl)
            {
                var p = ctx.GetPixel(xr, y);
                ctx.SetPixel(xr, y, Color.FromRgb(
                    Math.Min(1.0, p.R + sideGlow * 0.8),
                    Math.Min(1.0, p.G + sideGlow * 0.3),
                    Math.Min(1.0, p.B + sideGlow * 0.05)));
            }
        }
    }

    // Draw sparks with temperature-based color
    foreach (var s in sparks)
    {
        var f = s.Age / s.Life;
        var col = Color.FromRgb(1.0, 1.0, 0.9);
        if (f < 0.15)
        {
            col = Color.FromRgb(1.0, 1.0, 0.92);
        }
        else if (f < 0.4)
        {
            var k = (f - 0.15) / 0.25;
            col = Color.FromRgb(1.0, 1.0 - k * 0.3, 0.92 - k * 0.82);
        }
        else if (f < 0.7)
        {
            var k = (f - 0.4) / 0.3;
            col = Color.FromRgb(1.0, 0.7 - k * 0.5, 0.1 * (1.0 - k));
        }
        else
        {
            var k = (f - 0.7) / 0.3;
            col = Color.FromRgb(0.95 - k * 0.55, 0.2 * (1.0 - k), 0.0);
        }

        var px = (int)Math.Round(s.X);
        var py = (int)Math.Round(s.Y);
        if (px >= 0 && px < 24 && py >= 0 && py < 24)
            ctx.SetPixel(px, py, col);
    }
};

public class Spark
{
    public double X, Y, Vx, Vy, Age, Life;
}
