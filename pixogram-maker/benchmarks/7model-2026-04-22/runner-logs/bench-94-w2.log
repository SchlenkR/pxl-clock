```csharp
// ---
// app: SegelbootWellen
// displayName: Segelboot auf Wellen (Nacht)
// appType: ClockFace
// author: claude-sonnet-4-6
// description: Ein Segelboot schaukelt nachts auf organisch bewegten Wellen unter dem Mondlicht
// ---

#:package Pxl@*

using Pxl.Ui.CSharp;

var scene = (DrawingContext ctx) =>
{
    var t = ctx.Elapsed.TotalSeconds;
    var now = ctx.Now;

    // Sky — deep night blue-violet
    ctx.DrawRectXyWh(0, 0, 24, 15, colorFill: Color.FromRgb(0.04, 0.04, 0.13));
    // Water — dark blue
    ctx.DrawRectXyWh(0, 15, 24, 9, colorFill: Color.FromRgb(0.03, 0.06, 0.15));

    // Moon — upper right, cold silver
    ctx.DrawCircle(19, 4, 2.4, colorFill: Color.FromRgb(0.88, 0.89, 0.80));

    // Twinkling stars — each at its own incommensurable frequency
    var s1 = 0.4 + 0.4 * Math.Sin(t * 2.37 + 1.1);
    var s2 = 0.4 + 0.4 * Math.Sin(t * 1.61 + 2.4);
    var s3 = 0.35 + 0.35 * Math.Sin(t * 3.14 + 0.7);
    var s4 = 0.3 + 0.3 * Math.Sin(t * 1.41 + 3.2);
    var s5 = 0.4 + 0.4 * Math.Sin(t * 2.71 + 0.3);
    ctx.SetPixel(2, 2, Color.FromRgb(s1 * 0.8, s1 * 0.8, s1).WithAlpha(s1));
    ctx.SetPixel(7, 1, Color.FromRgb(s2 * 0.85, s2 * 0.85, s2).WithAlpha(s2));
    ctx.SetPixel(12, 3, Color.FromRgb(s3 * 0.8, s3 * 0.9, s3).WithAlpha(s3));
    ctx.SetPixel(5, 5, Color.FromRgb(s4 * 0.7, s4 * 0.8, s4).WithAlpha(s4));
    ctx.SetPixel(15, 2, Color.FromRgb(s5 * 0.8, s5 * 0.8, s5).WithAlpha(s5));

    // Moon reflection — shimmering column, width varies organically
    for (var ry = 15; ry < 24; ry++)
    {
        var sh = 0.10 + 0.07 * Math.Sin(t * 3.73 + ry * 0.91)
                      + 0.04 * Math.Sin(t * 1.29 + ry * 0.43)
                      + 0.02 * Math.Sin(t * 5.11 + ry * 1.37);
        sh = Math.Max(0.02, sh);
        var rx = 19.0 + 0.6 * Math.Sin(t * 2.17 + ry * 0.61)
                      + 0.3 * Math.Sin(t * 0.83 + ry * 1.1);
        ctx.DrawPoint(rx - 1, ry, Color.FromRgb(sh * 0.85, sh * 0.85, sh * 0.9).WithAlpha(0.7));
        ctx.DrawPoint(rx,     ry, Color.FromRgb(sh,         sh,         sh * 0.95).WithAlpha(0.9));
        ctx.DrawPoint(rx + 1, ry, Color.FromRgb(sh * 0.8,  sh * 0.8,  sh * 0.88).WithAlpha(0.65));
    }

    // Waves — three overlapping components at incommensurable speeds
    for (var wx = 0; wx < 24; wx++)
    {
        var w1 = Math.Sin(wx * 0.52 - t * 1.13) * 1.0;
        var w2 = Math.Sin(wx * 0.79 - t * 0.71) * 0.50;
        var w3 = Math.Sin(wx * 1.31 - t * 1.57) * 0.22;
        var wy = 16.5 + w1 + w2 + w3;
        var wh = 1.4 + 0.3 * Math.Sin(wx * 0.63 + t * 0.47);
        ctx.DrawLine(wx, wy, wx, wy + wh, Color.FromRgb(0.09, 0.17, 0.34));
        // Crest shimmer
        var crest = Math.Max(0.0, w1 * 0.12);
        if (crest > 0.04)
            ctx.DrawPoint(wx, wy - 0.4, Color.FromRgb(crest, crest * 1.1, crest * 1.6));
    }

    // Organic boat motion — three-layer bob (primary + secondary wobble + micro-tremor)
    var bobA = Math.Sin(t * 0.71) * 1.2;
    var bobB = Math.Sin(t * 1.43 + 0.81) * 0.38;
    var bobC = Math.Sin(t * 2.31 + 1.54) * 0.13;
    var boatBob = bobA + bobB + bobC;

    // Tilt derived from bob velocity — boat leans as wave lifts/drops it
    var tiltVel = Math.Cos(t * 0.71) * 0.71 * 1.2
                + Math.Cos(t * 1.43 + 0.81) * 1.43 * 0.38
                + Math.Cos(t * 2.31 + 1.54) * 2.31 * 0.13;
    var tiltDeg = tiltVel * 5.5;  // scale velocity to degrees

    // Horizontal drift — two slow overlapping meanders
    var driftA = Math.Sin(t * 0.29 + 0.5) * 1.4;
    var driftB = Math.Sin(t * 0.53 + 1.2) * 0.45;
    var boatX = 8.5 + driftA + driftB;
    var baseY = 15.0 + boatBob;

    // Brightness: brighter when near moon reflection corridor
    var nearMoon = Math.Max(0.0, 1.0 - Math.Abs(boatX - 19.0) / 4.0);
    var br = 0.72 + nearMoon * 0.23;
    var hullColor = Color.FromRgb(br, br, br * 0.88);
    var sailColor = Color.FromRgb(br * 0.97, br * 0.97, br);
    var mastColor = Color.FromRgb(br * 0.65, br * 0.65, br * 0.60);

    // Draw boat onto a layer so we can rotate it for tilt
    var boatLayer = ctx.NewLayer(clearColor: Colors.Transparent);

    // Hull
    boatLayer.DrawRectXyWh(boatX - 3, baseY, 6, 1.8, colorFill: hullColor);
    boatLayer.DrawPoint(boatX - 3.5, baseY + 0.7, hullColor);
    boatLayer.DrawPoint(boatX + 3.5, baseY + 0.7, hullColor);

    // Mast
    boatLayer.DrawLine(boatX, baseY - 6.5, boatX, baseY, color: mastColor);

    // Sail fill — slightly billowed triangle
    for (var si = 0; si < 6; si++)
    {
        var frac = si / 6.0;
        var sw = frac * 3.2;
        boatLayer.DrawLine(boatX - sw * 0.08, baseY - 6 + si,
                           boatX + sw * 0.92, baseY - 6 + si,
                           color: sailColor.WithAlpha(0.88));
    }
    // Sail outline
    boatLayer.DrawLine(boatX, baseY - 6.5, boatX + 3.2, baseY - 0.5, color: sailColor);
    boatLayer.DrawLine(boatX, baseY - 6.5, boatX - 0.3, baseY - 0.5, color: sailColor);
    boatLayer.DrawLine(boatX - 0.3, baseY - 0.5, boatX + 3.2, baseY - 0.5, color: sailColor);

    // Apply tilt rotation around hull center
    boatLayer.Rotate(tiltDeg, boatX, baseY + 0.9);
    boatLayer.Apply(BlendMode.SourceOver, Interpolation.Linear);

    // Time — subtle phosphorescent blue-white at bottom
    var ts = now.ToString("HH    [anthropic] Unknown event: ping
:mm");
    var tw = ctx.MeasureTextMono4x5(ts);
    ctx.DrawTextMono4x5(ts, (ctx.Width - tw) / 2.0, 19,
        color: Color.FromRgb(0.42, 0.52, 0.74).WithAlpha(0.8));
};
