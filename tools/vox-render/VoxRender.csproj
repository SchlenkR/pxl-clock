<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VoxRender</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

  <!-- Reuse the renderer + .vox parser from voxel-studio so we render with
       the exact same code that the GUI uses. -->
  <ItemGroup>
    <Compile Include="..\voxel-studio\IsoRenderer.cs" Link="Shared/IsoRenderer.cs" />
    <Compile Include="..\voxel-studio\VoxModel.cs"    Link="Shared/VoxModel.cs" />
  </ItemGroup>
</Project>
