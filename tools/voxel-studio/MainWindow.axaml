<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="VoxelStudio.MainWindow"
        Title="Voxel Studio"
        Width="1280" Height="820"
        Background="#15181C">

    <Grid RowDefinitions="Auto,*">
        <!-- Toolbar (two rows so it fits narrower windows) -->
        <Border Grid.Row="0" Background="#22262C" Padding="8">
            <StackPanel Spacing="6">
                <!-- Row 1: file ops + sun pos -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Name="OpenButton" Content="Open..." />
                    <Button Name="SaveButton" Content="Save..." />
                    <Border Width="1" Background="#333" />
                    <TextBlock Name="SunPositionLabel" Foreground="#9F9"
                               VerticalAlignment="Center"
                               ToolTip.Tip="Sun yaw/pitch in world space. Drag with Option (Alt) to move only the sun, Cmd to move only the camera, no modifier to move both together." />
                </StackPanel>
                <!-- Row 1b: Light preset buttons -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Light:" VerticalAlignment="Center" Foreground="#BBB" />
                    <WrapPanel Name="LightButtonPanel" />
                </StackPanel>
                <!-- Row 2: camera controls -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton Name="AutoRotateToggle" Content="Auto-rotate" IsChecked="False" />
                    <Border Width="1" Background="#333" />
                    <TextBlock Text="Yaw:" VerticalAlignment="Center" Foreground="#BBB" />
                    <Slider Name="AngleSlider" Width="120" Minimum="0" Maximum="360" Value="344"
                            VerticalAlignment="Center" />
                    <TextBlock Name="AngleLabel" Text="344°" VerticalAlignment="Center"
                               Foreground="#DDD" Width="36" />
                    <TextBlock Text="Pitch:" VerticalAlignment="Center" Foreground="#BBB" />
                    <Slider Name="PitchSlider" Width="120" Minimum="0" Maximum="360" Value="334"
                            VerticalAlignment="Center" />
                    <TextBlock Name="PitchLabel" Text="334°" VerticalAlignment="Center"
                               Foreground="#DDD" Width="36" />
                    <Border Width="1" Background="#333" />
                    <TextBlock Text="px/vox:" VerticalAlignment="Center" Foreground="#BBB" />
                    <Slider Name="ZoomSlider" Width="100" Minimum="8" Maximum="64" Value="32"
                            VerticalAlignment="Center" />
                    <TextBlock Text="Ambient:" VerticalAlignment="Center" Foreground="#BBB" />
                    <Slider Name="AmbientSlider" Width="90" Minimum="0" Maximum="250" Value="98"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Ambient floor brightness (0 .. 2.5). Auto-set on preset change." />
                    <TextBlock Name="AmbientLabel" Text="0.98" VerticalAlignment="Center"
                               Foreground="#DDD" Width="36" />
                    <TextBlock Text="Sun:" VerticalAlignment="Center" Foreground="#BBB" />
                    <Slider Name="SunSlider" Width="90" Minimum="0" Maximum="500" Value="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Direct sun intensity (0%..500%, overbright above 100%)." />
                    <TextBlock Name="SunLabel" Text="0%" VerticalAlignment="Center"
                               Foreground="#DDD" Width="42" />
                    <TextBlock Text="Pan:" VerticalAlignment="Center" Foreground="#BBB" />
                    <Slider Name="PanSlider" Width="120" Minimum="-100" Maximum="100" Value="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Slide the camera along the model's long axis. -100 = one end, +100 = the other." />
                    <TextBlock Name="PanLabel" Text="0" VerticalAlignment="Center"
                               Foreground="#DDD" Width="36" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body: 4 columns: file browser | studio view | pxl preview | text editor -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*,Auto,420">
            <!-- File browser sidebar -->
            <Border Grid.Column="0" Background="#1A1D22" Padding="6">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6"
                                Margin="2,2,2,6">
                        <TextBlock Text="Models" Foreground="#DDD" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button Name="ReloadButton" Content="↻" Padding="6,2"
                                ToolTip.Tip="Rescan folder" />
                    </StackPanel>
                    <ListBox Grid.Row="1" Name="FileSelector"
                             Background="Transparent" BorderThickness="0"
                             FontFamily="Menlo,Consolas,monospace" FontSize="12" />
                </Grid>
            </Border>

            <!-- Big iso studio view: drag to rotate, wheel to zoom -->
            <Border Grid.Column="1" Name="StudioPanel" Background="#0A0C10" Padding="8"
                    Cursor="SizeWestEast">
                <Image Name="StudioImage" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" />
            </Border>

            <!-- Pxl preview column -->
            <Border Grid.Column="2" Background="#1A1D22" Padding="12" Width="280">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <!-- Background mode (clock-style layout: sky+water, sky-only, or water-only) -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="BG:" VerticalAlignment="Center" Foreground="#BBB" Width="28" />
                            <ToggleButton Name="BgBothToggle"  Content="Both"  Padding="6,2" />
                            <ToggleButton Name="BgSkyToggle"   Content="Sky"   Padding="6,2" />
                            <ToggleButton Name="BgWaterToggle" Content="Water" Padding="6,2" IsChecked="True" />
                        </StackPanel>

                        <TextBlock Text="Pxl 24×24 (1:1)" Foreground="#DDD" />
                        <Border Background="#000" Padding="2" HorizontalAlignment="Left">
                            <Image Name="PxlImage1x" Width="24" Height="24"
                                   RenderOptions.BitmapInterpolationMode="None"
                                   Stretch="None" />
                        </Border>

                        <TextBlock Text="Pxl 24×24 (LED preview)" Foreground="#DDD" />
                        <Border Background="#000" Padding="2" HorizontalAlignment="Left">
                            <Image Name="PxlImage10x" Width="240" Height="240"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   Stretch="Uniform" />
                        </Border>

                        <TextBlock Name="ParseStatus" Foreground="#FFA" TextWrapping="Wrap" />

                        <!-- Material color pickers -->
                        <Border Height="1" Background="#333" />
                        <TextBlock Text="Materials" Foreground="#DDD" FontWeight="Bold" />
                        <TextBlock Text="Click swatches to edit colors. Save... writes a new .vox."
                                   Foreground="#999" FontSize="11" TextWrapping="Wrap" />
                        <StackPanel Name="MaterialsPanel" Spacing="6" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Vox text editor -->
            <Border Grid.Column="3" Background="#0D0F12" Padding="6">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Vox source (live re-parse on edit)"
                               Foreground="#DDD" Margin="2,0,2,6" />
                    <TextBox Grid.Row="1" Name="VoxEditor" AcceptsReturn="True"
                             AcceptsTab="True" FontFamily="Menlo,Consolas,monospace"
                             FontSize="12" Background="#13161A" Foreground="#DDD"
                             BorderThickness="0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
