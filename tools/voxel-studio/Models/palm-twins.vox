# Palm Island #2 — TWIN BUMPS (54 × 18 × 11)
# Two distinct rounded island bumps connected by a thin sand bridge,
# like a barbell or peanut shape. The west bump is bigger and taller,
# the east bump smaller and lower. Solid geometry, no isolated pixels.

material sand     top=#F4E0A0  front=#A89060  side=#705D40
material sandwet  top=#E8C880  front=#9C7E48  side=#6A5630
material grass    top=#5A8E32  front=#365A1E  side=#243D14
material trunk    top=#8C5A2E  front=#5A3818  side=#3A2410
material frond    top=#3FB048  front=#1E7028  side=#104818
material frondlt  top=#62E03A  front=#3A8E20  side=#2C7018
material coconut  top=#5A4030  front=#3A271A  side=#251910
material rock     top=#8E785A  front=#5C4F3D  side=#3F362A

# ============================================================================
# WEST BUMP — bigger, taller
# Footprint built from concentric overlapping bands → soft round contour
# ============================================================================
# Outer ring
box 7 1 6    21 1 11   sand
box 8 1 5    20 1 12   sand
box 10 1 4   18 1 13   sand
box 12 1 3   16 1 14   sand
# Higher mound
box 9 2 6    19 2 11   sand
box 11 2 5   17 2 12   sand
box 13 2 4   15 2 13   sand
# Grass cap
box 11 3 6   17 3 11   grass
box 12 3 5   16 3 12   grass
box 13 4 7   15 4 10   grass

# ============================================================================
# SANDBAR — narrow connector between the two bumps
# ============================================================================
box 21 1 8    32 1 9    sand
box 22 1 7    31 1 10   sand
# Slight crown so it reads as raised land
box 24 2 8    29 2 9    sand

# ============================================================================
# EAST BUMP — smaller, lower
# ============================================================================
box 30 1 6    44 1 11   sand
box 31 1 5    43 1 12   sand
box 33 1 4    41 1 13   sand
box 35 1 3    39 1 14   sand
# Higher mound (smaller crown)
box 32 2 6    42 2 11   sand
box 34 2 5    40 2 12   sand
box 36 2 4    38 2 13   sand
# Grass cap (just a touch)
box 34 3 7    40 3 10   grass
box 36 3 6    38 3 11   grass

# ============================================================================
# WET SAND fringe at waterlines
# ============================================================================
box 7 1 6    7 1 11    sandwet
box 21 1 6   21 1 11   sandwet
box 30 1 6   30 1 11   sandwet
box 44 1 6   44 1 11   sandwet

# ============================================================================
# PALM TREES — west bump (bigger, 3 palms)
# 2x2 trunks for solid look
# ============================================================================

# ---- Palm A: tall central palm on west grass cap ----
box 13 1 8    14 8 9    trunk
box 13 9 8    14 9 9    trunk
box 10 9 8    17 9 9    frond
box 13 9 6    14 9 11   frond
box 12 10 8   15 10 9   frondlt
box 13 10 7   14 10 10  frondlt
v 13 11 8   frondlt
v 14 11 9   frondlt
v 12 8 8   coconut
v 15 8 9   coconut

# ---- Palm B: smaller, leaning west on west bump ----
box 9 1 9    10 5 10   trunk
box 7 6 9   12 6 10   frond
box 9 6 7   10 6 12   frond
box 8 7 9   11 7 10   frondlt
v 9 8 9   frondlt
v 10 8 10  frondlt
v 8 5 9   coconut

# ---- Palm C: north side of west bump ----
box 16 1 11   17 4 12   trunk
box 14 5 11   19 5 12   frond
box 16 5 9    17 5 14   frond
v 16 6 11  frondlt
v 17 6 12  frondlt
v 17 4 12  coconut

# ============================================================================
# PALM TREES — east bump (2 palms)
# ============================================================================

# ---- Palm D: main palm on east bump ----
box 36 1 8    37 6 9    trunk
box 33 7 8    40 7 9    frond
box 36 7 5    37 7 12   frond
box 35 8 8    38 8 9    frondlt
v 36 9 8   frondlt
v 37 9 9   frondlt
v 35 6 8   coconut
v 38 6 9   coconut

# ---- Palm E: small east-side palm ----
box 41 1 9    42 4 10   trunk
box 39 5 9   44 5 10   frond
box 41 5 8   42 5 11   frond
v 41 6 9   frondlt
v 42 6 9   frondlt

# ============================================================================
# A few rocks at the sandbar edges (where waves would wash over)
# ============================================================================
box 25 1 7    27 1 7    rock
box 25 1 10   27 1 10   rock
box 5 1 8    6 1 9    rock
box 45 1 8   46 1 9   rock
