# Maya Temple — LONG along X (40 wide × 16 deep × 18 high)
# A great stepped pyramid (6 layers, central staircase, roof comb on top)
# rises out of dense jungle, with a smaller adjacent temple to the right.
# A wide stone plaza in front, ceiba trees with broad green crowns, and
# a small jungle stream/cenote on the lower-left corner.

material limestone top=#C4B89E  front=#827964  side=#564F40
material limeshade top=#9C9078  front=#665F4A  side=#403B2E
material weathered top=#7E7460  front=#52493A  side=#332E22
material plaza     top=#D8CDB0  front=#8E8669  side=#605948
material jungle    top=#1F4A2A  front=#0E2E16  side=#0A1F0E   # dark canopy
material canopy    top=#2E6E3A  front=#194824  side=#102E16   # lighter canopy
material trunk     top=#5A4030  front=#3A271A  side=#251910
material vine      top=#3A6E32  front=#1E481E  side=#103014
material water     top=#3FA0A8  front=#1F6E76  side=#124448   # cenote
material altar     top=#A82E1F  front=#6E1E14  side=#4A140C   # red painted accent
material gold      top=#F2C738  front=#9F731A  side=#7A5612

# ============================================================================
# JUNGLE FLOOR — base layer of dark green
# ============================================================================
box 0 0 0   39 0 15   jungle

# ============================================================================
# STONE PLAZA — wide flat area in front of the pyramid (irregular edges)
# ============================================================================
box 4 0 4   28 0 11   plaza
box 6 0 3   26 0 12   plaza
box 8 0 2   24 0 13   plaza

# ============================================================================
# GREAT PYRAMID — 6 stepped layers, base at x=10..22, z=4..10
# Central staircase runs up the front face (z=3 side, narrow gap)
# ============================================================================
# Layer 1 (base, widest)
box 10 1 4   22 1 10   limestone
# Layer 2
box 11 2 5   21 2 9    limestone
# Layer 3
box 12 3 5   20 3 9    limestone
# Layer 4
box 13 4 6   19 4 8    limestone
# Layer 5
box 14 5 6   18 5 8    limestone
# Layer 6 (top platform)
box 15 6 6   17 6 8    limestone

# ---- Temple atop the pyramid ----
box 15 7 6   17 9 8    limestone
# Doorway (dark recess)
v 16 7 6   weathered
v 16 8 6   weathered
# Roof of the temple
box 14 10 6  18 10 8   limestone

# ---- Roof comb (the iconic ornamental crest above Maya temples) ----
box 15 11 6  17 11 8   limestone
box 15 12 6  17 12 8   limestone
v 15 13 7   limestone
v 16 13 7   limestone
v 17 13 7   limestone
v 16 14 7   limestone
v 16 15 7   altar       # red-painted finial
v 16 16 7   gold        # gold tip

# ---- Central staircase (front face, z=3..4 carved into each layer) ----
# Each layer has a step protruding forward
box 15 1 3   17 1 3   limestone
box 15 2 4   17 2 4   limestone
box 15 3 4   17 3 4   limeshade
box 15 4 5   17 4 5   limestone
box 15 5 5   17 5 5   limeshade
box 15 6 5   17 6 5   limestone

# Shadow accent on the side faces of each layer (alternate darker color)
box 11 2 4   21 2 4   limeshade    # front face shadow on layer 2
box 12 3 4   20 3 4   limeshade    # layer 3
box 13 4 5   19 4 5   limeshade    # layer 4
box 14 5 5   18 5 5   limeshade    # layer 5

# Red altar at the base of the staircase
v 15 1 2   altar
v 16 1 2   altar
v 17 1 2   altar

# ============================================================================
# SMALLER ADJACENT TEMPLE — to the right of the great pyramid (x=25..30)
# A 3-layer pyramid with a single chamber on top
# ============================================================================
box 25 1 5   30 1 10   limestone
box 26 2 6   29 2 9    limestone
box 27 3 6   29 3 8    limestone
# Chamber
box 27 4 6   29 5 8    limestone
v 28 4 6   weathered    # doorway
# Flat roof
box 27 6 6   29 6 8    limestone
# Small staircase
v 27 1 4   limestone
v 28 1 4   limestone
v 27 2 5   limestone
v 28 2 5   limestone
v 27 3 5   limeshade

# ============================================================================
# CENOTE / JUNGLE POOL on the lower-left corner (x=0..4, z=0..3)
# ============================================================================
box 0 0 0   4 0 3   water
# Stone rim around the cenote
v 0 1 3   limestone
v 1 1 3   limestone
v 2 1 3   limestone
v 3 1 3   limestone
v 4 1 0   limestone
v 4 1 1   limestone
v 4 1 2   limestone
v 4 1 3   limestone
v 5 0 0   plaza
v 5 0 1   plaza
v 5 0 2   plaza
v 5 0 3   plaza

# ============================================================================
# CEIBA TREES — large jungle canopies surrounding the pyramid
# ============================================================================
# Tree 1 (back-left)
box 3 1 13   3 4 13   trunk
box 1 5 11   5 5 15   canopy
box 2 6 12   4 6 14   canopy
v 3 7 13   canopy

# Tree 2 (back-right)
box 35 1 13  35 4 13  trunk
box 33 5 11  37 5 15  canopy
box 34 6 12  36 6 14  canopy
v 35 7 13  canopy

# Tree 3 (right side, between temples and jungle)
box 33 1 6   33 5 6   trunk
box 31 6 4  35 6 8    canopy
box 32 7 5  34 7 7    canopy
v 33 8 6   canopy

# Tree 4 (left side, near pyramid)
box 7 1 6   7 4 6    trunk
box 5 5 4  9 5 8     canopy
box 6 6 5  8 6 7     canopy
v 7 7 6   canopy

# Tree 5 (front-left, beyond plaza)
box 2 1 1   2 3 1    trunk
box 0 4 0  4 4 3     canopy
v 2 5 1   canopy
v 1 5 1   canopy
v 3 5 1   canopy

# Tree 6 (front-right, beyond plaza)
box 36 1 2   36 3 2  trunk
box 34 4 0  38 4 4   canopy
v 36 5 2   canopy

# ============================================================================
# Smaller jungle bushes / ground vegetation around the plaza edges
# ============================================================================
v 5 1 12   canopy
v 9 1 13   canopy
v 27 1 13  canopy
v 31 1 12  canopy
v 31 1 2   canopy
v 36 1 14  canopy
v 38 1 8   canopy
v 38 1 5   canopy
v 1 1 6    canopy
v 1 1 9    canopy

# Vines hanging on the back/sides of the pyramid
v 10 2 10  vine
v 10 3 10  vine
v 22 2 10  vine
v 11 2 4   vine
v 21 2 4   vine
v 12 3 9   vine
v 20 3 9   vine

# A small stone stela (carved standing slab) in front of the plaza
box 16 1 11  16 3 11  limestone
v 16 4 11   altar     # red painted top

# A second stela on the other side
box 14 1 11  14 2 11  limestone
v 14 3 11   altar
