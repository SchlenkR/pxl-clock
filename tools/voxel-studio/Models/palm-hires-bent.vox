# Palm Hi-Res Bent — leaning palm with proper plate-fronds + up/down mix
# 50 × 30 × 30
# Trunk arcs in stepped offsets. Real round 6×6 octagonal cross-section.
# Crown: 4 cardinal drooping plates + 4 diagonal upright fronds.

material sand    top=#FFE5B0  front=#A88B52  side=#7E6740
material wetsand top=#E8C880  front=#9C7E48  side=#6A5630
material grass   top=#5AA830  front=#345E1A  side=#21401A
material trunk   top=#9C5E32  front=#6E3F1C  side=#3A2210
material frond   top=#7AE040  front=#3D8B22  side=#1F5A18
material coco    top=#5A3418  front=#36200E  side=#23150A
material driftwood top=#A07A50  front=#634A2E  side=#3F2D18
material shell   top=#F4D8C8  front=#A89282  side=#766860
material pebble  top=#8E7E68  front=#544738  side=#372C20

# ============================================================================
# SAND BANK — 40 × 20, 3 voxels tall
# ============================================================================
box 4 0 5    44 0 22   sand
box 6 0 4    42 0 23   sand
box 9 0 3    39 0 24   sand
box 12 0 2   36 0 25   sand
box 6 1 6    42 1 21   sand
box 9 1 5    39 1 22   sand
box 13 1 4   35 1 23   sand
box 9 2 7    39 2 20   sand
box 12 2 6   36 2 21   sand
box 7 3 11   13 3 16   sand
box 8 4 12   12 4 15   sand

v 4 0 13    wetsand
v 4 0 14    wetsand
v 44 0 13   wetsand
v 44 0 14   wetsand
v 16 1 6    pebble
v 32 1 18   pebble
box 30 1 18   38 1 19   driftwood
v 18 1 19   shell
v 35 1 22   shell

# ============================================================================
# CURVED ROUND 6×6 TRUNK — base (8..13), slides +X with height
# ============================================================================
box 10 4 11    11 6 11   trunk
box 9  4 12    12 6 12   trunk
box 8  4 13    13 6 14   trunk
box 9  4 15    12 6 15   trunk
box 10 4 16    11 6 16   trunk

box 11 7 11    12 10 11  trunk
box 10 7 12    13 10 12  trunk
box 9  7 13    14 10 14  trunk
box 10 7 15    13 10 15  trunk
box 11 7 16    12 10 16  trunk

box 12 11 11   13 13 11  trunk
box 11 11 12   14 13 12  trunk
box 10 11 13   15 13 14  trunk
box 11 11 15   14 13 15  trunk
box 12 11 16   13 13 16  trunk

box 13 14 11   14 18 11  trunk
box 12 14 12   15 18 12  trunk
box 11 14 13   16 18 14  trunk
box 12 14 15   15 18 15  trunk
box 13 14 16   14 18 16  trunk

# Root flare
v 7 4 13   trunk
v 7 4 14   trunk
v 8 4 10   trunk
v 13 4 10  trunk

# ============================================================================
# COCONUT CLUSTERS — hanging at trunk top (centred at 13.5, 18, 13.5)
# ============================================================================
v 16 17 13  coco
v 16 17 14  coco
v 16 16 14  coco
v 11 17 13  coco
v 11 17 14  coco
v 13 17 11  coco
v 14 17 16  coco

# ============================================================================
# CARDINAL FRONDS — wide drooping leaf plates (trunk top y=18)
# rise +1 to peak at y=20, drop to tip at y=14
# ============================================================================

# +X
box 16 19 13   16 19 14   frond
box 17 20 12   17 20 15   frond
box 18 20 12   18 20 15   frond
box 19 19 13   19 19 14   frond
box 20 18 12   20 18 15   frond
box 21 17 13   21 17 14   frond
box 22 16 13   22 16 14   frond
box 23 15 13   23 15 14   frond
box 24 14 13   24 14 14   frond     # spitz tip

# -X
box 11 19 13   11 19 14   frond
box 10 20 12   10 20 15   frond
box 9  20 12   9  20 15   frond
box 8  19 13   8  19 14   frond
box 7  18 12   7  18 15   frond
box 6  17 13   6  17 14   frond
box 5  16 13   5  16 14   frond
box 4  15 13   4  15 14   frond
box 3  14 13   3  14 14   frond

# +Z
box 13 19 17   14 19 17   frond
box 12 20 18   15 20 18   frond
box 12 20 19   15 20 19   frond
box 13 19 20   14 19 20   frond
box 12 18 21   15 18 21   frond
box 13 17 22   14 17 22   frond
box 13 16 23   14 16 23   frond
box 13 15 24   14 15 24   frond

# -Z
box 13 19 10   14 19 10   frond
box 12 20 9    15 20 9    frond
box 12 20 8    15 20 8    frond
box 13 19 7    14 19 7    frond
box 12 18 6    15 18 6    frond
box 13 17 5    14 17 5    frond
box 13 16 4    14 16 4    frond
box 13 15 3    14 15 3    frond

# ============================================================================
# DIAGONAL FRONDS — UPRIGHT (point UP, rise then mild droop)
# ============================================================================

# NE (+X +Z) — upright
box 16 19 16   17 19 17    frond
box 17 20 17   18 20 18    frond
box 18 21 18   19 21 19    frond
box 19 22 19   20 22 20    frond     # PEAK high
box 20 21 20   21 21 21    frond     # mild drop
v 21 20 22  frond
v 22 19 23  frond                     # tip

# NW (-X +Z) — upright
box 10 19 16   11 19 17    frond
box 9  20 17   10 20 18    frond
box 8  21 18   9  21 19    frond
box 7  22 19   8  22 20    frond     # PEAK high
box 6  21 20   7  21 21    frond
v 5 20 22   frond
v 4 19 23   frond

# SE (+X -Z) — upright
box 16 19 10   17 19 11    frond
box 17 20 9    18 20 10    frond
box 18 21 8    19 21 9     frond
box 19 22 7    20 22 8     frond     # PEAK
box 20 21 6    21 21 7     frond
v 21 20 5   frond
v 22 19 4   frond

# SW (-X -Z) — upright
box 10 19 10   11 19 11    frond
box 9  20 9    10 20 10    frond
box 8  21 8    9  21 9     frond
box 7  22 7    8  22 8     frond     # PEAK
box 6  21 6    7  21 7     frond
v 5 20 5    frond
v 4 19 4    frond

