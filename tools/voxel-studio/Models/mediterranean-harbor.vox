# Mediterranean Harbor — LONG along the X axis (38 wide × 14 deep × 16 high)
# Stone harbor wall along the front (z=0..2), then a promenade with three
# whitewashed houses (Santorini-style with blue domes), olive trees,
# stairs leading down to the water, and a lone Greek column on a small
# acropolis at the right end.

material stone    top=#D8D2C0  front=#8E866F  side=#5F584A
material steptop  top=#E8E2D0  front=#9E967F  side=#6F685A
material wallw    top=#F4F0E8  front=#A8A39A  side=#7A746E   # whitewash
material doorblue top=#1E5C9C  front=#0F365E  side=#072036
material dome     top=#3672B8  front=#1A4880  side=#0E2D55
material roof     top=#C04A38  front=#7A2D1E  side=#4F1C12   # terracotta tiles
material olivelf  top=#7A9248  front=#4A5E26  side=#2F3D17
material olivetrk top=#5A4030  front=#3A271A  side=#251910
material colmar   top=#F0EBE0  front=#A8A199  side=#76716A   # marble column
material gold     top=#F2C738  front=#9F731A  side=#7A5612

# ============================================================================
# HARBOR WALL — runs the full length, 2 voxels tall, stone
# ============================================================================
box 0 1 1   37 2 1   stone        # outer face on the waterline
box 0 1 2   37 1 2   steptop      # promenade-level capstone

# Steps down to water at x=12..14 (3 wide gap in wall + steps)
box 12 1 1   14 1 1   steptop     # step 1
box 12 0 1   14 0 1   stone       # base
v 12 0 0   stone
v 13 0 0   stone
v 14 0 0   stone

# ============================================================================
# PROMENADE STONE GROUND (y=2, z=2..6) — slightly inset from the harbor wall
# ============================================================================
box 0 2 2   37 2 6   steptop

# ============================================================================
# HOUSE 1 (left, x=2..7) — small white cube with blue dome
# ============================================================================
box 2 3 3   7 6 6   wallw         # walls (4 tall)
box 2 7 3   7 7 6   wallw         # flat roof
v 4 3 3   doorblue                # door (blue)
v 5 3 3   doorblue
v 3 5 3   doorblue                # window
v 6 5 3   doorblue
# Blue dome on top
box 3 8 4   6 8 5   dome
v 4 9 4   dome
v 5 9 4   dome
v 4 9 5   dome
v 5 9 5   dome

# ============================================================================
# HOUSE 2 (middle, x=11..17) — taller, terracotta roof
# ============================================================================
box 11 3 3   17 7 6   wallw       # walls 5 tall
v 13 3 3   doorblue                # door
v 14 3 3   doorblue
v 12 5 3   doorblue                # windows
v 16 5 3   doorblue
v 13 6 3   doorblue
v 15 6 3   doorblue
# Pitched terracotta roof (stepped pyramid)
box 11 8 3   17 8 6   roof
box 12 9 3   16 9 6   roof
box 13 10 3  15 10 6   roof
v 14 11 4   roof
v 14 11 5   roof

# ============================================================================
# HOUSE 3 (right, x=21..26) — white with smaller blue dome
# ============================================================================
box 21 3 3   26 6 6   wallw
box 21 7 3   26 7 6   wallw
v 23 3 3   doorblue
v 24 3 3   doorblue
v 22 5 3   doorblue
v 25 5 3   doorblue
# Small dome
box 22 8 4   25 8 5   dome
v 23 9 4   dome
v 24 9 4   dome
v 23 9 5   dome
v 24 9 5   dome

# ============================================================================
# OLIVE TREES — between the houses
# ============================================================================
# Tree 1 (between house 1 and 2, x=9)
box 9 3 4   9 5 4   olivetrk
box 8 6 4   10 6 5   olivelf
v 9 7 4   olivelf
# Tree 2 (between house 2 and 3, x=19)
box 19 3 4   19 5 4   olivetrk
box 18 6 4   20 6 5   olivelf
v 19 7 4   olivelf

# ============================================================================
# RIGHT END — small acropolis with a lone marble column (x=29..36)
# ============================================================================
# Stepped white-marble base
box 29 3 3   35 3 6   colmar
box 30 4 3   34 4 6   colmar
box 31 5 3   33 5 6   colmar
# Single column
box 32 6 4   32 11 4   colmar
# Capital
v 31 12 4   colmar
v 32 12 4   colmar
v 33 12 4   colmar
v 31 12 3   colmar
v 31 12 5   colmar
v 33 12 3   colmar
v 33 12 5   colmar
# Gold finial atop
v 32 13 4   gold
