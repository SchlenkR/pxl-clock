# Palm Hi-Res Grove — three palms with proper plate-fronds
# 60 × 50 × 32
# Big palm (6×6 trunk): full leaf plates + upright diagonals
# Medium palm (5×5 trunk): smaller plates
# Small palm (4×4 trunk): compact crown

material sand    top=#FFE5B0  front=#A88B52  side=#7E6740
material wetsand top=#E8C880  front=#9C7E48  side=#6A5630
material grass   top=#5AA830  front=#345E1A  side=#21401A
material trunk   top=#9C5E32  front=#6E3F1C  side=#3A2210
material frond   top=#7AE040  front=#3D8B22  side=#1F5A18
material coco    top=#5A3418  front=#36200E  side=#23150A
material rock    top=#7E7060  front=#4F4438  side=#332A22

# ============================================================================
# ISLAND — 50 × 35
# ============================================================================
box 6 0 9    52 0 38   sand
box 9 0 7    49 0 40   sand
box 13 0 5   45 0 42   sand
box 18 0 4   40 0 43   sand
box 9 1 10   49 1 37   sand
box 13 1 8   45 1 39   sand
box 18 1 6   40 1 41   sand
box 13 2 11  45 2 36   sand
box 18 2 9   40 2 38   sand
box 18 3 12  40 3 35   grass
box 22 3 10  36 3 37   grass

v 6 0 22    wetsand
v 6 0 25    wetsand
v 52 0 22   wetsand
v 52 0 25   wetsand
v 18 0 4    wetsand
v 40 0 4    wetsand
v 18 0 43   wetsand
v 40 0 43   wetsand
box 12 1 18  13 2 19   rock
box 46 1 28  47 2 29   rock

# ============================================================================
