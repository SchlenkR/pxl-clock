# Viking longship — LONG along the X axis (30 wide × 9 deep × 12 high)
# Dragon head at the bow (x=0), raised stern (x=29), tall mast in the
# middle with a striped square sail, and a row of shields on each side.

material wood     top=#8B5A2B  front=#5C3A1A  side=#3F260E
material plank    top=#A8744D  front=#6F4A2C  side=#4A311B
material shield   top=#C82828  front=#8C1E1E  side=#5C1414
material gold     top=#F2C738  front=#9F731A  side=#7A5612
material sail     top=#F4F0E0  front=#A8A18A  side=#7A745E

# ---- Hull (clinker-built, 3 layers, tapered ends)
box 3 2 3   26 2 5   plank        # bottom
box 2 3 3   27 3 5   plank        # mid (slightly longer)
box 1 4 3   28 4 5   plank        # top deck rim
# Centerline keel underneath
box 4 1 4   25 1 4   wood

# Bow (front, x=0..2) — sharp taper to a point
v 2 3 4   plank
v 1 4 4   plank
v 0 4 4   plank

# Stern (back, x=27..29) — taper + raised post
v 27 3 4   plank
v 28 4 4   plank
v 29 4 4   plank
v 29 5 4   wood
v 29 6 4   wood

# ---- Dragon head at the bow (gold, curling forward)
v 0 5 4   gold
v 0 6 4   gold
v -1 6 4  gold
v -1 7 4  gold
v 0 7 4   gold
v 0 8 4   gold     # tip of head looking up

# ---- Mast (centered)
box 14 5 4   14 10 4   wood
# Yard (horizontal beam at top)
box 10 10 4   18 10 4   wood

# ---- Sail (striped red & white)
box 10 6 4   18 9 4   sail
box 10 7 4   18 7 4   shield
box 10 9 4   18 9 4   shield

# ---- Shields hanging on the sides (alternating red would need extra mat —
# keeping single-color for compactness)
v 4 3 2    shield
v 7 3 2    shield
v 10 3 2   shield
v 13 3 2   shield
v 16 3 2   shield
v 19 3 2   shield
v 22 3 2   shield
v 25 3 2   shield
v 4 3 6    shield
v 7 3 6    shield
v 10 3 6   shield
v 13 3 6   shield
v 16 3 6   shield
v 19 3 6   shield
v 22 3 6   shield
v 25 3 6   shield

# ---- Two oars sticking out (decorative)
v 8 3 1   wood
v 18 3 7  wood
