# Palm Duo — two palms on a longer sand bank, like a couple
# Big palm on the left, smaller cousin on the right.

material sand    top=#FFE5B0  front=#A88B52  side=#7E6740
material wetsand top=#E8C880  front=#9C7E48  side=#6A5630
material trunk   top=#7C4828  front=#4F2E14  side=#3A2210
material trunkhi top=#A56838  front=#6E3F1C  side=#4A2A14
material frondlt top=#7AE040  front=#3D8B22  side=#225E15
material frond   top=#3D8B22  front=#225E15  side=#163E0E
material rock    top=#8E7E68  front=#544738  side=#372C20
material coco    top=#523018  front=#2E1A0C  side=#1A0F06

# ============================================================================
# Long sand bank, 18 wide × 6 deep
# ============================================================================
box 1 0 1   16 0 4   sand
box 2 0 0   15 0 5   sand
box 0 0 2   17 0 3   sand
box 0 0 1   0 0 1    wetsand
box 0 0 4   0 0 4    wetsand
box 17 0 1  17 0 1   wetsand
box 17 0 4  17 0 4   wetsand

# Two raised mounds (one per palm)
box 3 1 1   7 1 4    sand
box 4 1 0   6 1 5    sand
box 4 2 1   6 2 4    sand        # left mound apex

box 11 1 1  14 1 4   sand
box 12 1 0  13 1 5   sand
v 12 2 2  sand                    # tiny right mound

# Rock between the palms (visual interest)
box 9 0 2   10 1 3   rock

# ============================================================================
# LEFT PALM (the "big" one) — 2×2 trunk, 7 tall, fluffy crown
# ============================================================================
box 4 3 2   5 9 3   trunk
v 5 4 3  trunkhi
v 5 6 3  trunkhi
v 5 8 3  trunkhi
# Crown
box 1 10 2   8 10 3  frond
box 4 10 0   5 10 5  frond
box 2 10 1   7 10 4  frond
box 3 10 1   6 10 4  frondlt
box 2 11 1   7 11 4  frondlt
box 3 11 0   6 11 5  frondlt
box 4 11 2   5 11 3  frondlt
box 4 12 2   5 12 3  frondlt
v 2 10 2  coco
v 7 10 3  coco

# ============================================================================
# RIGHT PALM (the "small" one) — 2×2 trunk, 5 tall, smaller crown
# ============================================================================
box 12 3 2  13 7 3  trunk
v 13 4 3  trunkhi
v 13 6 3  trunkhi
# Crown
box 10 8 2  15 8 3  frond
box 12 8 1  13 8 4  frond
box 11 8 2  14 8 3  frondlt
box 12 8 1  13 8 4  frondlt
box 11 9 2  14 9 3  frondlt
box 12 9 1  13 9 4  frondlt
box 12 10 2 13 10 3 frondlt
v 10 8 3  coco
