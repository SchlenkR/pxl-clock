# Acropolis (Parthenon-style) — RECTANGULAR peripteral temple.
# Footprint 5 wide × 9 deep (long sides facing left/right in default yaw).
# 12 marble columns: 3 short ends + 3 mid-side each (no corner double-count)
# Triangular pediments on the short ends, sloped tile roof in between.

material sandstone   top=#FFE5B0   front=#A88B52   side=#7E6740
material marble      top=#F5F2EA   front=#A8A39A   side=#6B6660
material rooftile    top=#9E3A28   front=#5C2418   side=#3F1A12
material gold        top=#F2C738   front=#9F731A   side=#7A5612

# ---- Stylobate (single platform 5×1×9)
box 0 0 0   4 0 8   sandstone

# ---- Peripteral columns (12 marble columns, 3 voxels tall, y=1..3)
# Front short end (z=0)
box 0 1 0   0 3 0   marble
box 2 1 0   2 3 0   marble
box 4 1 0   4 3 0   marble
# Back short end (z=8)
box 0 1 8   0 3 8   marble
box 2 1 8   2 3 8   marble
box 4 1 8   4 3 8   marble
# Left long side (x=0, no corners)
box 0 1 2   0 3 2   marble
box 0 1 4   0 3 4   marble
box 0 1 6   0 3 6   marble
# Right long side (x=4, no corners)
box 4 1 2   4 3 2   marble
box 4 1 4   4 3 4   marble
box 4 1 6   4 3 6   marble

# ---- Architrave (5×1×9 cap on top of all columns)
box 0 4 0   4 4 8   sandstone

# ---- Pediment + roof, 3 rows (y=5..7).
# Pediments on the SHORT ends (z=0 and z=8). Roof is sloped tiles between.
# Row y=5: pediment base (5 wide) + roof base (5 wide × 7 deep)
box 0 5 0   4 5 0   sandstone
box 0 5 8   4 5 8   sandstone
box 0 5 1   4 5 7   rooftile

# Row y=6: pediment narrows to 3 wide + roof narrows
box 1 6 0   3 6 0   sandstone
box 1 6 8   3 6 8   sandstone
box 1 6 1   3 6 7   rooftile

# Row y=7: pediment apex + roof ridge along z
v 2 7 0   sandstone
v 2 7 8   sandstone
box 2 7 1   2 7 7   rooftile

# ---- Akroterion (gold finials on the pediment apexes)
v 2 8 0   gold
v 2 8 8   gold
