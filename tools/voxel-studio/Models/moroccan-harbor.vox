# Moroccan Harbor — LONG along X (46 wide × 16 deep × 16 high)
# A fortified medina (white cube cluster with cobalt-blue accents) sits
# on the right half of the scene; a long sandy harbor mole/pier juts out
# into the sea on the left as an outrigger; a single tall minaret rises
# above the rooftops; small fishing boats moor in the protected harbor.

material wall      top=#C9A876  front=#866F4A  side=#5A4A30   # sandstone fortress
material wallshade top=#A48758  front=#6E5A3A  side=#4A3D26
material whitew    top=#F2EDE0  front=#A89F92  side=#766F66   # whitewashed cube
material cobalt    top=#1E5AA8  front=#0E3672  side=#062448   # door/window blue
material roofflat  top=#D8C8A8  front=#8E8068  side=#605642   # flat sand-color roof
material domeg    top=#3A8E58  front=#1E5A30  side=#10381E    # green dome (mosque)
material gold      top=#F2C738  front=#9F731A  side=#7A5612
material wood      top=#7A4A22  front=#4C2D14  side=#321D0C
material palmtrk   top=#9C5C32  front=#603418  side=#42230F
material palmfrnd  top=#62E03A  front=#3A8E20  side=#2C7018
material stone     top=#9A8E76  front=#615847  side=#3E382C

# ============================================================================
# HARBOR MOLE — long thin sandy outrigger juts from upper-left to right
# Curves slightly to enclose the harbor
# ============================================================================
# Main shaft of the mole (runs from x=2 at the back-left, curving forward)
box 2 1 13   12 2 14   wall      # back-anchored mole, 2 voxels tall
box 2 1 12   12 1 12   wall      # rim
box 13 1 11  18 2 12   wall      # mole curves forward
box 17 1 9   22 2 10   wall      # tip curves more
box 20 1 7   23 2 8    wall      # tip
v 23 1 6    wall                  # very tip
v 22 1 6    wall

# Lighthouse stub at the very tip
box 22 3 7   23 6 8   whitew
v 22 7 7   cobalt
v 22 7 8   cobalt
v 23 7 7   cobalt
v 23 7 8   cobalt
v 22 8 7   gold
v 22 8 8   gold

# Stone bollards along the mole
v 4 3 12   stone
v 8 3 12   stone
v 12 3 11  stone
v 17 3 10  stone

# A small fishing boat moored against the inner mole
box 5 1 10   8 1 11   wood       # hull
v 6 2 10   wood                    # mast base
v 6 3 10   wood
v 6 4 10   wood

# ============================================================================
# CITY WALL — fortified sandstone wall on the harbor side (x=27..28)
# Battlements (crenellations) on top
# ============================================================================
box 27 1 3   28 6 13   wall
# Crenellations along the top of the wall
v 27 7 3   wall
v 27 7 5   wall
v 27 7 7   wall
v 27 7 9   wall
v 27 7 11  wall
v 27 7 13  wall
v 28 7 3   wall
v 28 7 5   wall
v 28 7 7   wall
v 28 7 9   wall
v 28 7 11  wall
v 28 7 13  wall

# Harbor gate (cobalt-blue arch in the city wall)
v 27 1 8   cobalt
v 28 1 8   cobalt
v 27 2 8   cobalt
v 28 2 8   cobalt
v 27 3 8   cobalt
v 28 3 8   cobalt

# Wall corner towers (taller, square)
box 27 1 2   28 9 3   wall
v 27 10 2   wall
v 27 10 3   wall
v 28 10 2   wall
v 28 10 3   wall

box 27 1 13  28 9 14  wall
v 27 10 13  wall
v 27 10 14  wall
v 28 10 13  wall
v 28 10 14  wall

# ============================================================================
# MEDINA — packed cluster of whitewashed cubes on the right (x=29..43)
# Varying heights to feel organic, a few cobalt accents
# ============================================================================
# Ground level (sand floor inside the walls)
box 29 1 2   43 1 14   wall

# Cube cluster — irregular heights
box 29 2 3   31 5 6    whitew
box 32 2 3   34 4 5    whitew
box 35 2 3   37 6 5    whitew
box 29 2 7   32 7 9    whitew    # taller
box 33 2 6   36 5 8    whitew
box 37 2 6   40 4 9    whitew
box 29 2 10  31 5 12   whitew
box 32 2 10  35 6 13   whitew
box 36 2 10  40 4 13   whitew
box 41 2 4   43 5 12   whitew

# Flat sandy rooftops on top of some cubes
box 29 6 3   31 6 6   roofflat
box 35 7 3   37 7 5   roofflat
box 33 6 6   36 6 8   roofflat
box 32 7 10  35 7 13  roofflat
box 41 6 4   43 6 12  roofflat

# Cobalt-blue doors and windows scattered through the medina
v 29 2 4   cobalt
v 32 2 4   cobalt
v 35 2 4   cobalt
v 29 4 3   cobalt
v 35 4 3   cobalt
v 29 2 8   cobalt
v 33 2 7   cobalt
v 37 2 7   cobalt
v 29 4 7   cobalt
v 32 4 7   cobalt
v 29 2 11  cobalt
v 32 2 11  cobalt
v 36 2 11  cobalt
v 41 2 8   cobalt
v 41 4 8   cobalt

# ============================================================================
# MINARET — tall square tower rising above the medina (x=33..34)
# ============================================================================
box 33 2 11  34 11 12  whitew
v 33 12 11  whitew
v 33 12 12  whitew
v 34 12 11  whitew
v 34 12 12  whitew
# Cobalt arched top window
v 33 9 11   cobalt
v 34 9 11   cobalt
# Domed top with gold finial
box 32 13 10 35 13 13  domeg
box 33 14 11 34 14 12  domeg
v 33 15 11  gold
v 34 15 11  gold

# ============================================================================
# A small green-domed mosque next to the minaret (x=36..40)
# ============================================================================
box 36 5 10  40 7 13   whitew    # raised mosque base (on top of cube)
box 37 8 11  39 8 12   domeg     # green dome
v 38 9 11   domeg
v 38 9 12   domeg
v 38 10 11  gold

# ============================================================================
# PALMS — a few inside the medina
# ============================================================================
box 31 2 14  31 4 14   palmtrk
v 30 5 14   palmfrnd
v 32 5 14   palmfrnd
v 31 5 13   palmfrnd
v 31 6 14   palmfrnd

box 41 2 14  41 4 14   palmtrk
v 40 5 14   palmfrnd
v 42 5 14   palmfrnd
v 41 5 13   palmfrnd
v 41 6 14   palmfrnd

# ============================================================================
# A few rocks/stones along the seaward side of the city wall (breakwater)
# ============================================================================
v 26 1 4   stone
v 26 1 6   stone
v 26 1 9   stone
v 26 1 12  stone
v 25 1 5   stone
v 25 1 11  stone
