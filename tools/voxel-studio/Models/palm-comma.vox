# Palm Island #3 — COMMA / TADPOLE shape (56 × 18 × 11)
# A teardrop / comma island: thick rounded "head" on the left, gradually
# tapering into a long thin "tail" that curves slightly south as it
# extends east. The shape resembles a tadpole or comma. Several palms
# scattered along the body, denser at the head, sparse at the tail.

material sand     top=#F4E0A0  front=#A89060  side=#705D40
material sandwet  top=#E8C880  front=#9C7E48  side=#6A5630
material grass    top=#5A8E32  front=#365A1E  side=#243D14
material trunk    top=#8C5A2E  front=#5A3818  side=#3A2410
material frond    top=#3FB048  front=#1E7028  side=#104818
material frondlt  top=#62E03A  front=#3A8E20  side=#2C7018
material coconut  top=#5A4030  front=#3A271A  side=#251910
material rock     top=#8E785A  front=#5C4F3D  side=#3F362A

# ============================================================================
# COMMA SHAPE — built head→tail with progressively narrower bands
# ============================================================================

# --- HEAD (left, big round blob) ---
box 5 1 6    16 1 12   sand
box 6 1 5    17 1 13   sand
box 7 1 4    18 1 14   sand
box 9 1 3    16 1 15   sand
box 11 1 2   14 1 16   sand    # northern bulge of head

# --- NECK (where head transitions to tail) ---
box 16 1 7    21 1 11   sand
box 17 1 6    22 1 12   sand

# --- BODY (mid-tail, narrowing) ---
box 21 1 7    28 1 11   sand
box 22 1 6    27 1 12   sand
box 24 1 5    26 1 13   sand    # small bump on body

# --- TAIL (curving south, gets thinner) ---
box 27 1 8    35 1 10   sand
box 28 1 7    34 1 11   sand
box 33 1 6    40 1 9    sand    # curve starts (south = down z)
box 38 1 5    44 1 8    sand
box 42 1 5    47 1 7    sand
box 45 1 6    50 1 7    sand    # tail tip

# ============================================================================
# RAISED SAND y=2 — follows the comma but inset
# ============================================================================
box 7 2 6    15 2 12   sand
box 8 2 5    16 2 13   sand
box 11 2 4   14 2 14   sand
box 18 2 8   20 2 10   sand
box 22 2 8   25 2 10   sand
box 28 2 8   32 2 10   sand
box 36 2 6   39 2 8    sand

# ============================================================================
# GRASS on the head
# ============================================================================
box 9 3 6    14 3 12   grass
box 10 3 5   13 3 13   grass
box 11 4 7   13 4 11   grass
v 12 5 9   grass

# ============================================================================
# PALM TREES along the comma — denser at head, sparse at tail
# ============================================================================

# ---- Palm A: tall central palm on head grass mound ----
box 11 1 9    12 8 10   trunk
box 11 9 9    12 9 10   trunk
# Plus-shape canopy
box 8 9 9    15 9 10   frond
box 11 9 6   12 9 13   frond
box 10 10 9  13 10 10  frondlt
box 11 10 8  12 10 11  frondlt
v 11 11 9   frondlt
v 12 11 10  frondlt
v 10 8 9   coconut
v 13 8 10  coconut

# ---- Palm B: leaning west on head ----
box 7 1 8    8 6 9    trunk
box 5 7 8   10 7 9    frond
box 7 7 6    8 7 11   frond
v 7 8 8   frondlt
v 8 8 9   frondlt
v 6 6 8   coconut

# ---- Palm C: north side of head ----
box 13 1 12   14 5 13   trunk
box 11 6 12  16 6 13   frond
box 13 6 10  14 6 15   frond
v 13 7 12  frondlt
v 14 7 13  frondlt

# ---- Palm D: on the body (mid-tail) ----
box 24 1 9    25 6 10   trunk
box 22 7 9    27 7 10   frond
box 24 7 7    25 7 12   frond
v 24 8 9   frondlt
v 25 8 10  frondlt
v 23 6 9   coconut

# ---- Palm E: smaller, on the tail curve ----
box 36 1 7    37 4 8    trunk
box 34 5 7   39 5 8    frond
box 36 5 5   37 5 10   frond
v 36 6 7   frondlt
v 37 6 8   frondlt

# ---- Palm F: lone palm at the very tail tip ----
box 47 1 6    48 3 7    trunk
box 45 4 6   50 4 7    frond
box 47 4 5   48 4 8    frond
v 47 5 6   frondlt
v 48 5 7   frondlt

# ============================================================================
# Rocks scattered along the shoreline
# ============================================================================
box 5 1 8    5 1 10    rock
box 16 1 4   17 1 4    rock
box 30 1 11  31 1 11   rock
box 41 1 4   42 1 5    rock
v 50 1 7   rock
