# Palm Island — SPIRAL / SCROLL (78 × 30 × 14)
# A spiral / scroll-shaped island that curls inward from the right.
# The outer arm extends along the bottom and curves up the left side,
# then arcs back inward, leaving a small enclosed cove in the center.
#
# ROUND TRUNK convention: 4×4 with corners cut → 12 voxels per layer
# (3 box commands per trunk: center 2-wide band + 2 edge columns)

material sand     top=#F4E0A0  front=#A89060  side=#705D40
material sandwet  top=#E8C880  front=#9C7E48  side=#6A5630
material grass    top=#5A8E32  front=#365A1E  side=#243D14
material trunk    top=#8C5A2E  front=#5A3818  side=#3A2410
material frond    top=#3FB048  front=#1E7028  side=#104818
material frondlt  top=#62E03A  front=#3A8E20  side=#2C7018
material coconut  top=#5A4030  front=#3A271A  side=#251910
material rock     top=#8E785A  front=#5C4F3D  side=#3F362A

# ============================================================================
# SPIRAL FOOTPRINT y=1
# Build outer ring → inner curl, leaving a cove in the middle
# ============================================================================

# --- Outer arm: starts bottom-right, runs left along the bottom ---
box 5 1 5    44 1 10   sand
box 8 1 4    40 1 11   sand
box 12 1 3   36 1 12   sand          # widest part of bottom arm

# --- Curves up the left side ---
box 3 1 9    8 1 22    sand
box 1 1 12   7 1 19    sand          # bulges out left
box 4 1 8    9 1 23    sand

# --- Top of spiral arcs back to the right ---
box 5 1 21   38 1 26   sand
box 8 1 22   34 1 27   sand
box 12 1 23  30 1 28   sand          # top edge widens

# --- Inner curl: arcs back inward from the top ---
box 30 1 18  44 1 26   sand          # right wall of spiral
box 33 1 16  46 1 25   sand
box 36 1 14  47 1 24   sand          # widest part of right wall

# --- The curl tucks inward at the right (creates the spiral hook) ---
box 38 1 12  44 1 18   sand          # inward hook
box 40 1 10  44 1 14   sand          # tip of hook curls into the bay

# --- Wet sand fringes ---
box 18 1 11  35 1 11   sandwet       # bay south shore
box 18 1 22  29 1 22   sandwet       # bay north shore
box 18 1 12  18 1 21   sandwet       # bay west shore
box 36 1 12  37 1 17   sandwet       # bay east shore (curl)

# ============================================================================
# RAISED SAND y=2 — interior plateau (follows the spiral shape)
# ============================================================================
box 8 2 5    40 2 9    sand          # bottom arm plateau
box 5 2 10   8 2 21    sand          # left arc plateau
box 8 2 22   34 2 26   sand          # top arm plateau
box 33 2 17  44 2 25   sand          # right wall plateau
box 38 2 13  43 2 17   sand          # hook plateau

# ============================================================================
# GRASS along the high spine of the spiral
# ============================================================================
box 12 3 6   36 3 9    grass         # bottom arm grass
box 5 3 12   7 3 19    grass         # left arc grass
box 12 3 23  30 3 26   grass         # top arm grass
box 36 3 18  42 3 23   grass         # right wall grass
box 14 4 7   30 4 8    grass         # tiny higher mound on bottom arm
box 38 4 19  41 4 22   grass         # tiny higher mound on right wall

# ============================================================================
# PALM A — center of bottom arm (the most prominent palm)
# Trunk corner at (20, 5), 4×4, height 9
# ============================================================================
box 21 1 5    22 9 8    trunk
box 20 1 6    20 9 7    trunk
box 23 1 6    23 9 7    trunk
# Canopy lower y=10
box 17 10 5   26 10 8   frond         # X arm 10 wide × 4 deep
box 20 10 3   23 10 10  frond         # Z arm
box 18 10 4   25 10 9   frond         # 8×6 inner
box 19 10 6   24 10 7   frond         # core
# Upper canopy y=11
box 19 11 5   24 11 8   frondlt
box 20 11 4   23 11 9   frondlt
# Top tuft
box 21 12 6   22 12 7   frondlt
v 21 13 6   frondlt
# Coconuts
v 18 9 6   coconut
v 18 9 7   coconut
v 25 9 7   coconut

# ============================================================================
# PALM B — left arc, mid-height
# Trunk corner at (3, 14), height 8
# ============================================================================
box 4 1 14    5 8 17   trunk
box 3 1 15    3 8 16   trunk
box 6 1 15    6 8 16   trunk
box 1 9 14    8 9 17   frond
box 3 9 12    6 9 19   frond
box 2 9 13    7 9 18   frond
box 3 10 14   6 10 17  frondlt
box 4 10 13   5 10 18  frondlt
box 4 11 15   5 11 16  frondlt
v 1 8 15   coconut
v 7 8 16   coconut

# ============================================================================
# PALM C — top arm, leans south (toward bay)
# Trunk corner at (18, 23), height 8
# ============================================================================
box 19 1 23   20 8 26   trunk
box 18 1 24   18 8 25   trunk
box 21 1 24   21 8 25   trunk
box 16 9 23   23 9 26   frond
box 18 9 21   21 9 28   frond
box 17 9 22   22 9 27   frond
box 18 10 23  21 10 26  frondlt
box 19 10 22  20 10 27  frondlt
box 19 11 24  20 11 25  frondlt
v 16 8 24  coconut
v 23 8 25  coconut

# ============================================================================
# PALM D — right wall, mid-height
# Trunk corner at (39, 19), height 8
# ============================================================================
box 40 1 19   41 8 22   trunk
box 39 1 20   39 8 21   trunk
box 42 1 20   42 8 21   trunk
box 37 9 19   44 9 22   frond
box 39 9 17   42 9 24   frond
box 38 9 18   43 9 23   frond
box 39 10 19  42 10 22  frondlt
box 40 10 18  41 10 23  frondlt
box 40 11 20  41 11 21  frondlt
v 37 8 20  coconut
v 44 8 21  coconut

# ============================================================================
# PALM E — small palm on the spiral hook (overlooks bay)
# Trunk corner at (40, 13), height 7
# ============================================================================
box 41 1 13   42 7 16   trunk
box 40 1 14   40 7 15   trunk
box 43 1 14   43 7 15   trunk
box 38 8 13   45 8 16   frond
box 40 8 11   43 8 18   frond
box 39 8 12   44 8 17   frond
box 40 9 13   43 9 16   frondlt
box 41 9 12   42 9 17   frondlt
box 41 10 14  42 10 15  frondlt

# ============================================================================
# Rocks scattered around the spiral
# ============================================================================
box 44 1 8    45 2 11   rock         # outer bottom-right
box 1 1 16    2 2 18    rock         # outer left bulge
box 30 1 27   31 2 28   rock         # outer top
box 18 1 16   19 2 17   rock         # in the bay
box 33 1 20   34 2 21   rock         # in the bay east
