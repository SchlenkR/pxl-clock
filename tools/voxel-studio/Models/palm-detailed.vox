# Palm Detailed — high-detail single palm with extras
# Curved trunk (subtle lean), 3-tier fluffy crown with droops,
# two visible coconuts, beach with two small rocks and grass tufts.

material sand    top=#FFE5B0  front=#A88B52  side=#7E6740
material wetsand top=#E8C880  front=#9C7E48  side=#6A5630
material grass   top=#5AA830  front=#345E1A  side=#21401A
material trunk   top=#7C4828  front=#4F2E14  side=#3A2210
material trunkhi top=#A56838  front=#6E3F1C  side=#4A2A14
material trunkdk top=#5A3418  front=#36200E  side=#23150A
material frondlt top=#7AE040  front=#3D8B22  side=#225E15
material frond   top=#3D8B22  front=#225E15  side=#163E0E
material fronddk top=#1F5A18  front=#0E3010  side=#091E0A
material coco    top=#523018  front=#2E1A0C  side=#1A0F06
material rock    top=#8E7E68  front=#544738  side=#372C20

# ============================================================================
# SAND BANK — 16 wide × 8 deep, organic edges, slight beach mound
# ============================================================================
box 2 0 1   13 0 6   sand
box 3 0 0   12 0 7   sand
box 1 0 2   14 0 5   sand
box 0 0 3   0 0 4    wetsand        # tip west
box 15 0 3  15 0 4   wetsand        # tip east

# Beach mound (where palm sits)
box 5 1 2   10 1 5   sand
box 6 1 1   9 1 6    sand
box 6 2 2   9 2 5    sand
box 7 3 3   8 3 4    sand           # apex

# Grass tufts (a few clumps on the mound)
v 5 2 3   grass
v 5 2 4   grass
v 10 2 3  grass
v 10 2 4  grass
v 6 3 2   grass
v 9 3 5   grass

# Tiny rocks at the waterline
box 1 0 5   2 0 6    rock
box 13 0 1  14 0 2   rock

# ============================================================================
# PALM TRUNK — 2×2 with subtle lean (offset by +1 in X at higher elevations)
# Cylinder shading on +X side
# ============================================================================
# Lower trunk straight up
box 7 4 3   8 7 4   trunk
v 8 4 4   trunkhi
v 8 5 4   trunkhi
v 8 6 4   trunkhi
v 7 4 3   trunkdk

# Upper trunk leans slightly +X (one voxel offset at top)
box 7 8 3   8 9 4   trunk
v 8 8 4   trunkhi
v 8 9 4   trunkhi

# Top trunk crown junction
box 8 10 3  9 11 4  trunk
v 9 10 4  trunkhi
v 9 11 4  trunkhi

# ============================================================================
# PALM CROWN — 3-tier fluffy with droops
# Centred above x=8.5, z=3.5 (where trunk top is)
# ============================================================================
# Lower outer ring (darkest, "underside")
box 5 12 2   12 12 5   fronddk
box 8 12 0   9 12 7    fronddk
box 6 12 1   11 12 6   fronddk

# Middle layer (medium green)
box 6 12 2   11 12 5   frond
box 7 12 1   10 12 6   frond

# Upper layer (brightest)
box 7 13 2   10 13 5   frondlt
box 8 13 1   9 13 6    frondlt
box 8 14 3   9 14 4    frondlt

# Drooping outer frond tips at lower-crown level (cardinals)
v 4 12 3  fronddk
v 4 12 4  fronddk
v 13 12 3 fronddk
v 13 12 4 fronddk

# Two visible coconut bunches at trunk top
v 7 11 4  coco
v 9 11 3  coco
