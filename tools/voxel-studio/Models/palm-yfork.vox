# Palm Island — Y FORK (78 × 30 × 14)
# A Y-shaped island: a single thick trunk on the west, splitting into
# two distinct arms that diverge eastward (one going north-east, one
# going south-east). The fork creates a triangular bay between the arms.
#
# ROUND TRUNK convention: 4×4 with corners cut → 12 voxels per layer

material sand     top=#F4E0A0  front=#A89060  side=#705D40
material sandwet  top=#E8C880  front=#9C7E48  side=#6A5630
material grass    top=#5A8E32  front=#365A1E  side=#243D14
material trunk    top=#8C5A2E  front=#5A3818  side=#3A2410
material frond    top=#3FB048  front=#1E7028  side=#104818
material frondlt  top=#62E03A  front=#3A8E20  side=#2C7018
material coconut  top=#5A4030  front=#3A271A  side=#251910
material rock     top=#8E785A  front=#5C4F3D  side=#3F362A

# ============================================================================
# FORK BASE (west) — thick rounded landmass
# ============================================================================
box 3 1 8    20 1 22   sand
box 5 1 6    22 1 24   sand
box 7 1 5    23 1 25   sand
box 10 1 4   22 1 26   sand          # widens at the western tip
box 14 1 3   20 1 27   sand          # very west tip

# Connecting region (where the trunk starts splitting)
box 18 1 10  28 1 20   sand

# ============================================================================
# NORTH-EAST ARM — extends up-right
# ============================================================================
box 25 1 19  40 1 24   sand
box 28 1 20  44 1 25   sand
box 32 1 21  48 1 26   sand
box 36 1 22  52 1 27   sand
box 42 1 23  54 1 28   sand          # NE tip
box 46 1 24  53 1 27   sand          # rounded NE tip

# ============================================================================
# SOUTH-EAST ARM — extends down-right (mirror)
# ============================================================================
box 25 1 6   40 1 11   sand
box 28 1 5   44 1 10   sand
box 32 1 4   48 1 9    sand
box 36 1 3   52 1 8    sand
box 42 1 2   54 1 7    sand          # SE tip
box 46 1 3   53 1 6    sand          # rounded SE tip

# ============================================================================
# WET SAND fringes
# ============================================================================
# Bay shorelines (interior of the Y)
box 25 1 11  48 1 11   sandwet       # SE arm bay-side
box 25 1 19  48 1 19   sandwet       # NE arm bay-side
box 25 1 12  25 1 18   sandwet       # base bay-side

# Outer shorelines
box 14 1 27  20 1 27   sandwet
box 14 1 3   20 1 3    sandwet
box 46 1 27  53 1 27   sandwet
box 46 1 3   53 1 3    sandwet

# ============================================================================
# RAISED SAND y=2 — interior plateaus
# ============================================================================
# Base
box 7 2 7    20 2 23   sand
box 9 2 6    22 2 24   sand
box 12 2 5   20 2 25   sand
# NE arm raised
box 28 2 20  46 2 25   sand
box 33 2 21  50 2 26   sand
# SE arm raised
box 28 2 6   46 2 10   sand
box 33 2 5   50 2 9    sand

# ============================================================================
# GRASS along the high spines
# ============================================================================
box 9 3 8    20 3 22   grass         # base grass plateau
box 11 4 11  18 4 19   grass         # higher mound on base
box 12 5 14  17 5 16   grass         # tiny knoll
# NE arm grass
box 30 3 21  46 3 24   grass
box 35 4 22  44 4 23   grass
# SE arm grass
box 30 3 7   46 3 10   grass
box 35 4 7   44 4 8    grass

# ============================================================================
# PALM A — central tall palm on the base mound (the "main" palm)
# Trunk corner at (13, 13), 4×4, height 10 (tallest)
# ============================================================================
box 14 1 13   15 10 16  trunk
box 13 1 14   13 10 15  trunk
box 16 1 14   16 10 15  trunk
# Big canopy lower y=11 (10×10 octagon)
box 10 11 13  19 11 16  frond
box 13 11 10  16 11 19  frond
box 11 11 12  18 11 17  frond
box 12 11 11  17 11 18  frond
# Upper canopy y=12
box 12 12 13  17 12 16  frondlt
box 13 12 12  16 12 17  frondlt
box 14 12 11  15 12 18  frondlt
# Top tuft y=13
box 14 13 14  15 13 15  frondlt
# Coconuts
v 11 10 14  coconut
v 11 10 15  coconut
v 18 10 14  coconut
v 18 10 15  coconut

# ============================================================================
# PALM B — mid NE arm
# Trunk corner at (38, 22), 4×4, height 8
# ============================================================================
box 39 1 22   40 8 25   trunk
box 38 1 23   38 8 24   trunk
box 41 1 23   41 8 24   trunk
box 35 9 22   44 9 25   frond
box 38 9 20   41 9 27   frond
box 36 9 21   43 9 26   frond
box 37 10 22  42 10 25  frondlt
box 38 10 21  41 10 26  frondlt
box 39 11 23  40 11 24  frondlt
v 35 8 23  coconut
v 44 8 24  coconut

# ============================================================================
# PALM C — mid SE arm (mirror)
# Trunk corner at (38, 5), 4×4, height 8
# ============================================================================
box 39 1 5    40 8 8    trunk
box 38 1 6    38 8 7    trunk
box 41 1 6    41 8 7    trunk
box 35 9 5    44 9 8    frond
box 38 9 3    41 9 10   frond
box 36 9 4    43 9 9    frond
box 37 10 5   42 10 8   frondlt
box 38 10 4   41 10 9   frondlt
box 39 11 6   40 11 7   frondlt
v 35 8 6   coconut
v 44 8 7   coconut

# ============================================================================
# PALM D — NE arm tip
# Trunk corner at (48, 24), height 7
# ============================================================================
box 49 1 24   50 7 27   trunk
box 48 1 25   48 7 26   trunk
box 51 1 25   51 7 26   trunk
box 46 8 24   53 8 27   frond
box 48 8 22   51 8 29   frond
box 47 8 23   52 8 28   frond
box 48 9 24   51 9 27   frondlt
box 49 9 23   50 9 28   frondlt
box 49 10 25  50 10 26  frondlt

# ============================================================================
# PALM E — SE arm tip (mirror)
# Trunk corner at (48, 3), height 7
# ============================================================================
box 49 1 3    50 7 6    trunk
box 48 1 4    48 7 5    trunk
box 51 1 4    51 7 5    trunk
box 46 8 3    53 8 6    frond
box 48 8 1    51 8 8    frond
box 47 8 2    52 8 7    frond
box 48 9 3    51 9 6    frondlt
box 49 9 2    50 9 7    frondlt
box 49 10 4   50 10 5   frondlt

# ============================================================================
# PALM F — small palm on west tip of base
# Trunk corner at (5, 14), height 7
# ============================================================================
box 6 1 14    7 7 17    trunk
box 5 1 15    5 7 16    trunk
box 8 1 15    8 7 16    trunk
box 3 8 14    10 8 17   frond
box 5 8 12    8 8 19    frond
box 4 8 13    9 8 18    frond
box 5 9 14    8 9 17    frondlt
box 6 9 13    7 9 18    frondlt
box 6 10 15   7 10 16   frondlt
v 3 7 15   coconut
v 10 7 16  coconut

# ============================================================================
# Rocks at the bay mouth (between the two arm tips on the east)
# ============================================================================
box 50 1 14   51 2 16   rock
box 50 1 13   51 2 13   rock
# Rocks at outer shores
box 14 1 1    16 2 2    rock
box 14 1 28   16 2 29   rock
