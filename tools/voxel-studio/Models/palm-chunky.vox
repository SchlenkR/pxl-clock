# Palm Chunky — low-detail blocky Minecraft-style island
# Sand bank is a flat blocky plate, palm has a stout 3×3 trunk and a
# square hat-like crown. Reads VERY clean at low LED resolutions.

material sand    top=#F0DA90  front=#A88B52  side=#7E6740
material trunk   top=#7C4828  front=#4F2E14  side=#3A2210
material trunkhi top=#A56838  front=#6E3F1C  side=#4A2A14
material frond   top=#3D8B22  front=#225E15  side=#163E0E
material frondlt top=#7AE040  front=#3D8B22  side=#225E15
material rock    top=#7E7060  front=#503F2E  side=#352918

# Sand: solid 14×6 plate, two voxels tall
box 1 0 1   12 0 4   sand
box 2 0 0   11 0 5   sand
box 1 1 1   12 1 4   sand
box 3 1 0   10 1 5   sand
# Tiny rocks on the beach (visual interest)
box 2 0 0   3 0 0    rock
box 11 0 5  12 0 5   rock

# Stout 3×3 trunk centred at x=6..8, z=2..4, 6 tall
box 6 2 2   8 7 4   trunk
# Single highlight column on the lit side
box 8 2 2   8 7 2   trunkhi

# Square crown — 7×7×2 hat with a 3×3 cap
box 3 8 0   9 8 6    frond
box 3 8 1   9 8 5    frondlt
box 5 9 1   7 9 5    frondlt
box 4 9 0   8 9 6    frond
# Tuft on top
box 5 10 2  7 10 4   frondlt
