# Tiny Palm Isle — pixel-art palm island for the 24×24 LED display
# Symmetric oval sand bank with one centred palm, fluffy 2-tone crown.
# Render at scale ≈1.5 (ZoomSlider≈48) for the look in the reference images.

material sand    top=#FFE5B0  front=#A88B52  side=#7E6740
material wetsand top=#E8C880  front=#9C7E48  side=#6A5630
material trunk   top=#854E2C  front=#4F2E14  side=#3A2210
material trunkdk top=#5A3418  front=#36200E  side=#23150A
material frondlt top=#7AE040  front=#3D8B22  side=#225E15
material frond   top=#3D8B22  front=#225E15  side=#163E0E
material coco    top=#6B3818  front=#3D2210  side=#251608

# ============================================================================
# SAND BANK — wavy oval, 14 wide × 6 deep, gentle 2-step profile
# Centered around x=7, z=2.5
# ============================================================================
# Outer rim (1 voxel tall)
box 2 0 1   12 0 4   sand          # main rectangle
box 3 0 0   11 0 5   sand          # extends top/bottom
box 1 0 2   13 0 3   sand          # extends east/west
box 0 0 2   0 0 3    wetsand       # west tip wet
box 14 0 2  14 0 3   wetsand       # east tip wet

# Centre raise (1 voxel tall mound, where the palm sits)
box 5 1 1   10 1 4   sand
box 6 1 0   9 1 5    sand
box 6 2 1   9 2 4    sand          # apex tier
v 7 3 2   sand                       # tiny knoll under root flare
v 7 3 3   sand
v 8 3 2   sand
v 8 3 3   sand

# ============================================================================
# PALM TRUNK — 2×2, 7 voxels tall, on top of the apex (centred at x=7..8, z=2..3)
# ============================================================================
box 7 4 2   8 10 3   trunk
# Cylinder shading on the +X side
v 8 5 3   trunkdk
v 8 7 3   trunkdk
v 8 9 3   trunkdk

# ============================================================================
# PALM CROWN — big fluffy 2-tone crown
# ============================================================================
# Lower outer ring (darker green, "underside" of fronds)
box 4 11 2   11 11 3   frond       # X-arm 8 wide
box 7 11 0   8 11 5    frond       # Z-arm 6 deep
box 5 11 1   10 11 4   frond       # 6×4 inner band
box 6 11 1   9 11 4    frondlt     # bright inner core (2-tone)

# Upper layer (lighter green, smaller, sits on top)
box 5 12 1   10 12 4   frondlt
box 6 12 0   9 12 5    frondlt
box 7 12 2   8 12 3    frondlt

# Top tuft
box 7 13 2   8 13 3    frondlt

# Drooping outer frond tips at lower-crown level (4 cardinal directions)
v 3 11 2   frond
v 3 11 3   frond
v 12 11 2  frond
v 12 11 3  frond
v 7 11 6   frond
v 8 11 6   frond
# (no negative-z tips since the bank is only 6 deep)

# Two coconuts hidden in the crown
v 5 11 2  coco
v 10 11 3 coco
