# Palm Island — DROPLET / TADPOLE (70 × 26 × 14)
# A teardrop / droplet-shaped island: a fat round bulb on the right side
# tapering smoothly into a long pointed tail to the west. Asymmetric:
# the bulb is offset slightly south, the tail curves slightly upward.
#
# ROUND TRUNK convention: 4×4 with corners cut (12 voxels per layer)

material sand     top=#F4E0A0  front=#A89060  side=#705D40
material sandwet  top=#E8C880  front=#9C7E48  side=#6A5630
material grass    top=#5A8E32  front=#365A1E  side=#243D14
material grassdk  top=#4A7820  front=#2C4A14  side=#1E330D
material trunk    top=#8C5A2E  front=#5A3818  side=#3A2410
material frond    top=#3FB048  front=#1E7028  side=#104818
material frondlt  top=#62E03A  front=#3A8E20  side=#2C7018
material coconut  top=#5A4030  front=#3A271A  side=#251910
material rock     top=#8E785A  front=#5C4F3D  side=#3F362A

# ============================================================================
# DROPLET FOOTPRINT y=1 — bulb right, long tail tapering west
# ============================================================================

# --- BULB (east side, fat round shape) ---
box 38 1 6    58 1 20   sand          # main bulb body
box 36 1 8    60 1 18   sand          # widens vertically
box 34 1 10   60 1 16   sand          # widest in middle
box 40 1 5    56 1 21   sand          # rounded top/bottom
box 42 1 4    54 1 22   sand          # very top/bottom
box 56 1 8    62 1 18   sand          # eastern bulge
box 58 1 10   63 1 16   sand          # rounded east tip

# --- NECK (where bulb tapers into tail) ---
box 30 1 10   38 1 16   sand
box 32 1 9    36 1 17   sand

# --- TAIL (curves slightly upward to the west) ---
box 22 1 11   30 1 15   sand          # tail mid-section
box 18 1 12   24 1 16   sand          # tail begins to curve north
box 14 1 13   20 1 17   sand          # tail curves more
box 10 1 14   16 1 18   sand          # tail thinning
box 8 1 15    13 1 18   sand
box 6 1 15    10 1 17   sand          # tail tip
box 4 1 16    8 1 17    sand          # very tip

# ============================================================================
# WET SAND fringes around the whole droplet
# ============================================================================
box 4 1 17    7 1 17    sandwet       # tail tip
box 8 1 18    13 1 18   sandwet
box 14 1 18   24 1 18   sandwet
box 22 1 11   38 1 11   sandwet       # tail south edge
box 38 1 5    56 1 5    sandwet       # bulb south edge
box 38 1 21   56 1 21   sandwet       # bulb north edge
box 62 1 9    62 1 17   sandwet       # bulb east edge

# ============================================================================
# RAISED SAND y=2 — interior plateau of the droplet
# ============================================================================
box 38 2 8    58 2 18   sand          # bulb plateau
box 40 2 7    56 2 19   sand          # widens
box 42 2 6    54 2 20   sand
box 32 2 11   38 2 15   sand          # neck plateau
box 22 2 12   30 2 14   sand          # tail plateau
box 16 2 13   22 2 16   sand
box 12 2 14   16 2 17   sand          # tail thin plateau

# y=3 second raise on bulb (forms a hill)
box 40 3 9    56 3 17   sand
box 42 3 8    54 3 18   sand
box 44 3 7    52 3 19   sand

# ============================================================================
# GRASS plateau on the bulb hill, plus thin grass strip along the tail
# ============================================================================
box 42 4 9    54 4 17   grass         # main grass plateau on bulb
box 44 4 8    52 4 18   grass         # extends
box 44 5 11   52 5 15   grassdk       # dark grass in the middle (denser)
box 46 6 12   50 6 14   grass         # tiny higher knoll
v 48 7 13   grass

# Grass strip on the tail
box 22 3 12   30 3 14   grass
box 26 4 12   28 4 14   grass

# ============================================================================
# PALM A — tall central palm on the bulb's grass hill (the hero palm)
# Trunk corner at (47, 12), 4×4, height 10
# ============================================================================
box 48 1 12   49 10 15  trunk
box 47 1 13   47 10 14  trunk
box 50 1 13   50 10 14  trunk
# Big lush canopy y=11 (wider than usual)
box 44 11 12  53 11 15  frond         # 10×4 X arm
box 47 11 9   50 11 18  frond         # 4×10 Z arm
box 45 11 11  52 11 16  frond         # 8×6 inner
box 46 11 10  51 11 17  frond         # 6×8 inner
# Upper canopy y=12
box 46 12 12  51 12 15  frondlt
box 47 12 11  50 12 16  frondlt
box 48 12 10  49 12 17  frondlt
# Top tuft y=13
box 48 13 13  49 13 14  frondlt
# Coconut cluster
v 45 10 13  coconut
v 45 10 14  coconut
v 52 10 13  coconut
v 52 10 14  coconut

# ============================================================================
# PALM B — east side of bulb (faces the open sea)
# Trunk corner at (54, 11), height 8
# ============================================================================
box 55 1 11   56 8 14   trunk
box 54 1 12   54 8 13   trunk
box 57 1 12   57 8 13   trunk
box 51 9 11   60 9 14   frond
box 54 9 8    57 9 17   frond
box 52 9 10   59 9 15   frond
box 53 9 9    58 9 16   frond
box 54 10 11  57 10 14  frondlt
box 55 10 10  56 10 15  frondlt
box 55 11 12  56 11 13  frondlt
v 51 8 12  coconut
v 60 8 13  coconut

# ============================================================================
# PALM C — south side of bulb
# Trunk corner at (43, 6), height 7
# ============================================================================
box 44 1 6    45 7 9    trunk
box 43 1 7    43 7 8    trunk
box 46 1 7    46 7 8    trunk
box 41 8 6    48 8 9    frond
box 44 8 4    45 8 11   frond
box 42 8 5    47 8 10   frond
box 43 9 6    46 9 9    frondlt
box 44 9 5    45 9 10   frondlt
box 44 10 7   45 10 8   frondlt
v 41 7 7   coconut
v 48 7 8   coconut

# ============================================================================
# PALM D — north side of bulb
# Trunk corner at (43, 17), height 7
# ============================================================================
box 44 1 17   45 7 20   trunk
box 43 1 18   43 7 19   trunk
box 46 1 18   46 7 19   trunk
box 41 8 17   48 8 20   frond
box 44 8 15   45 8 22   frond
box 42 8 16   47 8 21   frond
box 43 9 17   46 9 20   frondlt
box 44 9 16   45 9 21   frondlt
box 44 10 18  45 10 19  frondlt
v 41 7 18  coconut
v 48 7 19  coconut

# ============================================================================
# PALM E — on the tail
# Trunk corner at (24, 12), height 7
# ============================================================================
box 25 1 12   26 7 15   trunk
box 24 1 13   24 7 14   trunk
box 27 1 13   27 7 14   trunk
box 22 8 12   29 8 15   frond
box 25 8 10   26 8 17   frond
box 23 8 11   28 8 16   frond
box 24 9 12   27 9 15   frondlt
box 25 9 11   26 9 16   frondlt
box 25 10 13  26 10 14  frondlt
v 22 7 13  coconut
v 29 7 14  coconut

# ============================================================================
# PALM F — small palm on the tail tip (lonely outpost)
# Trunk corner at (10, 14), height 6
# ============================================================================
box 11 1 14   12 6 17   trunk
box 10 1 15   10 6 16   trunk
box 13 1 15   13 6 16   trunk
box 8 7 14    15 7 17   frond
box 11 7 12   12 7 19   frond
box 9 7 13    14 7 18   frond
box 11 8 14   12 8 17   frondlt
box 10 8 15   13 8 16   frondlt
box 11 9 15   12 9 16   frondlt

# ============================================================================
# Rocks at shorelines
# ============================================================================
box 4 1 15    6 2 16    rock          # tail tip rocks
box 62 1 12   63 2 15   rock          # bulb east rocks
box 50 1 4    52 2 5    rock          # south shore
box 50 1 21   52 2 22   rock          # north shore
