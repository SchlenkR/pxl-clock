# Palm Island 15 — Organic Cove (HIGH-RES, ~2× detail)
# Footprint 16 wide × 16 deep × 14 tall
#
# Refinements vs. low-res:
#   * Sand layer is 2 voxels tall (slight beach mound)
#   * Grass plateau is 2 voxels tall
#   * Trunk is 2×2 cross-section (4 voxels per height step) → cylinder shading
#   * Bigger palm crown with drooping fronds and 2 coconuts
#   * Root flare at base of trunk
#   * Cove on left (z≈8..9, x=0..2 are water)
#   * Sand spit on right with water gap (z≈11..12, x=8 is water)

material sand    top=#FFE5B0  front=#A88B52  side=#7E6740
material grass   top=#7AE040  front=#3D8B22  side=#225E15
material trunk   top=#854E2C  front=#4F2E14  side=#3A2210
material frond   top=#62E03A  front=#3A8E20  side=#2C7018
material coco    top=#6B3818  front=#3D2210  side=#251608

# ---- Sand layer (y=0..1, 2 voxels tall, organic oval footprint) ----------
# z=0..1 — narrow back
box 8 0 0   10 1 1   sand
# z=2..3 — widening
box 6 0 2   12 1 3   sand
# z=4..5 — wider
box 4 0 4   13 1 5   sand
# z=6..7 — widest
box 2 0 6   15 1 7   sand
# z=8..9 — COVE on the left (x=0..2 is water carved into the silhouette)
box 3 0 8   15 1 9   sand
# z=10 — narrowing
box 1 0 10  14 1 10  sand
# z=11..12 — main island shrinking + SPIT extends right (water gap at x=8..9)
box 1 0 11  7 1 11   sand
box 10 0 11 14 1 11  sand
box 2 0 12  7 1 12   sand
box 10 0 12 13 1 12  sand
# z=13..14 — front mound
box 4 0 13  10 1 14  sand
# z=15 — narrow front tip
box 7 0 15  9 1 15   sand

# ---- Grass plateau (y=2..3, smaller, asymmetric — slightly right of cove)
box 6 2 4   9 3 5    grass
box 4 2 6   11 3 7   grass
box 3 2 8   12 3 9   grass
box 4 2 10  10 3 10  grass
box 5 2 11  9 3 11   grass

# ---- Goldrim accent at the grass-sand seam (warm transition pixels) ------
v 4 2 6   grass
v 11 2 6  grass
v 4 2 9   grass
v 12 2 9  grass

# ---- Trunk: 2×2 cross-section, 8 voxels tall (y=4..11) -------------------
box 7 4 7   8 11 8   trunk
# Root flare at base (one extra voxel on each side at y=4)
v 6 4 7   trunk
v 9 4 8   trunk
v 7 4 6   trunk
v 8 4 9   trunk

# ---- Palm crown: layered fronds (y=11..13), top tuft + coconuts ----------
# Inner ring just above trunk
box 6 11 6   9 11 9   frond
# Wide middle layer (the main crown) at y=12
box 4 12 4   11 12 11  frond
# Narrow top layer at y=13
box 6 13 6   9 13 9   frond
# Top tuft
v 7 14 7   frond
v 8 14 8   frond
v 7 14 8   frond
v 8 14 7   frond

# Drooping outer frond tips at y=11 (4 cardinal directions)
v 3 11 7   frond
v 3 11 8   frond
v 12 11 7  frond
v 12 11 8  frond
v 7 11 3   frond
v 8 11 3   frond
v 7 11 12  frond
v 8 11 12  frond

# Two coconuts hidden in the crown
v 5 12 5   coco
v 10 12 10 coco
