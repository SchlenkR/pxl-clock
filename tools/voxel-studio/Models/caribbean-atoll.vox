# Caribbean Atoll — LONG along X (44 wide × 16 deep × 10 high)
# A C-shaped sand ring (open on the upper-right). A small volcanic stump
# rises in the middle where the lagoon would be. Palms scattered on the
# sand. Background renders the surrounding ocean.

material sand     top=#F4E0A0  front=#A89060  side=#705D40
material wetsand  top=#E8C880  front=#9C7E48  side=#6A5630
material grass    top=#5A8E32  front=#365A1E  side=#243D14
material rock     top=#5A4F3A  front=#382F22  side=#231D14
material lava     top=#E84818  front=#9F2E10  side=#6A1F0A
material trunk    top=#9C5C32  front=#603418  side=#42230F
material frond    top=#62E03A  front=#3A8E20  side=#2C7018

# ============================================================================
# SAND RING — C-shape, open on the upper-right
# ============================================================================
# Lower sand crescent (longest part, runs along the bottom)
box 6 1 6    7 1 9    sand
box 8 1 4   11 1 12   sand
box 10 2 5  10 2 11   sand    # raised dune on left arm
box 12 1 3  20 1 2    sand    # bottom strip
box 12 2 3  19 2 2    sand
box 21 1 3  29 1 2    sand    # bottom strip continues
box 22 2 3  28 2 2    sand
box 12 1 13 20 1 14   sand    # top strip
box 21 1 13 28 1 14   sand
box 30 1 4  33 1 11   sand
box 31 2 5  32 2 10   sand

# Wet-sand fringe at the lagoon edge
v 8 1 5   wetsand
v 8 1 6   wetsand
v 8 1 9   wetsand
v 8 1 10  wetsand
v 11 1 4  wetsand
v 11 1 11 wetsand
v 30 1 5  wetsand
v 30 1 10 wetsand

# Tiny opening sand spit (where the ring almost closes on the right)
v 35 1 6  sand
v 35 1 7  sand
v 35 1 8  sand
v 35 1 9  sand
v 36 1 7  sand
v 36 1 8  sand

# ============================================================================
# VOLCANIC STUMP — rises in the middle of the lagoon (a small islet)
# ============================================================================
box 20 1 7   23 1 8   sand     # tiny sand base
box 20 2 7   23 2 8   rock
box 21 3 7   22 3 8   rock
box 21 4 7   22 4 8   rock
v 21 5 7   rock
v 22 5 7   rock
v 21 5 8   rock
v 22 5 8   rock
v 21 6 7   rock
v 22 6 8   rock
# Crater glow at the top
v 22 6 7   lava
v 21 6 8   lava
# A faint smoke wisp (using rock-darker as smoke approximation)
v 22 7 7   rock
v 22 8 7   rock

# ============================================================================
# PALM TREES around the sand ring
# ============================================================================
# Palm 1 (left arm)
box 10 3 6   10 5 6   trunk
box 9 6 5   11 6 7   frond
v 10 6 4   frond
v 10 6 8   frond
v 10 7 6   frond

# Palm 2 (bottom-left)
box 14 3 2   14 4 2   trunk
box 13 5 2  15 5 2   frond
v 14 5 1   frond
v 14 5 3   frond

# Palm 3 (bottom-middle)
box 22 3 2   22 5 2   trunk
box 21 6 2   23 6 2   frond
v 22 6 1   frond
v 22 6 3   frond
v 22 7 2   frond

# Palm 4 (bottom-right)
box 27 3 2   27 4 2   trunk
box 26 5 2   28 5 2   frond
v 27 5 1   frond
v 27 5 3   frond

# Palm 5 (top, at edge)
box 18 3 14  18 5 14  trunk
box 17 6 14  19 6 14  frond
v 18 6 13  frond
v 18 7 14  frond

# Palm 6 (right arm)
box 32 3 7   32 4 7   trunk
box 31 5 7  33 5 7   frond
v 32 5 6   frond
v 32 5 8   frond

# Patches of grass on the higher sand dunes
v 10 3 5   grass
v 10 3 11  grass
v 31 3 6   grass
v 32 3 9   grass
v 22 3 3   grass
v 26 3 13  grass
