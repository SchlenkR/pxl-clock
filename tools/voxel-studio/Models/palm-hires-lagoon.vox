# Palm Hi-Res Lagoon — crescent island with proper plate-frond palms
# 50 × 40 × 30
# Big palm (6×6 round trunk) + small palm (5×5 trunk).
# Crowns: cardinal drooping plates + diagonal upright fronds.

material sand    top=#FFE5B0  front=#A88B52  side=#7E6740
material wetsand top=#E8C880  front=#9C7E48  side=#6A5630
material grass   top=#5AA830  front=#345E1A  side=#21401A
material trunk   top=#9C5E32  front=#6E3F1C  side=#3A2210
material frond   top=#7AE040  front=#3D8B22  side=#1F5A18
material coco    top=#5A3418  front=#36200E  side=#23150A
material rock    top=#7E7060  front=#4F4438  side=#332A22
material flame   top=#F2A018  front=#A8580A  side=#722F08
material tiki    top=#A26230  front=#5A3418  side=#3A2210

# ============================================================================
# CRESCENT ISLAND — wraps around lagoon (open south)
# ============================================================================
box 4 0 12   16 0 35   sand
box 6 0 10   18 0 37   sand
box 9 0 8    20 0 38   sand
box 36 0 12  47 0 35   sand
box 34 0 10  45 0 37   sand
box 32 0 8   43 0 38   sand
box 16 0 30  36 0 38   sand
box 18 0 32  34 0 39   sand
box 6 1 13   16 1 34   sand
box 36 1 13  45 1 34   sand
box 18 1 31  34 1 37   sand
box 8 2 15   14 2 32   sand
box 38 2 15  43 2 32   sand
box 20 2 32  32 2 36   sand

v 16 0 12   wetsand
v 16 0 35   wetsand
v 36 0 12   wetsand
v 36 0 35   wetsand
v 25 0 8    wetsand
v 25 0 39   wetsand

box 9 3 18   12 3 28   grass
box 39 3 18  42 3 28   grass
box 22 3 33  31 3 35   grass

# ============================================================================
# BIG PALM — 6×6 round trunk on west arm
# Trunk corner (8, 20), x=8..13, z=20..25, height 14 (y=3..16)
